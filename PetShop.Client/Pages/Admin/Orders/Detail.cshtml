@page "{id:int}"
@model PetShop.Client.Pages.Admin.Orders.DetailModel
@{ ViewData["Title"] = $"Đơn hàng #{Model.Order?.Id}"; }

<div class="ps-backoffice-heading">
    <div>
        <span class="ps-kicker">Chi tiết giao dịch</span>
        <h1>Chi tiết Đơn hàng #@Model.Order?.Id</h1>
        <p>Kiểm tra thông tin thanh toán, địa chỉ nhận hàng và tiến độ thực hiện của nhân viên.</p>
    </div>
    <div>
        <a href="/Admin/Orders" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Danh sách đơn hàng
        </a>
    </div>
</div>

@if (Model.Order == null)
{
    <div class="ps-empty card">
        <div class="ps-empty__icon"><i class="bi bi-search"></i></div>
        <h5 class="fw-bold mb-1">Không tìm thấy đơn hàng</h5>
        <p class="text-muted small mb-3">Mã đơn hàng không tồn tại trong hệ thống.</p>
        <a href="/Admin/Orders" class="btn btn-primary btn-sm px-4">Quay lại danh sách</a>
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4 shadow-sm">
            <i class="bi bi-check-circle-fill text-success fs-5"></i>
            <div>@Model.Message</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }
    var statusLabel = Model.Order.Status switch {
        "Pending" when Model.Order.IsCod => "Chờ duyệt COD",
        "Pending" => "Chờ thanh toán PayOS",
        "Confirmed" when Model.Order.IsCod => "Đã duyệt COD",
        "Confirmed" => "Đã thanh toán PayOS",
        "Shipping" => "Đang giao hàng",
        "AwaitingReceipt" => "Chờ khách xác nhận",
        "Delivered" => "Đã hoàn tất",
        "Cancelled" => "Đã hủy",
        _ => Model.Order.Status
    };
    var statusBadge = Model.Order.Status switch {
        "Pending"   => "bg-warning-subtle text-warning-emphasis",
        "Confirmed" => "bg-info-subtle text-info-emphasis",
        "Shipping"  => "bg-primary-subtle text-primary",
        "AwaitingReceipt" => "bg-warning-subtle text-warning-emphasis",
        "Delivered" => "bg-success-subtle text-success",
        _           => "bg-secondary-subtle text-secondary"
    };
    var paymentLabel = Model.Order.PaymentStatus switch {
        "Paid" => "PayOS đã thanh toán",
        "PayOSPending" => "PayOS đang chờ thanh toán",
        "CODCollected" => "Đã thu tiền COD",
        "Cancelled" => "Đã hủy giao dịch",
        _ => "Thu tiền mặt COD khi giao"
    };
    var paymentBadge = Model.Order.PaymentStatus switch {
        "Paid" => "bg-success-subtle text-success",
        "PayOSPending" => "bg-warning-subtle text-warning-emphasis",
        "CODCollected" => "bg-success-subtle text-success",
        "Cancelled" => "bg-secondary-subtle text-secondary",
        _ => "bg-light text-muted border"
    };
    var paymentHint = Model.Order.PaymentStatus switch {
        "Paid" => "PayOS webhook đã xác nhận thanh toán. Có thể tạo vận đơn.",
        "PayOSPending" => "Không xác nhận thủ công. Chờ PayOS webhook hoặc hủy đơn nếu cần.",
        "CODCollected" => "COD đã hoàn tất sau khi giao hàng.",
        "Cancelled" => "Đơn đã hủy.",
        _ => "Shop xác nhận đơn, sau đó shipper thu tiền khi giao."
    };
    var waitingPayOs = !Model.Order.IsCod && Model.Order.Status == "Pending";

    <div class="row g-4 mb-5">
        <!-- Thông tin đơn -->
        <div class="col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-info-circle text-primary me-2"></i>Thông tin đơn hàng</h6>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                        <span class="text-muted small">Mã đơn hàng:</span>
                        <span class="fw-bold fs-6">#@Model.Order.Id</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                        <span class="text-muted small">Khách hàng:</span>
                        <span class="fw-semibold text-dark">User #@Model.Order.UserId</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                        <span class="text-muted small">Trạng thái hiện tại:</span>
                        <span class="badge @statusBadge px-3 py-1.5 fw-semibold">@statusLabel</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                        <span class="text-muted small">Phương thức & Trạng thái TT:</span>
                        <span class="badge @paymentBadge px-3 py-1.5 fw-semibold">@paymentLabel</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                        <span class="text-muted small">Tổng giá trị đơn:</span>
                        <span class="fw-bold text-success fs-5">@Model.Order.TotalAmount.ToString("N0")đ</span>
                    </div>

                    <div class="mb-3 pb-3 border-bottom">
                        <span class="text-muted small d-block mb-1">Địa chỉ nhận hàng:</span>
                        <div class="fw-semibold text-dark"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@Model.Order.ShippingAddress</div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Order.Note))
                    {
                        <div class="mb-3 pb-3 border-bottom">
                            <span class="text-muted small d-block mb-1">Ghi chú của khách:</span>
                            <div class="small text-muted bg-light p-2 rounded">@Model.Order.Note</div>
                        </div>
                    }

                    <div class="d-flex justify-content-between small text-muted">
                        <span>Thời gian tạo:</span>
                        <span>@Model.Order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Theo dõi xử lý & Sản phẩm -->
        <div class="col-lg-7">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-shield-check text-primary me-2"></i>Quy trình vận hành</h6>
                </div>
                <div class="card-body p-3">
                    @if (waitingPayOs)
                    {
                        <div class="alert alert-warning py-2 px-3 small mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-hourglass-split fs-5"></i>
                            <div>Đơn PayOS này đang chờ thanh toán trực tuyến. Hệ thống sẽ tự động cập nhật khi nhận Webhook từ PayOS.</div>
                        </div>
                    }
                    else if (Model.Order.Status == "Confirmed" && string.IsNullOrEmpty(Model.Order.TrackingCode))
                    {
                        <div class="alert alert-info py-2 px-3 small mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-info-circle-fill fs-5"></i>
                            <div>Đơn đã được xác nhận. Bộ phận Staff sẽ thực hiện đóng gói và tạo mã vận đơn giao nhận.</div>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-0"><i class="bi bi-check-circle me-1"></i>Admin có quyền giám sát toàn bộ đơn hàng. Các thao tác xử lý giao vận thực tế do Nhân viên (Staff) đảm nhiệm.</p>
                    }
                </div>
            </div>

            <!-- Danh sách sản phẩm -->
            <div class="card shadow-sm">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-bag-check text-primary me-2"></i>Chi tiết mặt hàng trong đơn</h6>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Mặt hàng</th>
                                <th class="text-center" style="width:80px">SL</th>
                                <th class="text-end" style="width:130px">Đơn giá</th>
                                <th class="text-end pe-3" style="width:140px">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model.Order.Items ?? Enumerable.Empty<PetShop.Shared.DTOs.Response.OrderItemResponse>())
                        {
                            var itemName = item.ProductName ?? item.PetName;
                            var itemType = item.ProductId.HasValue ? "Sản phẩm" : "Thú cưng";
                            var itemCode = item.ProductId ?? item.PetId;
                            var emoji = item.ProductId.HasValue ? "🛍️" : "🐾";
                            <tr>
                                <td class="ps-3 py-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fs-4">@emoji</span>
                                        <div>
                                            <div class="fw-bold text-dark">@(string.IsNullOrWhiteSpace(itemName) ? $"{itemType} #{itemCode}" : itemName)</div>
                                            <div class="small text-muted">@itemType #@itemCode</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center py-3">
                                    <span class="badge bg-light text-dark border">@item.Quantity</span>
                                </td>
                                <td class="text-end py-3 text-muted">@item.UnitPrice.ToString("N0")đ</td>
                                <td class="text-end pe-3 py-3 fw-bold text-primary">@((item.Quantity * item.UnitPrice).ToString("N0"))đ</td>
                            </tr>
                        }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="3" class="text-end fw-bold py-3">Tổng cộng thanh toán:</td>
                                <td class="text-end pe-3 fw-bold text-success fs-5 py-3">@Model.Order.TotalAmount.ToString("N0")đ</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
}
