@page "{id:int}"
@model PetShop.Client.Pages.Admin.Orders.DetailModel
@{ ViewData["Title"] = $"Đơn hàng #{Model.Order?.Id}"; }

<div class="d-flex align-items-center mb-4 gap-3">
    <a href="/Admin/Orders" class="btn btn-outline-secondary btn-sm">← Quay lại</a>
    <h5 class="mb-0 fw-semibold">📦 Chi tiết Đơn hàng #@Model.Order?.Id</h5>
</div>

@if (Model.Order == null)
{
    <div class="alert alert-danger">Không tìm thấy đơn hàng.</div>
}
else
{
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-success alert-dismissible fade show">
            @Model.Message
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    var statusLabel = Model.Order.Status switch {
        "Pending" when Model.Order.IsCod => "Chờ shop xác nhận",
        "Pending" => "Chờ thanh toán PayOS",
        "Confirmed" when Model.Order.IsCod => "Đã xác nhận COD",
        "Confirmed" => "Đã thanh toán PayOS",
        "Shipping" => "Đang giao",
        "AwaitingReceipt" => "Chờ khách xác nhận",
        "Delivered" => "Hoàn tất",
        "Cancelled" => "Đã hủy",
        _ => Model.Order.Status
    };
    var paymentLabel = Model.Order.PaymentStatus switch {
        "Paid" => "PayOS đã thanh toán",
        "PayOSPending" => "PayOS chờ thanh toán",
        "CODCollected" => "COD đã thu",
        "Cancelled" => "Đã hủy",
        _ => "COD thu khi giao"
    };
    var paymentBadge = Model.Order.PaymentStatus switch {
        "Paid" => "bg-success",
        "PayOSPending" => "bg-warning text-dark",
        "CODCollected" => "bg-success",
        "Cancelled" => "bg-secondary",
        _ => "bg-light text-dark border"
    };
    var paymentHint = Model.Order.PaymentStatus switch {
        "Paid" => "PayOS webhook đã xác nhận thanh toán. Có thể tạo vận đơn.",
        "PayOSPending" => "Không xác nhận thủ công. Chờ PayOS webhook hoặc hủy đơn nếu cần.",
        "CODCollected" => "COD đã hoàn tất sau khi giao hàng.",
        "Cancelled" => "Đơn đã hủy.",
        _ => "Shop xác nhận đơn, sau đó shipper thu tiền khi giao."
    };
    var waitingPayOs = !Model.Order.IsCod && Model.Order.Status == "Pending";

    <div class="row g-4">
        <!-- Thông tin đơn -->
        <div class="col-md-5">
            <div class="card h-100">
                <div class="card-header fw-semibold">📋 Thông tin đơn hàng</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-5 text-muted">Mã đơn</dt>
                        <dd class="col-7">#@Model.Order.Id</dd>
                        <dt class="col-5 text-muted">Khách hàng</dt>
                        <dd class="col-7">User #@Model.Order.UserId</dd>
                        <dt class="col-5 text-muted">Địa chỉ</dt>
                        <dd class="col-7">@Model.Order.ShippingAddress</dd>
                        @if (!string.IsNullOrEmpty(Model.Order.Note))
                        {
                            <dt class="col-5 text-muted">Ghi chú</dt>
                            <dd class="col-7">@Model.Order.Note</dd>
                        }
                        <dt class="col-5 text-muted">Tổng tiền</dt>
                        <dd class="col-7 fw-bold text-primary">@Model.Order.TotalAmount.ToString("N0")đ</dd>
                        <dt class="col-5 text-muted">Thanh toán</dt>
                        <dd class="col-7">
                            <span class="badge @paymentBadge">@paymentLabel</span>
                            <div class="small text-muted mt-1">@paymentHint</div>
                        </dd>
                        <dt class="col-5 text-muted">Ngày đặt</dt>
                        <dd class="col-7">@Model.Order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
                        <dt class="col-5 text-muted">Trạng thái</dt>
                        <dd class="col-7">
                            <span class="badge @(Model.Order.Status switch {
                                "Pending"   => "bg-warning text-dark",
                                "Confirmed" => "bg-info",
                                "Shipping"  => "bg-primary",
                                "AwaitingReceipt" => "bg-warning text-dark",
                                "Delivered" => "bg-success",
                                _           => "bg-secondary"
                            }) fs-6">@statusLabel</span>
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <!-- Theo dõi xử lý -->
        <div class="col-md-7">
            <div class="card mb-3">
                <div class="card-header fw-semibold">🔄 Theo dõi xử lý</div>
                <div class="card-body">
                    @if (waitingPayOs)
                    {
                        <div class="alert alert-warning py-2 small">
                            Đơn PayOS này đang chờ thanh toán. Chỉ PayOS webhook hợp lệ mới được chuyển sang đã thanh toán.
                        </div>
                    }
                    @if (Model.Order.Status == "Confirmed" && string.IsNullOrEmpty(Model.Order.TrackingCode))
                    {
                        <div class="alert alert-info py-2 small mb-0">
                            Đơn đã xác nhận. Staff sẽ là người tạo vận đơn và chuyển đơn sang Đang giao.
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Admin chỉ theo dõi đơn hàng. Các thao tác xử lý và tạo vận đơn do Staff thực hiện.</p>
                    }
                </div>
            </div>

            <!-- Danh sách sản phẩm -->
            <div class="card">
                <div class="card-header fw-semibold">🛒 Sản phẩm trong đơn</div>
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Loại</th>
                                <th>ID</th>
                                <th>SL</th>
                                <th>Đơn giá</th>
                                <th>Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model.Order.Items ?? Enumerable.Empty<PetShop.Shared.DTOs.Response.OrderItemResponse>())
                        {
                            var itemName = item.ProductName ?? item.PetName;
                            var itemType = item.ProductId.HasValue ? "Sản phẩm" : "Thú cưng";
                            var itemCode = item.ProductId ?? item.PetId;
                            <tr>
                                <td>@(item.ProductId.HasValue ? "🛍️ Sản phẩm" : "🐾 Thú cưng")</td>
                                <td>
                                    <div class="fw-semibold">@(string.IsNullOrWhiteSpace(itemName) ? $"{itemType} #{itemCode}" : itemName)</div>
                                    <div class="small text-muted">#@itemCode</div>
                                </td>
                                <td>@item.Quantity</td>
                                <td>@item.UnitPrice.ToString("N0")đ</td>
                                <td class="fw-semibold">@((item.Quantity * item.UnitPrice).ToString("N0"))đ</td>
                            </tr>
                        }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="4" class="text-end fw-bold">Tổng cộng:</td>
                                <td class="fw-bold text-primary">@Model.Order.TotalAmount.ToString("N0")đ</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
}
