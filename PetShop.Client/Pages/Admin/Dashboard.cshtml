@page
@model PetShop.Client.Pages.Admin.DashboardModel
@{ ViewData["Title"] = "Admin Dashboard"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="mb-0 fw-semibold">Dashboard</h5>
        <small class="text-muted">Xin chào, @Model.UserName</small>
    </div>
    <span id="signalr-status" class="badge bg-secondary">Đang kết nối...</span>
</div>

@* ── Stat Cards hàng 1: Tổng quan ─────────────────────────────────── *@
<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <div class="card text-center border-0 bg-primary bg-opacity-10 h-100">
            <div class="card-body py-3">
                <div class="fs-3 fw-bold text-primary">@Model.TotalProducts</div>
                <div class="small text-muted">🛍️ Sản phẩm</div>
                <div class="small text-muted mt-1">Staff quản lý</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <a href="/Admin/Pets" class="text-decoration-none">
            <div class="card text-center border-0 bg-success bg-opacity-10 h-100">
                <div class="card-body py-3">
                    <div class="fs-3 fw-bold text-success">@Model.TotalPets</div>
                    <div class="small text-muted">🐾 Thú cưng</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a href="/Admin/Orders" class="text-decoration-none">
            <div class="card text-center border-0 bg-warning bg-opacity-10 h-100">
                <div class="card-body py-3">
                    <div class="fs-3 fw-bold text-warning">@Model.PendingOrders</div>
                    <div class="small text-muted">📦 Đơn chờ</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center border-0 bg-info bg-opacity-10 h-100">
            <div class="card-body py-3">
                <div class="fs-4 fw-bold text-info">@Model.TodayRevenue.ToString("N0")đ</div>
                <div class="small text-muted">💰 Doanh thu hôm nay</div>
            </div>
        </div>
    </div>
</div>

@* ── Hàng 2: Người dùng ─────────────────────────────────────────── *@
<div class="row g-3 mb-4">
    <div class="col-4">
        <a href="/Admin/Users" class="text-decoration-none">
            <div class="card border-0 bg-primary bg-opacity-10 h-100">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <span style="font-size:2rem">👥</span>
                    <div>
                        <div class="fs-4 fw-bold text-primary">@Model.TotalUsers</div>
                        <div class="small text-muted">Tổng người dùng</div>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-4">
        <a href="/Admin/Users" class="text-decoration-none">
            <div class="card border-0 bg-warning bg-opacity-10 h-100">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <span style="font-size:2rem">🔧</span>
                    <div>
                        <div class="fs-4 fw-bold text-warning">@Model.TotalStaff</div>
                        <div class="small text-muted">Nhân viên (Staff)</div>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-4">
        <a href="/Admin/Users" class="text-decoration-none">
            <div class="card border-0 bg-success bg-opacity-10 h-100">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <span style="font-size:2rem">🛒</span>
                    <div>
                        <div class="fs-4 fw-bold text-success">@Model.TotalCustomers</div>
                        <div class="small text-muted">Khách hàng</div>
                    </div>
                </div>
            </div>
        </a>
    </div>
</div>

<div id="order-alerts"></div>

<div class="row g-3">
    @* ── Đơn hàng gần đây ─────────────────────────────────────────── *@
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold">📋 Đơn hàng gần đây</span>
                <a href="/Admin/Orders" class="btn btn-sm btn-outline-primary">Xem tất cả</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th><th>Khách hàng</th><th>Tổng tiền</th><th>Trạng thái</th><th>Ngày</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var o in Model.RecentOrders)
                    {
                        <tr>
                            <td>@o.Id</td>
                            <td>@o.UserName</td>
                            <td>@o.TotalAmount.ToString("N0")đ</td>
                            <td>
                                <span class="badge @(o.Status switch {
                                    "Pending"        => "bg-warning text-dark",
                                    "Confirmed"      => "bg-info",
                                    "Shipping"       => "bg-primary",
                                    "AwaitingReceipt"=> "bg-warning text-dark",
                                    "Delivered"      => "bg-success",
                                    _                => "bg-secondary"
                                })">@o.Status</span>
                            </td>
                            <td>@o.CreatedAt.ToString("dd/MM HH:mm")</td>
                            <td><a href="/Admin/Orders/Detail/@o.Id" class="btn btn-sm btn-outline-secondary">Chi tiết</a></td>
                        </tr>
                    }
                    @if (!Model.RecentOrders.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-3">Chưa có đơn hàng</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
<script>
const token  = '@HttpContext.Session.GetString("AccessToken")';
const hubUrl = '@(((IConfiguration)HttpContext.RequestServices.GetRequiredService(typeof(IConfiguration)))["ApiSettings:OrderHubUrl"] ?? "http://localhost:5003/hubs/orders")';
const conn   = new signalR.HubConnectionBuilder()
    .withUrl(hubUrl, { accessTokenFactory: () => token })
    .withAutomaticReconnect()
    .build();

conn.on("NewOrder", data => {
    const amt    = new Intl.NumberFormat('vi-VN').format(data.totalAmount);
    const alerts = document.getElementById("order-alerts");
    alerts.insertAdjacentHTML("afterbegin", `
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Đơn hàng mới #${data.id}</strong> — ${amt}đ vừa được đặt!
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>`);
});

conn.start()
    .then(async () => {
        const badge = document.getElementById("signalr-status");
        badge.className   = "badge bg-success";
        badge.textContent = "🟢 Đã kết nối";
        await conn.invoke("JoinAdminGroup");
    })
    .catch(() => {
        const badge = document.getElementById("signalr-status");
        badge.className   = "badge bg-danger";
        badge.textContent = "🔴 Mất kết nối";
    });
</script>
}
