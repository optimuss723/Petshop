@page
@model PetShop.Client.Pages.Admin.Reports.IndexModel
@{ ViewData["Title"] = "Báo cáo & Thống kê"; }

<div class="ps-backoffice-heading">
    <div>
        <span class="ps-kicker">Phân tích kinh doanh</span>
        <h1>Báo cáo & Thống kê doanh thu</h1>
        <p>Theo dõi tăng trưởng doanh số, tỷ trọng hoàn tất đơn hàng và hiệu suất bán buôn.</p>
    </div>
    <div>
        <a href="?handler=Export" class="btn btn-success">
            <i class="bi bi-file-earmark-excel me-1"></i>Xuất báo cáo Excel
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
        <div>@Model.ErrorMessage</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Stats != null)
{
    <!-- KPI Metrics -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="ps-metric">
                <div class="ps-metric__icon" style="background:#eef8f3;color:#087d62;"><i class="bi bi-cart-check"></i></div>
                <div>
                    <div class="ps-metric__value">@Model.Stats.TotalOrders</div>
                    <div class="ps-metric__label">Tổng đơn hàng</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="ps-metric ps-metric--blue">
                <div class="ps-metric__icon"><i class="bi bi-wallet2"></i></div>
                <div>
                    <div class="ps-metric__value" style="font-size:1.35rem">@Model.Stats.TotalRevenue.ToString("N0")đ</div>
                    <div class="ps-metric__label">Tổng doanh thu</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="ps-metric ps-metric--sun">
                <div class="ps-metric__icon"><i class="bi bi-hourglass-split"></i></div>
                <div>
                    <div class="ps-metric__value">@Model.Stats.PendingCount</div>
                    <div class="ps-metric__label">Đang chờ xử lý</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="ps-metric">
                <div class="ps-metric__icon text-success" style="background:#e8f7f1;"><i class="bi bi-box2-heart"></i></div>
                <div>
                    <div class="ps-metric__value">@Model.Stats.DeliveredCount</div>
                    <div class="ps-metric__label">Đã giao thành công</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-graph-up text-primary me-2"></i>Doanh thu theo các tháng gần đây</h6>
                </div>
                <div class="card-body p-3 p-xl-4">
                    <canvas id="revenueChart" height="110"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-pie-chart text-primary me-2"></i>Cơ cấu trạng thái đơn</h6>
                </div>
                <div class="card-body p-3 p-xl-4 d-flex align-items-center justify-content-center">
                    <div style="width:100%;max-width:280px;">
                        <canvas id="statusChart" height="220"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Chi tiết bảng trạng thái -->
    <div class="ps-table-wrap mb-5">
        <div class="p-3 border-bottom bg-white">
            <h6 class="mb-0 fw-bold"><i class="bi bi-table text-primary me-2"></i>Thống kê chi tiết theo từng trạng thái</h6>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-3">Trạng thái xử lý</th>
                        <th class="text-end" style="width:180px">Số lượng đơn</th>
                        <th class="text-end pe-3" style="width:160px">Tỷ lệ đóng góp</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="ps-3"><span class="badge bg-warning-subtle text-warning-emphasis me-2">⏳</span>Chờ duyệt xử lý (Pending)</td>
                        <td class="text-end fw-semibold">@Model.Stats.PendingCount đơn</td>
                        <td class="text-end pe-3 text-muted">@(Model.Stats.TotalOrders > 0 ? $"{100.0*Model.Stats.PendingCount/Model.Stats.TotalOrders:F1}%" : "0%")</td>
                    </tr>
                    <tr>
                        <td class="ps-3"><span class="badge bg-info-subtle text-info-emphasis me-2">✅</span>Đã xác nhận thanh toán (Confirmed)</td>
                        <td class="text-end fw-semibold">@Model.Stats.ConfirmedCount đơn</td>
                        <td class="text-end pe-3 text-muted">@(Model.Stats.TotalOrders > 0 ? $"{100.0*Model.Stats.ConfirmedCount/Model.Stats.TotalOrders:F1}%" : "0%")</td>
                    </tr>
                    <tr>
                        <td class="ps-3"><span class="badge bg-primary-subtle text-primary me-2">🚚</span>Đang trên đường giao (Shipping)</td>
                        <td class="text-end fw-semibold">@Model.Stats.ShippingCount đơn</td>
                        <td class="text-end pe-3 text-muted">@(Model.Stats.TotalOrders > 0 ? $"{100.0*Model.Stats.ShippingCount/Model.Stats.TotalOrders:F1}%" : "0%")</td>
                    </tr>
                    <tr>
                        <td class="ps-3"><span class="badge bg-warning-subtle text-warning-emphasis me-2">📬</span>Chờ khách hàng nhận (AwaitingReceipt)</td>
                        <td class="text-end fw-semibold">@Model.Stats.AwaitingReceiptCount đơn</td>
                        <td class="text-end pe-3 text-muted">@(Model.Stats.TotalOrders > 0 ? $"{100.0*Model.Stats.AwaitingReceiptCount/Model.Stats.TotalOrders:F1}%" : "0%")</td>
                    </tr>
                    <tr>
                        <td class="ps-3"><span class="badge bg-success-subtle text-success me-2">📦</span>Giao hàng thành công (Delivered)</td>
                        <td class="text-end fw-semibold text-success">@Model.Stats.DeliveredCount đơn</td>
                        <td class="text-end pe-3 fw-bold text-success">@(Model.Stats.TotalOrders > 0 ? $"{100.0*Model.Stats.DeliveredCount/Model.Stats.TotalOrders:F1}%" : "0%")</td>
                    </tr>
                    <tr>
                        <td class="ps-3"><span class="badge bg-secondary-subtle text-secondary me-2">❌</span>Đơn đã huỷ (Cancelled)</td>
                        <td class="text-end fw-semibold text-danger">@Model.Stats.CancelledCount đơn</td>
                        <td class="text-end pe-3 text-muted">@(Model.Stats.TotalOrders > 0 ? $"{100.0*Model.Stats.CancelledCount/Model.Stats.TotalOrders:F1}%" : "0%")</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="ps-empty card">
        <div class="ps-empty__icon"><i class="bi bi-bar-chart"></i></div>
        <h5 class="fw-bold mb-1">Chưa có dữ liệu thống kê</h5>
        <p class="text-muted small mb-0">Hệ thống sẽ cập nhật số liệu khi có đơn hàng đầu tiên phát sinh giao dịch.</p>
    </div>
}

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
const monthly = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Stats?.MonthlyRevenue ?? []));
const stats   = {
    pending:   @(Model.Stats?.PendingCount   ?? 0),
    confirmed: @(Model.Stats?.ConfirmedCount ?? 0),
    shipping:  @(Model.Stats?.ShippingCount  ?? 0),
    awaitingReceipt: @(Model.Stats?.AwaitingReceiptCount ?? 0),
    delivered: @(Model.Stats?.DeliveredCount ?? 0),
    cancelled: @(Model.Stats?.CancelledCount ?? 0)
};

// ── Revenue Bar Chart ─────────────────────────────────────────
const labels  = monthly.map(m => `T${m.month}/${m.year}`);
const revenue = monthly.map(m => m.revenue);

if (document.getElementById('revenueChart')) {
    new Chart(document.getElementById('revenueChart'), {
        type: 'bar',
        data: {
            labels,
            datasets: [{
                label: 'Doanh thu (đ)',
                data: revenue,
                backgroundColor: 'rgba(8, 125, 98, 0.75)',
                borderColor:     'rgba(8, 125, 98, 1)',
                borderWidth: 2,
                borderRadius: 6
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: ctx => ctx.parsed.y.toLocaleString('vi-VN') + 'đ'
                    }
                }
            },
            scales: {
                y: { ticks: { callback: v => (v/1000000).toFixed(1) + 'M' } }
            }
        }
    });
}

// ── Status Doughnut Chart ──────────────────────────────────────
if (document.getElementById('statusChart')) {
    new Chart(document.getElementById('statusChart'), {
        type: 'doughnut',
        data: {
            labels: ['Chờ xử lý', 'Đã xác nhận', 'Đang giao', 'Chờ khách nhận', 'Hoàn tất', 'Đã hủy'],
            datasets: [{
                data: [stats.pending, stats.confirmed, stats.shipping, stats.awaitingReceipt, stats.delivered, stats.cancelled],
                backgroundColor: ['#f59e0b','#06b6d4','#3b82f6','#fb923c','#10b981','#ef4444'],
                borderWidth: 2
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { position: 'bottom', labels: { boxWidth: 12 } } }
        }
    });
}
</script>
}
