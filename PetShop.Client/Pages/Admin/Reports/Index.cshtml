@page
@model PetShop.Client.Pages.Admin.Reports.IndexModel
@{ ViewData["Title"] = "Báo cáo & Thống kê"; }

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0">📊 Báo cáo & Thống kê</h4>
    <a href="?handler=Export" class="btn btn-success btn-sm">
        <i class="bi bi-file-earmark-excel me-1"></i>Xuất Excel
    </a>
</div>

@if (Model.Stats != null)
{
    <!-- KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card text-center border-0 shadow-sm h-100" style="background:linear-gradient(135deg,#667eea,#764ba2)">
                <div class="card-body text-white">
                    <div class="fs-1 fw-bold">@Model.Stats.TotalOrders</div>
                    <div class="small opacity-75">Tổng đơn hàng</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center border-0 shadow-sm h-100" style="background:linear-gradient(135deg,#11998e,#38ef7d)">
                <div class="card-body text-white">
                    <div class="fs-2 fw-bold">@Model.Stats.TotalRevenue.ToString("N0")đ</div>
                    <div class="small opacity-75">Doanh thu</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center border-0 shadow-sm h-100" style="background:linear-gradient(135deg,#f093fb,#f5576c)">
                <div class="card-body text-white">
                    <div class="fs-1 fw-bold">@Model.Stats.PendingCount</div>
                    <div class="small opacity-75">Chờ xử lý</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center border-0 shadow-sm h-100" style="background:linear-gradient(135deg,#4facfe,#00f2fe)">
                <div class="card-body text-white">
                    <div class="fs-1 fw-bold">@Model.Stats.DeliveredCount</div>
                    <div class="small opacity-75">Đã giao</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Biểu đồ doanh thu theo tháng -->
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header fw-semibold">📈 Doanh thu theo tháng</div>
                <div class="card-body">
                    <canvas id="revenueChart" height="100"></canvas>
                </div>
            </div>
        </div>

        <!-- Biểu đồ trạng thái đơn hàng -->
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header fw-semibold">🍩 Trạng thái đơn hàng</div>
                <div class="card-body d-flex align-items-center justify-content-center">
                    <canvas id="statusChart" height="200"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Thống kê chi tiết -->
    <div class="card shadow-sm mt-4">
        <div class="card-header fw-semibold">📋 Chi tiết theo trạng thái</div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr><th>Trạng thái</th><th class="text-end">Số đơn</th><th class="text-end">%</th></tr>
                    </thead>
                    <tbody>
                        <tr><td>⏳ Chờ xử lý</td><td class="text-end">@Model.Stats.PendingCount</td><td class="text-end">@(Model.Stats.TotalOrders > 0 ? $"{100.0*Model.Stats.PendingCount/Model.Stats.TotalOrders:F1}%" : "0%")</td></tr>
                        <tr><td>✅ Đã xác nhận</td><td class="text-end">@Model.Stats.ConfirmedCount</td><td class="text-end">@(Model.Stats.TotalOrders > 0 ? $"{100.0*Model.Stats.ConfirmedCount/Model.Stats.TotalOrders:F1}%" : "0%")</td></tr>
                        <tr><td>🚚 Đang giao</td><td class="text-end">@Model.Stats.ShippingCount</td><td class="text-end">@(Model.Stats.TotalOrders > 0 ? $"{100.0*Model.Stats.ShippingCount/Model.Stats.TotalOrders:F1}%" : "0%")</td></tr>
                        <tr><td>📬 Chờ khách xác nhận</td><td class="text-end">@Model.Stats.AwaitingReceiptCount</td><td class="text-end">@(Model.Stats.TotalOrders > 0 ? $"{100.0*Model.Stats.AwaitingReceiptCount/Model.Stats.TotalOrders:F1}%" : "0%")</td></tr>
                        <tr><td>📦 Hoàn tất</td><td class="text-end">@Model.Stats.DeliveredCount</td><td class="text-end">@(Model.Stats.TotalOrders > 0 ? $"{100.0*Model.Stats.DeliveredCount/Model.Stats.TotalOrders:F1}%" : "0%")</td></tr>
                        <tr><td>❌ Đã hủy</td><td class="text-end">@Model.Stats.CancelledCount</td><td class="text-end">@(Model.Stats.TotalOrders > 0 ? $"{100.0*Model.Stats.CancelledCount/Model.Stats.TotalOrders:F1}%" : "0%")</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="text-center py-5 text-muted">
        <div class="display-4">📊</div>
        <p>Chưa có dữ liệu thống kê</p>
    </div>
}

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
const monthly = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Stats?.MonthlyRevenue ?? []));
const stats   = {
    pending:   @(Model.Stats?.PendingCount   ?? 0),
    confirmed: @(Model.Stats?.ConfirmedCount ?? 0),
    shipping:  @(Model.Stats?.ShippingCount  ?? 0),
    awaitingReceipt: @(Model.Stats?.AwaitingReceiptCount ?? 0),
    delivered: @(Model.Stats?.DeliveredCount ?? 0),
    cancelled: @(Model.Stats?.CancelledCount ?? 0)
};

// ── Revenue Line Chart ─────────────────────────────────────────
const labels  = monthly.map(m => `T${m.month}/${m.year}`);
const revenue = monthly.map(m => m.revenue);

new Chart(document.getElementById('revenueChart'), {
    type: 'bar',
    data: {
        labels,
        datasets: [{
            label: 'Doanh thu (đ)',
            data: revenue,
            backgroundColor: 'rgba(102,126,234,0.7)',
            borderColor:     'rgba(102,126,234,1)',
            borderWidth: 2,
            borderRadius: 6
        }]
    },
    options: {
        responsive: true,
        plugins: {
            legend: { display: false },
            tooltip: {
                callbacks: {
                    label: ctx => ctx.parsed.y.toLocaleString('vi-VN') + 'đ'
                }
            }
        },
        scales: {
            y: { ticks: { callback: v => (v/1000000).toFixed(1) + 'M' } }
        }
    }
});

// ── Status Doughnut Chart ──────────────────────────────────────
new Chart(document.getElementById('statusChart'), {
    type: 'doughnut',
    data: {
        labels: ['Chờ xử lý', 'Đã xác nhận', 'Đang giao', 'Chờ khách xác nhận', 'Hoàn tất', 'Đã hủy'],
        datasets: [{
            data: [stats.pending, stats.confirmed, stats.shipping, stats.awaitingReceipt, stats.delivered, stats.cancelled],
            backgroundColor: ['#ffc107','#0dcaf0','#6610f2','#fd7e14','#198754','#dc3545'],
            borderWidth: 2
        }]
    },
    options: {
        responsive: true,
        plugins: { legend: { position: 'bottom', labels: { boxWidth: 12 } } }
    }
});
</script>
}
