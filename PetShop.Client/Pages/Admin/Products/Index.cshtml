@page
@model PetShop.Client.Pages.Admin.Products.IndexModel
@{ ViewData["Title"] = "Quản lý Sản phẩm"; }

<div class="ps-backoffice-heading">
    <div>
        <span class="ps-kicker">Kho hàng & Danh mục</span>
        <h1>Quản lý Sản phẩm</h1>
        <p>Quản lý toàn bộ danh mục thức ăn, phụ kiện, y tế và đồ chơi thú cưng.</p>
    </div>
    <div>
        <a href="/Admin/Products/Edit" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>Thêm sản phẩm mới
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill text-success fs-5"></i>
        <div>@Model.Message</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filter Bar -->
<div class="ps-filter-toolbar mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-3">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input name="search" value="@Model.Search" class="form-control border-start-0 ps-0" placeholder="Tìm tên sản phẩm..."/>
            </div>
        </div>
        <div class="col-md-2">
            <select name="category" class="form-select">
                <option value="">Tất cả danh mục</option>
                <option value="Food"      selected="@(Model.Category=="Food")">🍖 Thức ăn</option>
                <option value="Accessory" selected="@(Model.Category=="Accessory")">🎀 Phụ kiện</option>
                <option value="Medicine"  selected="@(Model.Category=="Medicine")">💊 Y tế - Thuốc</option>
                <option value="Toy"       selected="@(Model.Category=="Toy")">🎾 Đồ chơi</option>
                <option value="Grooming"  selected="@(Model.Category=="Grooming")">✂️ Dụng cụ vệ sinh</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="sort" class="form-select">
                <option value="CreatedAt desc" selected="@(Model.Sort=="CreatedAt desc")">Mới nhất trước</option>
                <option value="Name asc"       selected="@(Model.Sort=="Name asc")">Tên A-Z</option>
                <option value="Name desc"      selected="@(Model.Sort=="Name desc")">Tên Z-A</option>
                <option value="Price asc"      selected="@(Model.Sort=="Price asc")">Giá tăng dần</option>
                <option value="Price desc"     selected="@(Model.Sort=="Price desc")">Giá giảm dần</option>
                <option value="Stock asc"      selected="@(Model.Sort=="Stock asc")">Tồn kho thấp nhất</option>
            </select>
        </div>
        <div class="col-md-1">
            <select name="pageSize" class="form-select">
                <option value="4"  selected="@(Model.PageSize==4)">4</option>
                <option value="8"  selected="@(Model.PageSize==8)">8</option>
                <option value="12" selected="@(Model.PageSize==12)">12</option>
                <option value="16" selected="@(Model.PageSize==16)">16</option>
                <option value="24" selected="@(Model.PageSize==24)">24</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill">
                <i class="bi bi-funnel me-1"></i>Lọc
            </button>
            <a href="/Admin/Products" class="btn btn-outline-secondary">Xoá lọc</a>
        </div>
    </form>
</div>

@{
    string CategoryIcon(string cat) => cat switch {
        "Food"      => "🍖",
        "Accessory" => "🎀",
        "Medicine"  => "💊",
        "Toy"       => "🎾",
        "Grooming"  => "✂️",
        _           => "📦"
    };
}

<!-- Product Cards Grid -->
<div class="row row-cols-1 row-cols-md-3 row-cols-xl-4 g-3 mb-4">
@foreach (var p in Model.Products)
{
    <div class="col">
        <div class="card h-100 ps-management-card">
            @if (!string.IsNullOrEmpty(p.ImageUrl))
            {
                <div class="ps-management-card__thumb" style="height: 180px; overflow: hidden; background: #f8fafc;">
                    <img src="@p.ImageUrl" alt="@p.Name" loading="lazy" referrerpolicy="no-referrer" style="height: 180px; width: 100%; object-fit: cover;" onerror="this.onerror=null;this.parentElement.innerHTML='<div class=\'ps-management-card__thumb-fallback fs-1\' style=\'height:180px;display:flex;align-items:center;justify-content:center;\'>@CategoryIcon(p.Category)</div>'"/>
                </div>
            }
            else
            {
                <div class="ps-management-card__thumb" style="height: 180px; overflow: hidden; background: #f8fafc;">
                    <div class="ps-management-card__thumb-fallback fs-1" style="height: 180px; display: flex; align-items: center; justify-content: center;">@CategoryIcon(p.Category)</div>
                </div>
            }
            <div class="card-body p-3 d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                    <span class="badge bg-light text-muted border" style="font-size:0.75rem">#@p.Id</span>
                    <span class="badge @(p.IsActive ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") fw-semibold">
                        @(p.IsActive ? "Đang bán" : "Tạm ẩn")
                    </span>
                </div>
                <h6 class="card-title fw-bold text-dark mb-1" style="font-size:0.95rem;line-height:1.35">@p.Name</h6>
                <p class="text-muted small mb-2 text-truncate" style="max-height:2.6em;">@p.Description</p>

                <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-primary fs-6">@p.Price.ToString("N0")đ</span>
                    <span class="small badge @(p.Stock < 10 ? "bg-danger-subtle text-danger" : "bg-secondary-subtle text-secondary")">
                        Kho: @p.Stock
                    </span>
                </div>
            </div>
            <div class="card-footer bg-light border-top p-2.5 d-flex gap-2">
                <a href="/Admin/Products/Edit/@p.Id" class="btn btn-sm btn-outline-primary flex-fill">
                    <i class="bi bi-pencil-square me-1"></i>Sửa
                </a>
                <form method="post" asp-page-handler="Delete" class="flex-fill"
                      onsubmit="return confirm('Xoá sản phẩm @p.Name?')">
                    <input type="hidden" name="id" value="@p.Id"/>
                    <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                        <i class="bi bi-trash me-1"></i>Xoá
                    </button>
                </form>
            </div>
        </div>
    </div>
}
@if (!Model.Products.Any())
{
    <div class="col-12">
        <div class="ps-empty card">
            <div class="ps-empty__icon"><i class="bi bi-box2"></i></div>
            <h5 class="fw-bold mb-1">Không tìm thấy sản phẩm nào</h5>
            <p class="text-muted small mb-3">Thử đổi điều kiện tìm kiếm hoặc thêm sản phẩm mới vào kho.</p>
            <a href="/Admin/Products/Edit" class="btn btn-primary btn-sm px-4">Thêm sản phẩm</a>
        </div>
    </div>
}
</div>

<!-- Pagination & Metadata -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 p-3 bg-white rounded border mt-3">
    <div class="d-flex align-items-center gap-2">
        <span class="text-muted small">Tổng cộng: <strong>@Model.TotalCount</strong> sản phẩm</span>
        <span class="badge @(Model.UsedOData ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-secondary")">
            @(Model.UsedOData ? "⚡ OData Protocol" : "REST Fallback")
        </span>
    </div>
    @if (Model.TotalPages > 1)
    {
        <nav>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-route-search="@Model.Search"
                       asp-route-category="@Model.Category"
                       asp-route-sort="@Model.Sort"
                       asp-route-page="@(Model.PageNumber - 1)"
                       asp-route-pageSize="@Model.PageSize">‹</a>
                </li>
                @for (var i = Math.Max(1, Model.PageNumber - 2); i <= Math.Min(Model.TotalPages, Model.PageNumber + 2); i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link"
                           asp-route-search="@Model.Search"
                           asp-route-category="@Model.Category"
                           asp-route-sort="@Model.Sort"
                           asp-route-page="@i"
                           asp-route-pageSize="@Model.PageSize">@i</a>
                    </li>
                }
                <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-route-search="@Model.Search"
                       asp-route-category="@Model.Category"
                       asp-route-sort="@Model.Sort"
                       asp-route-page="@(Model.PageNumber + 1)"
                       asp-route-pageSize="@Model.PageSize">›</a>
                </li>
            </ul>
        </nav>
    }
</div>
