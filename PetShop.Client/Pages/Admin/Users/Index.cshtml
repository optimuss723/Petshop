@page
@model PetShop.Client.Pages.Admin.Users.IndexModel
@{ ViewData["Title"] = "Quản lý Users"; }

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-info alert-dismissible fade show">
        @Model.Message <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">👤 Quản lý Người dùng</h4>
        <p class="text-muted mb-0">Tổng: @Model.Users.Count tài khoản</p>
    </div>
    <div class="d-flex gap-2">
        <span class="badge bg-success fs-6">@Model.Users.Count(u => u.IsActive) Hoạt động</span>
        <span class="badge bg-danger fs-6">@Model.Users.Count(u => !u.IsActive) Bị khóa</span>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Tên</th>
                        <th>Email</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var u in Model.Users)
                {
                    <tr class="@(!u.IsActive ? "table-secondary" : "")">
                        <td class="text-muted">#@u.Id</td>
                        <td>
                            <div class="fw-semibold">@u.FullName</div>
                            <div class="text-muted small">@u.Phone</div>
                        </td>
                        <td>@u.Email</td>
                        <td>
                            @{
                                var (badgeClass, icon) = u.Role switch
                                {
                                    "Admin"    => ("bg-danger",  "🛡️"),
                                    "Staff"   => ("bg-warning text-dark", "🔧"),
                                    _          => ("bg-primary", "👤")
                                };
                            }
                            <span class="badge @badgeClass">@icon @u.Role</span>
                        </td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="badge bg-success">✅ Hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">🔒 Bị khóa</span>
                            }
                        </td>
                        <td class="text-muted small">@u.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td class="text-center">
                            @if (u.Role != "Admin")
                            {
                                if (u.IsActive)
                                {
                                    <form method="post" asp-page-handler="Deactivate" class="d-inline"
                                          onsubmit="return confirm('Vô hiệu hoá tài khoản @u.FullName?')">
                                        <input type="hidden" name="id" value="@u.Id"/>
                                        <button class="btn btn-outline-danger btn-sm">🔒 Khóa</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="Activate" class="d-inline">
                                        <input type="hidden" name="id" value="@u.Id"/>
                                        <button class="btn btn-outline-success btn-sm">🔓 Mở khóa</button>
                                    </form>
                                }
                            }
                            else
                            {
                                <span class="text-muted small">Protected</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
