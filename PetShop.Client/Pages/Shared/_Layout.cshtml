<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " — PetShop" : "PetShop")</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
    <style>
        body { background: #f8f9fa; }
        .sidebar { min-height: 100vh; background: #1e293b; color: #cbd5e1; }
        .sidebar a { color: #cbd5e1; text-decoration: none; display: block; padding: .5rem 1rem; border-radius: 6px; margin-bottom:2px; }
        .sidebar a:hover, .sidebar a.active { background: #334155; color: #fff; }
        .sidebar .nav-header { font-size: .7rem; text-transform:uppercase; letter-spacing:.08em; color:#64748b; padding: .75rem 1rem .25rem; }
        .main-content { padding: 1.5rem; }
        .navbar-brand { font-weight: 700; }
        .notif-badge { position:absolute; top:-4px; right:-4px; font-size:.6rem; min-width:16px; }
        @* Notification toast *@
        .order-notif-toast { min-width:280px; }
    </style>
</head>
<body>

@{
    var role     = Context.Session.GetString("UserRole") ?? "";
    var isAuth   = !string.IsNullOrEmpty(Context.Session.GetString("AccessToken"));
    var userName = Context.Session.GetString("UserName") ?? "";
    var isAdmin  = role == "Admin" || role == "Staff";
    var path     = Context.Request.Path.Value ?? "/";
}

@if (isAdmin)
{
    <!-- Admin Layout (Sidebar) -->
    <div class="d-flex">
        <div class="sidebar d-flex flex-column" style="width:240px;min-width:240px">
            <div class="p-3 border-bottom border-secondary">
                <span class="fw-bold text-white fs-5">🐾 PetShop</span>
                <div class="small text-muted mt-1">@userName</div>
                <span class="badge @(role == "Admin" ? "bg-danger" : "bg-warning text-dark") small">
                    @(role == "Admin" ? "🛡️ Admin" : "🔧 Staff")
                </span>
            </div>
            <nav class="flex-grow-1 p-2 pt-3">
                <div class="nav-header">Tổng quan</div>
                <a href="/Admin/Dashboard" class="@(path.StartsWith("/Admin/Dashboard") ? "active" : "")">
                    <i class="bi bi-speedometer2 me-2"></i>Dashboard
                </a>
                <a href="/Admin/Reports" class="@(path.StartsWith("/Admin/Reports") ? "active" : "")">
                    <i class="bi bi-bar-chart me-2"></i>Báo cáo
                    <span class="badge bg-success ms-1" style="font-size:.6rem">Mới</span>
                </a>
                <div class="nav-header mt-2">Quản lý</div>
                <a href="/Admin/Orders" class="@(path.StartsWith("/Admin/Orders") ? "active" : "")">
                    <i class="bi bi-box me-2"></i>Đơn hàng
                </a>
                <div class="nav-header mt-2">Hệ thống</div>
                <a href="/Admin/Users" class="@(path.StartsWith("/Admin/Users") ? "active" : "")">
                    <i class="bi bi-people me-2"></i>Người dùng
                    <span class="badge bg-info ms-1" style="font-size:.6rem">Mới</span>
                </a>
                <div class="nav-header mt-2">Tài khoản</div>
                <a href="/Auth/Logout"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a>
            </nav>
        </div>
        <div class="flex-grow-1">
            <!-- Admin notification badge area -->
            <div id="admin-order-alerts" class="position-fixed top-0 end-0 p-3" style="z-index:1100;max-width:350px"></div>
            <div class="main-content">
                @RenderBody()
            </div>
        </div>
    </div>
}
else
{
    <!-- Customer/Public Layout (Topbar) -->
    <nav class="navbar navbar-expand-lg bg-white shadow-sm mb-0 sticky-top">
        <div class="container">
            <a class="navbar-brand text-primary" href="/">🐾 PetShop</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMain">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link @(path == "/" || path == "/Index" ? "active" : "")" href="/">Trang chủ</a></li>
                    @if (isAuth)
                    {
                        <li class="nav-item"><a class="nav-link @(path.StartsWith("/User/Orders") ? "active" : "")" href="/User/Orders">📦 Đơn hàng</a></li>
                        <li class="nav-item"><a class="nav-link @(path == "/User/Dashboard" ? "active" : "")" href="/User/Dashboard">👤 Trang cá nhân</a></li>
                        <li class="nav-item"><a class="nav-link @(path.StartsWith("/User/Profile") ? "active" : "")" href="/User/Profile">⚙️ Hồ sơ</a></li>
                    }
                </ul>
                <ul class="navbar-nav ms-auto align-items-center gap-2">
                    <!-- 🛒 Giỏ hàng -->
                    <li class="nav-item">
                        <a class="btn btn-outline-primary btn-sm position-relative" href="/Cart">
                            🛒 Giỏ hàng
                            <span id="cart-count" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size:.65rem"></span>
                        </a>
                    </li>
                    <!-- 🔔 Thông báo đơn hàng (#11 #12) -->
                    @if (isAuth)
                    {
                        <li class="nav-item">
                            <div class="position-relative" style="cursor:pointer" data-bs-toggle="offcanvas" data-bs-target="#notifOffcanvas">
                                <button class="btn btn-outline-secondary btn-sm">
                                    <i class="bi bi-bell"></i>
                                    <span id="notif-count" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger notif-badge" style="display:none">0</span>
                                </button>
                            </div>
                        </li>
                    }
                    @if (isAuth)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/User/Profile">
                                <i class="bi bi-person-circle"></i> @userName
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-outline-secondary btn-sm" href="/Auth/Logout">Đăng xuất</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="btn btn-outline-primary btn-sm" href="/Auth/Login">Đăng nhập</a></li>
                        <li class="nav-item"><a class="btn btn-primary btn-sm" href="/Auth/Register">Đăng ký</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Notification Offcanvas (#12) -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="notifOffcanvas" style="width:320px">
        <div class="offcanvas-header">
            <h6 class="offcanvas-title fw-bold">🔔 Thông báo</h6>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body p-0">
            <div id="notif-list" class="list-group list-group-flush">
                <div class="text-center text-muted py-5" id="notif-empty">Chưa có thông báo</div>
            </div>
        </div>
        <div class="offcanvas-footer p-3 border-top">
            <button class="btn btn-sm btn-outline-secondary w-100" onclick="clearNotifications()">Xóa tất cả</button>
        </div>
    </div>

    <div class="container py-4">
        @RenderBody()
    </div>
}

<!-- Cart / Alert Toast -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index:1050">
    <div id="cart-toast" class="toast align-items-center text-bg-success border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body" id="cart-toast-msg">Đã thêm vào giỏ hàng!</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
<script>
// ── Cart Badge ──────────────────────────────────────────────────────
const PETSHOP_CART_KEY = 'petshop_cart';

function normalizeCartItem(item) {
    if (!item) return null;

    const type = String(item.type || '').toLowerCase();
    const id = Number(item.id);
    const price = Number(item.price);
    let qty = Number(item.qty || 1);

    if ((type !== 'product' && type !== 'pet') || !Number.isInteger(id) || id <= 0 || !Number.isFinite(price)) {
        return null;
    }

    qty = Math.max(1, Math.floor(qty));
    if (type === 'pet') qty = 1;

    return {
        type,
        id,
        name: String(item.name || ''),
        price,
        qty
    };
}

function readCartFrom(storage) {
    try {
        const value = storage.getItem(PETSHOP_CART_KEY);
        const parsed = value ? JSON.parse(value) : [];
        return Array.isArray(parsed) ? parsed : [];
    } catch {
        return [];
    }
}

function getPetShopCart() {
    const sessionItems = readCartFrom(sessionStorage);
    const localItems = readCartFrom(localStorage);
    const source = sessionItems.length > 0 ? sessionItems : localItems;
    const cart = source.map(normalizeCartItem).filter(Boolean);

    if (sessionItems.length === 0 && localItems.length > 0) {
        sessionStorage.setItem(PETSHOP_CART_KEY, JSON.stringify(cart));
    }

    return cart;
}

function savePetShopCart(cart) {
    const normalized = (Array.isArray(cart) ? cart : []).map(normalizeCartItem).filter(Boolean);
    sessionStorage.setItem(PETSHOP_CART_KEY, JSON.stringify(normalized));
    return normalized;
}

function clearPetShopCart() {
    sessionStorage.removeItem(PETSHOP_CART_KEY);
    localStorage.removeItem(PETSHOP_CART_KEY);
}

function addPetShopCartItem(type, id, name, price) {
    const item = normalizeCartItem({ type, id, name, price, qty: 1 });
    if (!item) return { added: false, reason: 'invalid' };

    const cart = getPetShopCart();
    const existing = cart.find(i => i.type === item.type && i.id === item.id);
    if (existing) {
        if (item.type === 'pet') return { added: false, reason: 'duplicate-pet' };
        existing.qty += 1;
    } else {
        cart.push(item);
    }

    savePetShopCart(cart);
    updateCartBadge();
    return { added: true };
}

function updateCartBadge() {
    const total = getPetShopCart().reduce((s, i) => s + i.qty, 0);
    const badge = document.getElementById('cart-count');
    if (badge) badge.textContent = total > 0 ? total : '';
}

window.PetShopCart = {
    get: getPetShopCart,
    save: savePetShopCart,
    clear: clearPetShopCart,
    add: addPetShopCartItem,
    updateBadge: updateCartBadge
};

updateCartBadge();
window.addEventListener('storage', updateCartBadge);
window.addEventListener('pageshow', updateCartBadge);

// ── Notification System (#11 #12) ──────────────────────────────────
let notifications = JSON.parse(sessionStorage.getItem('petshop_notifs') || '[]');
function saveNotifications() { sessionStorage.setItem('petshop_notifs', JSON.stringify(notifications)); }

function addNotification(msg, type = 'info') {
    notifications.unshift({ msg, type, time: new Date().toLocaleTimeString('vi-VN'), read: false });
    if (notifications.length > 20) notifications.pop();
    saveNotifications();
    renderNotifications();

    // Toast popup
    const toastEl  = document.getElementById('cart-toast');
    const toastMsg = document.getElementById('cart-toast-msg');
    if (toastEl && toastMsg) {
        toastEl.className = `toast align-items-center text-bg-${type === 'warning' ? 'warning' : 'info'} border-0`;
        toastMsg.textContent = msg;
        new bootstrap.Toast(toastEl, { delay: 5000 }).show();
    }
}

function renderNotifications() {
    const list = document.getElementById('notif-list');
    const empty = document.getElementById('notif-empty');
    const badge = document.getElementById('notif-count');
    if (!list) return;

    const unread = notifications.filter(n => !n.read).length;
    if (badge) {
        badge.style.display = unread > 0 ? 'inline-block' : 'none';
        badge.textContent   = unread > 0 ? unread : '';
    }

    if (notifications.length === 0) { if (empty) empty.style.display='block'; return; }
    if (empty) empty.style.display = 'none';

    list.innerHTML = '<div class="text-center text-muted py-5" id="notif-empty" style="display:none">Chưa có thông báo</div>';
    notifications.forEach((n, i) => {
        const item = document.createElement('div');
        item.className = `list-group-item list-group-item-action py-2 ${n.read ? 'text-muted' : 'fw-semibold'}`;
        item.innerHTML = `<div class="d-flex justify-content-between"><span>${n.msg}</span><small>${n.time}</small></div>`;
        item.onclick = () => { notifications[i].read = true; saveNotifications(); renderNotifications(); };
        list.appendChild(item);
    });
}

function clearNotifications() {
    notifications = [];
    saveNotifications();
    renderNotifications();
}

renderNotifications();

// ── SignalR Order Hub (Customer) — #11 ──────────────────────────────
@if (isAuth && !isAdmin)
{
    var userId = Context.Session.GetString("UserId") ?? "";
    var orderHubUrlStr = ((IConfiguration)Context.RequestServices.GetRequiredService(typeof(IConfiguration)))["ApiSettings:OrderHubUrl"] ?? "http://localhost:5003/hubs/orders";
    <text>
const orderHubUrl = '@orderHubUrlStr';
const orderConn = new signalR.HubConnectionBuilder()
    .withUrl(orderHubUrl)
    .withAutomaticReconnect()
    .build();

orderConn.on('OrderStatusChanged', data => {
    const statusMap = { Confirmed:'✅ Đã xác nhận', Shipping:'🚚 Đang giao hàng', AwaitingReceipt:'📬 Chờ bạn xác nhận đã nhận', Delivered:'📦 Đã nhận hàng', Cancelled:'❌ Đã hủy' };
    const label = statusMap[data.newStatus] || data.newStatus;
    addNotification(`Đơn hàng #${data.orderId}: ${label}`, data.newStatus === 'Cancelled' ? 'warning' : 'info');
});

orderConn.start()
    .then(() => orderConn.invoke('JoinUserGroup', '@userId'))
    .catch(err => console.warn('[SignalR] Order hub:', err));
    </text>
}

// ── SignalR Admin New Order notification ────────────────────────────
@if (isAdmin)
{
    var adminHubUrlStr = ((IConfiguration)Context.RequestServices.GetRequiredService(typeof(IConfiguration)))["ApiSettings:OrderHubUrl"] ?? "http://localhost:5003/hubs/orders";
    <text>
const adminOrderHubUrl = '@adminHubUrlStr';
const adminOrderConn = new signalR.HubConnectionBuilder()
    .withUrl(adminOrderHubUrl)
    .withAutomaticReconnect()
    .build();

adminOrderConn.on('NewOrder', data => {
    const container = document.getElementById('admin-order-alerts');
    if (!container) return;
    const div = document.createElement('div');
    div.className = 'alert alert-success alert-dismissible fade show shadow mt-2';
    div.innerHTML = `🔔 <strong>Đơn hàng mới #${data.orderId}</strong> — ${Number(data.totalAmount).toLocaleString('vi-VN')}đ <button type="button" class="btn-close" data-bs-dismiss="alert"></button>`;
    container.prepend(div);
    setTimeout(() => { try { bootstrap.Alert.getOrCreateInstance(div).close(); } catch(_){div.remove();} }, 8000);
});

adminOrderConn.start()
    .then(() => adminOrderConn.invoke('JoinAdminGroup'))
    .catch(err => console.warn('[SignalR] Admin order hub:', err));
    </text>
}
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
