@page
@model PetShop.Client.Pages.Auth.RegisterModel
@{ ViewData["Title"] = "Đăng ký"; Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>PetShop — Tạo tài khoản thành viên</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
    <link rel="stylesheet" href="~/css/petshop-design.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/petshop-storefront.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/auth-validation.css" asp-append-version="true"/>
</head>
<body class="ps-auth-body">

<!-- Left Brand Showcase Aside -->
<aside class="ps-auth-aside">
    <div>
        <a href="/" class="d-inline-flex align-items-center gap-2 text-white text-decoration-none mb-4">
            <span class="ps-brand-mark bg-white text-dark">🐾</span>
            <span class="fs-4 fw-bold">PetShop Solution</span>
        </a>
    </div>

    <div>
        <div class="badge bg-white text-dark px-3 py-1.5 rounded-pill mb-3 fw-bold">
            <i class="bi bi-gift-fill text-danger me-1"></i>Đặc quyền thành viên mới
        </div>
        <h1 class="text-white mb-3">Gia nhập cộng đồng yêu thú cưng</h1>
        <p class="mb-4">
            Đăng ký tài khoản để tích điểm đổi quà, đặt lịch thăm đàn cưng và nhận sổ theo dõi sức khỏe điện tử trọn đời.
        </p>
        <div class="d-flex flex-column gap-2 small text-light opacity-90">
            <div><i class="bi bi-check-circle-fill text-warning me-2"></i>Nhận ngay voucher giảm giá cho đơn hàng đầu tiên</div>
            <div><i class="bi bi-check-circle-fill text-warning me-2"></i>Lưu sổ địa chỉ giao hàng tiện lợi và bảo mật</div>
            <div><i class="bi bi-check-circle-fill text-warning me-2"></i>Thông báo ngay khi đàn cún/mèo thuần chủng mới về</div>
        </div>
    </div>

    <div class="pt-4 border-top border-white-50 d-flex justify-content-between align-items-center small text-white-50">
        <span>© @DateTime.Now.Year PetShop Solution</span>
        <a href="/" class="text-white text-decoration-none">
            <i class="bi bi-arrow-left me-1"></i>Quay lại trang chủ
        </a>
    </div>
</aside>

<!-- Right Form Pane -->
<main class="ps-auth-form-pane">
    <div class="ps-auth-card py-4">
        <div class="d-lg-none text-center mb-4">
            <a href="/" class="d-inline-flex align-items-center gap-2 text-dark text-decoration-none">
                <span class="ps-brand-mark">🐾</span>
                <span class="fs-4 fw-bold">PetShop</span>
            </a>
        </div>

        <div class="mb-4">
            <h2 class="mb-1">Tạo tài khoản mới</h2>
            <p class="text-muted small">Điền thông tin để bắt đầu hành trình cùng PetShop</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger py-2 d-flex align-items-center gap-2 mb-3">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div class="small">@Model.ErrorMessage</div>
            </div>
        }

        <form method="post" id="registerForm" novalidate>
            <div class="mb-3">
                <label class="form-label small fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-person"></i></span>
                    <input asp-for="Input.FullName"
                           class="form-control border-start-0 ps-0"
                           placeholder="Nguyễn Văn A"
                           id="fullName"
                           minlength="2"
                           required/>
                </div>
                <div class="invalid-feedback" id="fullName-error">
                    Vui lòng nhập họ tên (ít nhất 2 ký tự)
                </div>
                <span asp-validation-for="Input.FullName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold">Địa chỉ Email <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                    <input asp-for="Input.Email"
                           type="email"
                           class="form-control border-start-0 ps-0"
                           placeholder="name@example.com"
                           id="email"
                           required/>
                </div>
                <div class="invalid-feedback" id="email-error">
                    Vui lòng nhập email hợp lệ
                </div>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold">Mật khẩu <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                    <input asp-for="Input.Password"
                           type="password"
                           class="form-control border-start-0 ps-0"
                           id="password"
                           placeholder="Tối thiểu 6 ký tự"
                           minlength="6"
                           required/>
                </div>
                <div class="password-strength">
                    <div class="password-strength-bar" id="strengthBar"></div>
                </div>
                <div class="strength-text" id="strengthText"></div>
                <div class="invalid-feedback" id="password-error">
                    Mật khẩu phải có ít nhất 6 ký tự
                </div>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold">Số điện thoại <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-telephone"></i></span>
                    <input asp-for="Input.Phone"
                           type="tel"
                           class="form-control border-start-0 ps-0"
                           placeholder="0987654321"
                           id="phone"
                           pattern="^(0|\+84)[0-9]{9,10}$"
                           required/>
                </div>
                <div class="invalid-feedback" id="phone-error">
                    Vui lòng nhập số điện thoại hợp lệ (VD: 0987654321)
                </div>
                <span asp-validation-for="Input.Phone" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label class="form-label small fw-semibold">Địa chỉ giao hàng mặc định <span class="text-muted">(tuỳ chọn)</span></label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-geo-alt"></i></span>
                    <input asp-for="Input.Address"
                           class="form-control border-start-0 ps-0"
                           placeholder="Số nhà, đường, phường, quận..."
                           id="address"/>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2.5 fw-bold" id="submitBtn">
                <span id="btnText"><i class="bi bi-person-check me-1"></i>Đăng ký tài khoản</span>
                <span id="btnSpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
            </button>
        </form>

        <div class="mt-4 pt-3 border-top text-center small text-muted">
            Đã có tài khoản thành viên?
            <a href="/Auth/Login" class="fw-bold text-success text-decoration-none ms-1">Đăng nhập ngay</a>
        </div>
        <div class="mt-2 text-center small">
            <a href="/" class="text-muted text-decoration-none">← Quay về trang chủ mua sắm</a>
        </div>
    </div>
</main>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('registerForm');
        const submitBtn = document.getElementById('submitBtn');
        const btnText = document.getElementById('btnText');
        const btnSpinner = document.getElementById('btnSpinner');

        // Input fields
        const fullName = document.getElementById('fullName');
        const email = document.getElementById('email');
        const password = document.getElementById('password');
        const phone = document.getElementById('phone');

        // Password strength indicator
        const strengthBar = document.getElementById('strengthBar');
        const strengthText = document.getElementById('strengthText');

        // Validation functions
        function validateFullName() {
            const value = fullName.value.trim();
            if (value.length < 2) {
                setInvalid(fullName, 'fullName-error', 'Họ tên phải có ít nhất 2 ký tự');
                return false;
            }
            setValid(fullName);
            return true;
        }

        function validateEmail() {
            const value = email.value.trim();
            const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            if (!emailRegex.test(value)) {
                setInvalid(email, 'email-error', 'Email không hợp lệ');
                return false;
            }
            setValid(email);
            return true;
        }

        function validatePassword() {
            const value = password.value;
            if (value.length < 6) {
                setInvalid(password, 'password-error', 'Mật khẩu phải có ít nhất 6 ký tự');
                return false;
            }
            setValid(password);
            return true;
        }

        function validatePhone() {
            const value = phone.value.trim();
            const phoneRegex = /^(0|\+84)[0-9]{9,10}$/;
            if (!phoneRegex.test(value)) {
                setInvalid(phone, 'phone-error', 'Số điện thoại không hợp lệ (VD: 0987654321)');
                return false;
            }
            setValid(phone);
            return true;
        }

        function setInvalid(element, errorId, message) {
            element.classList.remove('is-valid');
            element.classList.add('is-invalid');
            const errorElement = document.getElementById(errorId);
            if (errorElement) {
                errorElement.textContent = message;
            }
        }

        function setValid(element) {
            element.classList.remove('is-invalid');
            element.classList.add('is-valid');
        }

        // Password strength checker
        function checkPasswordStrength() {
            const value = password.value;
            let strength = 0;

            if (value.length >= 6) strength++;
            if (value.length >= 8) strength++;
            const hasLower = /[a-z]/.test(value);
            const hasUpper = /[A-Z]/.test(value);
            if (hasLower && hasUpper) strength++;
            if (/[0-9]/.test(value)) strength++;
            const hasSpecial = /[^a-zA-Z0-9]/.test(value);
            if (hasSpecial) strength++;

            strengthBar.className = 'password-strength-bar';

            if (value.length === 0) {
                strengthBar.style.width = '0%';
                strengthText.textContent = '';
            } else if (strength <= 2) {
                strengthBar.classList.add('weak');
                strengthText.textContent = '⚠️ Mật khẩu yếu';
                strengthText.style.color = '#c44048';
            } else if (strength <= 3) {
                strengthBar.classList.add('medium');
                strengthText.textContent = '⚡ Mật khẩu trung bình';
                strengthText.style.color = '#d89a13';
            } else {
                strengthBar.classList.add('strong');
                strengthText.textContent = '✅ Mật khẩu mạnh';
                strengthText.style.color = '#087d62';
            }
        }

        // Real-time validation
        fullName.addEventListener('blur', validateFullName);
        fullName.addEventListener('input', function() {
            if (this.classList.contains('is-invalid')) {
                validateFullName();
            }
        });

        email.addEventListener('blur', validateEmail);
        email.addEventListener('input', function() {
            if (this.classList.contains('is-invalid')) {
                validateEmail();
            }
        });

        password.addEventListener('input', checkPasswordStrength);
        password.addEventListener('blur', validatePassword);
        password.addEventListener('input', function() {
            if (this.classList.contains('is-invalid')) {
                validatePassword();
            }
        });

        phone.addEventListener('blur', validatePhone);
        phone.addEventListener('input', function() {
            if (this.classList.contains('is-invalid')) {
                validatePhone();
            }
        });

        // Form submission
        form.addEventListener('submit', function(e) {
            const isFullNameValid = validateFullName();
            const isEmailValid = validateEmail();
            const isPasswordValid = validatePassword();
            const isPhoneValid = validatePhone();

            if (!isFullNameValid || !isEmailValid || !isPasswordValid || !isPhoneValid) {
                e.preventDefault();

                if (!isFullNameValid) fullName.focus();
                else if (!isEmailValid) email.focus();
                else if (!isPasswordValid) password.focus();
                else if (!isPhoneValid) phone.focus();

                return false;
            }

            // Show loading state
            submitBtn.disabled = true;
            btnText.textContent = 'Đang xử lý tạo tài khoản...';
            btnSpinner.classList.remove('d-none');
        });

        // Auto-format phone number
        phone.addEventListener('input', function() {
            let value = this.value.replace(/\D/g, '');
            if (value.startsWith('84')) {
                value = '0' + value.substring(2);
            }
            this.value = value.substring(0, 11);
        });
    });
</script>

</body>
</html>
