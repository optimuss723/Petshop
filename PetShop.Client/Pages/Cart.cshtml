@page
@model PetShop.Client.Pages.CartModel
@{
    ViewData["Title"] = "Giỏ hàng thanh toán";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div class="d-flex align-items-center gap-3">
        <a href="/" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i>Tiếp tục mua sắm
        </a>
        <h4 class="mb-0 fw-bold"><i class="bi bi-cart3 text-primary me-2"></i>Giỏ hàng của bạn</h4>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
        <div>@Model.ErrorMessage</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-check-circle-fill fs-5"></i>
        <div>@Model.SuccessMessage</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Empty Cart State -->
<div id="cart-empty" class="ps-surface ps-cart-empty text-center mb-5" style="display:none">
    <div class="ps-cart-empty__icon mb-3">
        <i class="bi bi-cart-x"></i>
    </div>
    <h4 class="fw-bold mb-2">Giỏ hàng của bạn đang trống</h4>
    <p class="text-muted small mb-4" style="max-width:380px;margin:auto;">
        Hãy khám phá các sản phẩm thức ăn thơm ngon, đồ chơi rèn luyện hoặc các bé thú cưng thuần chủng tại PetShop nhé!
    </p>
    <a href="/" class="btn btn-primary px-4 py-2">
        <i class="bi bi-bag-plus me-1"></i> Bắt đầu mua sắm ngay
    </a>
</div>

<!-- Cart Content Layout -->
<div id="cart-content">
    <div class="row g-4 align-items-start">
        <!-- Item List -->
        <div class="col-lg-7 col-xl-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                    <span class="fw-bold">
                        <i class="bi bi-bag-check text-primary me-1"></i>Sản phẩm đã chọn (<span id="cart-item-count" class="text-primary">0</span>)
                    </span>
                    <button class="btn btn-outline-danger btn-sm" onclick="clearCart()">
                        <i class="bi bi-trash3 me-1"></i>Xóa toàn bộ
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0" id="cart-table">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Sản phẩm / Thú cưng</th>
                                    <th class="text-center" style="width:130px">Số lượng</th>
                                    <th class="text-end" style="width:140px">Thành tiền</th>
                                    <th style="width:48px"></th>
                                </tr>
                            </thead>
                            <tbody id="cart-items"></tbody>
                            <tfoot id="cart-footer" class="table-light">
                                <tr class="fw-bold">
                                    <td colspan="2" class="text-end py-3 ps-3">Tổng cộng tiền hàng:</td>
                                    <td class="text-end text-success fs-5 py-3" id="cart-total">0đ</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Shopping Guarantees -->
            <div class="row g-3">
                <div class="col-sm-4">
                    <div class="ps-contact-card p-3 d-flex align-items-center gap-2">
                        <i class="bi bi-truck fs-3 text-success"></i>
                        <div>
                            <div class="fw-bold small">Miễn phí giao hàng</div>
                            <div class="text-muted" style="font-size:0.75rem">Đơn từ 500k toàn quốc</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="ps-contact-card p-3 d-flex align-items-center gap-2">
                        <i class="bi bi-arrow-repeat fs-3 text-primary"></i>
                        <div>
                            <div class="fw-bold small">Đổi trả dễ dàng</div>
                            <div class="text-muted" style="font-size:0.75rem">Trong vòng 7 ngày nếu lỗi</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="ps-contact-card p-3 d-flex align-items-center gap-2">
                        <i class="bi bi-shield-lock fs-3 text-warning"></i>
                        <div>
                            <div class="fw-bold small">Thanh toán an toàn</div>
                            <div class="text-muted" style="font-size:0.75rem">Bảo mật chuẩn PayOS</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Checkout Side Summary -->
        <div class="col-lg-5 col-xl-4">
            <div class="card shadow-sm ps-checkout-summary">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-receipt text-primary me-2"></i>Thông tin đơn & Giao nhận</h6>
                </div>
                <div class="card-body p-3 p-xl-4">
                    @if (!string.IsNullOrEmpty(HttpContext.Session.GetString("AccessToken")))
                    {
                        <form method="post" id="order-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="CartJson" id="cart-json-input"/>

                            <!-- Recipient Summary -->
                            <div class="ps-contact-card p-3 mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-bold small text-muted text-uppercase">Khách hàng nhận</span>
                                    <a href="/User/Profile" class="small text-decoration-none">Sửa hồ sơ</a>
                                </div>
                                <div class="fw-semibold text-dark mb-1">
                                    <i class="bi bi-person me-1 text-muted"></i>@(string.IsNullOrWhiteSpace(Model.CustomerName) ? "Chưa cập nhật tên" : Model.CustomerName)
                                </div>
                                <div class="small text-muted">
                                    <i class="bi bi-telephone me-1 text-muted"></i>
                                    @if (string.IsNullOrWhiteSpace(Model.CustomerPhone))
                                    {
                                        <span class="text-danger fw-semibold">Vui lòng cập nhật số điện thoại</span>
                                    }
                                    else
                                    {
                                        @Model.CustomerPhone
                                    }
                                </div>
                            </div>

                            <!-- Address Input -->
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted text-uppercase mb-1">
                                    Địa chỉ giao hàng <span class="text-danger">*</span>
                                </label>
                                <textarea name="ShippingAddress" class="form-control" rows="2"
                                          placeholder="Số nhà, tên đường, phường/xã, quận/huyện...">@Model.ShippingAddress</textarea>
                                <div class="invalid-feedback">Vui lòng nhập địa chỉ nhận hàng cụ thể.</div>
                            </div>

                            <!-- Note Input -->
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted text-uppercase mb-1">Ghi chú giao hàng</label>
                                <input name="Note" class="form-control" placeholder="Thời gian giao thuận tiện, hướng dẫn gửi đồ..."/>
                            </div>

                            <!-- Summary Totals -->
                            <div class="ps-contact-card p-3 mb-4">
                                <div class="d-flex justify-content-between small text-muted mb-2">
                                    <span>Tạm tính tiền hàng:</span>
                                    <span id="summary-subtotal" class="fw-semibold text-dark">0đ</span>
                                </div>
                                <div class="d-flex justify-content-between small text-muted mb-2">
                                    <span>Phí giao hàng:</span>
                                    <span class="text-success fw-semibold"><i class="bi bi-check2 me-1"></i>Miễn phí toàn quốc</span>
                                </div>
                                <hr class="my-2 border-secondary-subtle">
                                <div class="d-flex justify-content-between align-items-center fw-bold">
                                    <span class="fs-6">Tổng cần trả:</span>
                                    <span class="text-primary fs-5" id="summary-total">0đ</span>
                                </div>
                            </div>

                            <!-- Payment Options -->
                            <div class="d-grid gap-2">
                                <button type="button" class="btn btn-primary btn-lg" onclick="submitPayOs()" id="payos-btn">
                                    <i class="bi bi-qr-code-scan me-2"></i>Thanh toán qua PayOS (QR)
                                </button>
                                <button type="button" class="btn btn-outline-success btn-lg" onclick="submitOrder()" id="checkout-btn">
                                    <i class="bi bi-cash-stack me-2"></i>Thanh toán khi nhận hàng (COD)
                                </button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <div class="ps-empty__icon mb-2" style="width:3.5rem;height:3.5rem;font-size:1.5rem">
                                <i class="bi bi-lock-fill"></i>
                            </div>
                            <h6 class="fw-bold mb-1">Đăng nhập để đặt hàng</h6>
                            <p class="text-muted small mb-4">
                                Vui lòng đăng nhập hoặc tạo tài khoản để PetShop lưu lịch sử đơn và hỗ trợ bảo hành tốt nhất.
                            </p>
                            <div class="d-grid gap-2">
                                <a href="/Auth/Login" class="btn btn-primary">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập thành viên
                                </a>
                                <a href="/Auth/Register" class="btn btn-outline-secondary">
                                    <i class="bi bi-person-plus me-1"></i>Tạo tài khoản mới
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
/* ── Cart Storage Helpers ───────────────────── */
function getCart() {
    if (window.PetShopCart) return window.PetShopCart.get();
    try {
        const parsed = JSON.parse(sessionStorage.getItem('petshop_cart') || '[]');
        return Array.isArray(parsed) ? parsed : [];
    } catch {
        return [];
    }
}
function saveCart(cart) {
    if (window.PetShopCart) window.PetShopCart.save(cart);
    else sessionStorage.setItem('petshop_cart', JSON.stringify(cart));
    updateCartBadge();
}
function updateCartBadge() {
    if (window.PetShopCart) {
        window.PetShopCart.updateBadge();
        return;
    }
    const cart = getCart();
    const total = cart.reduce((s, i) => s + Number(i.qty || 0), 0);
    const badge = document.getElementById('cart-count');
    if (badge) badge.textContent = total > 0 ? total : '';
}

/* ── Cart Mutations ────────────────────────── */
function clearCart() {
    if (!confirm('Bạn có chắc chắn muốn xóa toàn bộ giỏ hàng không?')) return;
    if (window.PetShopCart) window.PetShopCart.clear();
    else sessionStorage.removeItem('petshop_cart');
    updateCartBadge();
    renderCart();
}
function removeItem(type, id) {
    const cart = getCart().filter(i => !(i.type === type && i.id === id));
    saveCart(cart);
    renderCart();
}
function updateQty(type, id, delta) {
    const cart = getCart();
    const item = cart.find(i => i.type === type && i.id === id);
    if (!item) return;
    item.qty = Math.max(1, item.qty + delta);
    if (item.type === 'pet') item.qty = 1;
    saveCart(cart);
    renderCart();
}

/* ── Render Function ───────────────────────── */
function renderCart() {
    const cart    = getCart();
    const tbody   = document.getElementById('cart-items');
    const empty   = document.getElementById('cart-empty');
    const content = document.getElementById('cart-content');
    const counter = document.getElementById('cart-item-count');

    if (cart.length === 0) {
        if (empty) empty.style.display   = '';
        if (content) content.style.display = 'none';
        return;
    }
    if (empty) empty.style.display   = 'none';
    if (content) content.style.display = '';

    let html  = '';
    let total = 0;
    let count = 0;

    cart.forEach(item => {
        const subtotal = item.price * item.qty;
        total += subtotal;
        count += item.qty;

        const emoji  = item.type === 'pet' ? '🐾' : '🛍️';
        const label  = item.type === 'pet' ? 'Thú cưng thuần chủng' : 'Sản phẩm phụ kiện';
        const qtyCtrl = item.type === 'pet'
            ? `<span class="badge bg-secondary-subtle text-secondary px-3 py-1.5 fw-bold">1</span>
               <span class="d-block text-muted" style="font-size:0.68rem">Cố định 1</span>`
            : `<div class="input-group input-group-sm justify-content-center" style="max-width:110px;margin:auto">
                 <button class="btn btn-outline-secondary" type="button"
                         onclick="updateQty('${item.type}',${item.id},-1)">−</button>
                 <span class="form-control text-center fw-bold bg-white">${item.qty}</span>
                 <button class="btn btn-outline-secondary" type="button"
                         onclick="updateQty('${item.type}',${item.id},1)">+</button>
               </div>`;

        html += `<tr>
            <td class="ps-3 py-3">
                <div class="d-flex align-items-center gap-3">
                    <span style="font-size:1.8rem">${emoji}</span>
                    <div>
                        <div class="fw-bold text-dark">${item.name}</div>
                        <div class="small text-muted">${label} · <strong class="text-dark">${item.price.toLocaleString('vi-VN')}đ</strong></div>
                    </div>
                </div>
            </td>
            <td class="text-center py-3">${qtyCtrl}</td>
            <td class="text-end fw-bold text-primary py-3">${subtotal.toLocaleString('vi-VN')}đ</td>
            <td class="text-center py-3">
                <button class="btn btn-sm btn-link text-danger p-0"
                        onclick="removeItem('${item.type}',${item.id})"
                        title="Xóa món này">
                    <i class="bi bi-x-circle fs-5"></i>
                </button>
            </td>
        </tr>`;
    });

    if (tbody) tbody.innerHTML = html;
    if (counter) counter.textContent = count;

    const fmtTotal = total.toLocaleString('vi-VN') + 'đ';
    const cTotal = document.getElementById('cart-total');
    if (cTotal) cTotal.textContent = fmtTotal;

    const sub = document.getElementById('summary-subtotal');
    const tot = document.getElementById('summary-total');
    if (sub) sub.textContent = fmtTotal;
    if (tot) tot.textContent = fmtTotal;
}

/* ── Checkout Actions ──────────────────────── */
function prepareCheckout() {
    const cart = getCart();
    if (cart.length === 0) {
        if (typeof showToast === 'function') showToast('Giỏ hàng trống! Vui lòng chọn sản phẩm.', 'warning');
        else alert('Giỏ hàng trống! Vui lòng chọn sản phẩm.');
        return false;
    }

    const addressInput = document.querySelector('[name=ShippingAddress]');
    if (!addressInput) return false;

    const addr = addressInput.value.trim();
    if (!addr) {
        addressInput.classList.add('is-invalid');
        addressInput.focus();
        return false;
    }

    addressInput.classList.remove('is-invalid');
    const jsonInput = document.getElementById('cart-json-input');
    if (jsonInput) jsonInput.value = JSON.stringify(cart);
    return true;
}

function submitOrder() {
    if (!prepareCheckout()) return;

    const btn = document.getElementById('checkout-btn');
    if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang tạo đơn COD...';
    }

    document.getElementById('order-form').submit();
}

function submitPayOs() {
    if (!prepareCheckout()) return;

    const btn = document.getElementById('payos-btn');
    if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang kết nối cổng PayOS...';
    }

    const form = document.getElementById('order-form');
    form.action = '/User/PayOS';
    form.submit();
}

function initCartPage() {
    renderCart();
    updateCartBadge();
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCartPage);
} else {
    initCartPage();
}

window.addEventListener('pageshow', initCartPage);
</script>
}
