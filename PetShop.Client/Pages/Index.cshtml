<!-- ────── PETS SECTION ────── -->
<section id="pets" class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold mb-0">🐾 Thú cưng <span class="badge bg-success">@Model.PetTotal</span></h3>
    </div>
    @if (!Model.Pets.Any())
    {
        <div class="text-center py-5 text-muted">
            <div class="display-4">🐾</div>
            <p>Không tìm thấy thú cưng phù hợp</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-4">
        @foreach (var p in Model.Pets)
        {
            var em2 = p.Category switch { "Dog"=>"🐕","Cat"=>"🐈","Bird"=>"🐦","Fish"=>"🐟","Rabbit"=>"🐇",_=>"🐾" };
            <div class="col">
                <div class="card h-100 shadow-sm border-0" style="transition:transform .2s,box-shadow .2s"
                     onmouseenter="this.style.transform='translateY(-4px)';this.style.boxShadow='0 8px 24px rgba(0,0,0,.12)'"
                     onmouseleave="this.style.transform='';this.style.boxShadow=''">
                    @if (!string.IsNullOrEmpty(p.ImageUrl)) {
                        <img src="@p.ImageUrl" class="card-img-top" style="height:160px;object-fit:cover" alt="@p.Name"/>
                    } else {
                        <div class="d-flex align-items-center justify-content-center bg-light rounded-top" style="height:130px;font-size:4rem">@em2</div>
                    }
                    <div class="card-body">
                        <span class="badge bg-light text-dark border mb-1">@p.Category</span>
                        <h6 class="card-title fw-bold">@p.Name</h6>
                        <p class="card-text text-muted small">@p.Breed · @p.AgeMonths tháng tuổi</p>
                        <div class="fw-bold text-success">@p.Price.ToString("N0")đ</div>
                    </div>
                    <div class="card-footer bg-transparent border-top d-flex gap-2">
                        <a href="/Pets/Detail/@p.Id" class="btn btn-outline-success btn-sm flex-grow-1">👁 Xem chi tiết</a>
                        @if (p.Status == "Available") {
                            <button class="btn btn-success btn-sm" onclick="addToCart('pet',@p.Id,'@Html.Raw(p.Name.Replace("'","\\'"))',@p.Price)">🛒</button>
                        } else {
                            <span class="badge bg-secondary align-self-center">Đã bán</span>
                        }
                    </div>
                </div>
            </div>
        }
        </div>
        @if (Model.PetPages > 1)
        {
            <nav class="d-flex justify-content-center mt-4">
                <ul class="pagination pagination-sm">
                    <li class="page-item @(Model.PetPage <= 1 ? "disabled" : "")">
                        <a class="page-link" href="?search=@Model.Search&category=@Model.Category&minPrice=@Model.MinPrice&maxPrice=@Model.MaxPrice&petPage=@(Model.PetPage-1)#pets">‹</a>
                    </li>
                    @for (int pg = Math.Max(1, Model.PetPage-2); pg <= Math.Min(Model.PetPages, Model.PetPage+2); pg++)
                    {
                        <li class="page-item @(pg == Model.PetPage ? "active" : "")">
                            <a class="page-link" href="?search=@Model.Search&category=@Model.Category&minPrice=@Model.MinPrice&maxPrice=@Model.MaxPrice&petPage=@pg#pets">@pg</a>
                        </li>
                    }
                    <li class="page-item @(Model.PetPage >= Model.PetPages ? "disabled" : "")">
                        <a class="page-link" href="?search=@Model.Search&category=@Model.Category&minPrice=@Model.MinPrice&maxPrice=@Model.MaxPrice&petPage=@(Model.PetPage+1)#pets">›</a>
                    </li>
                </ul>
            </nav>
        }
    }
</section>

@section Scripts {
<script>
function addToCart(type, id, name, price) {
    const cart = JSON.parse(sessionStorage.getItem('petshop_cart') || '[]');
    const ex   = cart.find(i => i.type === type && i.id === id);
    if (ex) { if (type === 'pet') { alert('Thú cưng đã có trong giỏ hàng.'); return; } ex.qty++; }
    else cart.push({ type, id, name, price, qty: 1 });
    sessionStorage.setItem('petshop_cart', JSON.stringify(cart));
    updateCartBadge();
    const toastMsg = document.getElementById('cart-toast-msg');
    const toastEl  = document.getElementById('cart-toast');
    if (toastEl && toastMsg) {
        toastEl.className = 'toast align-items-center text-bg-success border-0';
        toastMsg.textContent = `✅ Đã thêm "${name}" vào giỏ hàng!`;
        new bootstrap.Toast(toastEl, { delay: 2500 }).show();
    }
}
// Alias để tương thích code cũ
function addToCartFromIndex(t,i,n,p){ addToCart(t,i,n,p); }
</script>
}
