@section Scripts {
<script>
function addToCart(type, id, name, price) {
    if (window.PetShopCart) {
        const result = window.PetShopCart.add(type, id, name, price);
        if (result.added) {
            showToast(`✅ Đã thêm "${name}" vào giỏ hàng!`, 'success');
        } else if (result.reason === 'duplicate-pet') {
            showToast('Thú cưng đã có trong giỏ hàng.', 'warning');
        }
        return;
    }
    const cart = JSON.parse(sessionStorage.getItem('petshop_cart') || '[]');
    const ex   = cart.find(i => i.type === type && i.id === id);
    if (ex) { if (type === 'pet') { showToast('Thú cưng đã có trong giỏ hàng.', 'warning'); return; } ex.qty++; }
    else cart.push({ type, id, name, price, qty: 1 });
    sessionStorage.setItem('petshop_cart', JSON.stringify(cart));
    if (typeof updateCartBadge === 'function') updateCartBadge();
    showToast(`✅ Đã thêm "${name}" vào giỏ hàng!`, 'success');
}
function addToCartFromIndex(t,i,n,p){ addToCart(t,i,n,p); }
</script>
}
