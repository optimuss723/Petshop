@page
@model PetShop.Client.Pages.IndexModel
@{
    ViewData["Title"] = "PetShop — Hệ thống thú cưng thuần chủng, Spa & Phụ kiện cao cấp";
    ViewData["Description"] = "Cung cấp thú cưng thuần chủng có sổ tiêm, dịch vụ Spa Grooming, Pet Hotel và thức ăn phụ kiện chính hãng";
    string JsName(string name) => (name ?? "").Replace("\\", "\\\\").Replace("'", "\\'");
}

<!-- ═══ Hero Banner (PetNow Style) ═══ -->
<div class="ps-hero mb-4">
    <div class="row align-items-center g-0">
        <div class="col-lg-7 ps-hero__content">
            <div class="ps-hero__eyebrow mb-2">
                <i class="bi bi-patch-check-fill text-warning"></i> HỆ THỐNG THÚ CƯNG & SPA THÚ Y CHUẨN MỰC
            </div>
            <h1>
                Đón Thú Cưng Thuần Chủng &<br/>
                <span style="color:#d8f5e9">Chăm Sóc Chuẩn 5 Sao</span> 🐾
            </h1>
            <p class="mb-4">
                Hơn 1.000+ cún mèo thuần chủng có hợp đồng pháp lý, bảo hành Care/Parvo 30 ngày, tặng kèm gói quà 500k và dịch vụ Spa - Khách sạn thú cưng chuyên nghiệp.
            </p>
            <div class="d-flex gap-2 flex-wrap mb-4">
                <a href="#pets" class="btn btn-light px-4 fw-bold">
                    <i class="bi bi-heart-fill text-danger me-1"></i> Xem đàn thú cưng mới về
                </a>
                <a href="#spa-services" class="btn btn-outline-light px-4 fw-semibold">
                    <i class="bi bi-scissors me-1"></i> Dịch vụ Spa & Hotel
                </a>
                <a href="#products" class="btn btn-outline-light px-3 fw-semibold">
                    <i class="bi bi-bag-check me-1"></i> Mua sắm phụ kiện
                </a>
            </div>

            <!-- Trust highlights pills -->
            <div class="d-flex flex-wrap gap-2 pt-2 border-top border-white border-opacity-25 small">
                <span class="badge bg-white bg-opacity-25 text-white fw-normal py-1.5 px-2.5">
                    <i class="bi bi-check-circle-fill text-warning me-1"></i>100% Thuần chủng trọn đời
                </span>
                <span class="badge bg-white bg-opacity-25 text-white fw-normal py-1.5 px-2.5">
                    <i class="bi bi-shield-check text-warning me-1"></i>Bảo hành 30 ngày
                </span>
                <span class="badge bg-white bg-opacity-25 text-white fw-normal py-1.5 px-2.5">
                    <i class="bi bi-truck text-warning me-1"></i>Miễn phí vận chuyển toàn quốc
                </span>
                <span class="badge bg-white bg-opacity-25 text-white fw-normal py-1.5 px-2.5">
                    <i class="bi bi-telephone-fill text-warning me-1"></i>Bác sĩ thú y hỗ trợ 24/7
                </span>
            </div>
        </div>
        <div class="col-lg-5 d-none d-lg-flex justify-content-center p-4">
            <div class="ps-hero__pets">🐕🐈</div>
        </div>
    </div>
</div>

<!-- ═══ 4 Core Service Pillars (Chuẩn PetNow) ═══ -->
<div class="row g-3 mb-5">
    <div class="col-6 col-md-3">
        <a href="#pets" class="card h-100 text-decoration-none border text-center p-3 ps-pillar-card shadow-sm">
            <div class="fs-1 mb-2">🐕</div>
            <h6 class="fw-bold text-dark mb-1">Chó Cảnh Thuần Chủng</h6>
            <div class="text-muted small">Golden, Corgi, Poodle, Husky, Shiba...</div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a href="#pets" class="card h-100 text-decoration-none border text-center p-3 ps-pillar-card shadow-sm">
            <div class="fs-1 mb-2">🐈</div>
            <h6 class="fw-bold text-dark mb-1">Mèo Cảnh Cao Cấp</h6>
            <div class="text-muted small">Mèo Anh lông ngắn, Scottish Fold, Ragdoll...</div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a href="#spa-services" class="card h-100 text-decoration-none border text-center p-3 ps-pillar-card shadow-sm">
            <div class="fs-1 mb-2">🛁</div>
            <h6 class="fw-bold text-dark mb-1">Dịch Vụ Spa & Tỉa Lông</h6>
            <div class="text-muted small">Tắm dưỡng lông, cắt tỉa thẩm mỹ, khử mùi</div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a href="#spa-services" class="card h-100 text-decoration-none border text-center p-3 ps-pillar-card shadow-sm">
            <div class="fs-1 mb-2">🏨</div>
            <h6 class="fw-bold text-dark mb-1">Khách Sạn Thú Cưng</h6>
            <div class="text-muted small">Phòng riêng máy lạnh, camera 24/7</div>
        </a>
    </div>
</div>

<!-- ═══ Quick Category Shortcuts ═══ -->
<div class="ps-category-row mb-4">
    <a href="#pets" class="ps-category-chip border-success fw-bold text-success">
        <span>🐾</span> Đàn thú cưng mới về
    </a>
    <a href="?category=Food" class="ps-category-chip @(Model.Category == "Food" ? "border-success fw-bold text-success" : "")">
        <span>🥩</span> Thức ăn hạt & pate
    </a>
    <a href="?category=Toy" class="ps-category-chip @(Model.Category == "Toy" ? "border-success fw-bold text-success" : "")">
        <span>🎾</span> Đồ chơi rèn luyện
    </a>
    <a href="?category=Accessory" class="ps-category-chip @(Model.Category == "Accessory" ? "border-success fw-bold text-success" : "")">
        <span>🎀</span> Phụ kiện & Chuồng nệm
    </a>
    <a href="?category=Medicine" class="ps-category-chip @(Model.Category == "Medicine" ? "border-success fw-bold text-success" : "")">
        <span>💊</span> Dinh dưỡng & Thuốc thú y
    </a>
    <a href="#spa-services" class="ps-category-chip">
        <span>✂️</span> Bảng giá Spa & Hotel
    </a>
</div>

<!-- ═══ Filter Bar ═══ -->
<div class="card ps-filter mb-5">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold mb-1">
                    <i class="bi bi-search me-1 text-muted"></i>Tìm kiếm tên
                </label>
                <input name="search" class="form-control form-control-sm" placeholder="Tìm thức ăn, phụ kiện, thú cưng..." value="@Model.Search"/>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold mb-1">
                    <i class="bi bi-tags me-1 text-muted"></i>Danh mục
                </label>
                <select name="category" class="form-select form-select-sm">
                    <option value="">Tất cả danh mục</option>
                    <option value="Food"      selected="@(Model.Category=="Food"?"selected":null)">🥩 Thức ăn</option>
                    <option value="Toy"       selected="@(Model.Category=="Toy"?"selected":null)">🎾 Đồ chơi</option>
                    <option value="Accessory" selected="@(Model.Category=="Accessory"?"selected":null)">🎀 Phụ kiện</option>
                    <option value="Medicine"  selected="@(Model.Category=="Medicine"?"selected":null)">💊 Y tế & Thuốc</option>
                    <option value="Dog"       selected="@(Model.Category=="Dog"?"selected":null)">🐕 Chó</option>
                    <option value="Cat"       selected="@(Model.Category=="Cat"?"selected":null)">🐈 Mèo</option>
                    <option value="Bird"      selected="@(Model.Category=="Bird"?"selected":null)">🐦 Chim</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold mb-1">Giá tối thiểu</label>
                <input name="minPrice" type="number" class="form-control form-control-sm" placeholder="0đ" value="@Model.MinPrice"/>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold mb-1">Giá tối đa</label>
                <input name="maxPrice" type="number" class="form-control form-control-sm" placeholder="Không giới hạn" value="@Model.MaxPrice"/>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="bi bi-funnel me-1"></i> Lọc danh sách
                </button>
            </div>
        </form>

        @if (Model.IsFiltering)
        {
            <div class="mt-3 pt-2 border-top d-flex align-items-center flex-wrap gap-1">
                <span class="small text-muted me-1"><i class="bi bi-funnel-fill me-1"></i>Đang lọc theo:</span>
                @if (!string.IsNullOrEmpty(Model.Search))   { <span class="badge bg-primary">Từ khóa: @Model.Search</span> }
                @if (!string.IsNullOrEmpty(Model.Category)) { <span class="badge bg-success">Danh mục: @Model.Category</span> }
                @if (Model.MinPrice.HasValue)                { <span class="badge bg-secondary">Từ @Model.MinPrice.Value.ToString("N0")đ</span> }
                @if (Model.MaxPrice.HasValue)                { <span class="badge bg-secondary">Đến @Model.MaxPrice.Value.ToString("N0")đ</span> }
                <a href="/" class="btn btn-link btn-sm text-danger text-decoration-none p-0 ms-2 fw-semibold">
                    <i class="bi bi-x-circle me-1"></i>Xóa bộ lọc
                </a>
            </div>
        }
    </div>
</div>

@if (Model.IsFiltering)
{
    <!-- ═══ Search & Filtering View ═══ -->
    <section id="products" class="ps-section mt-0 mb-5">
        <div class="ps-section__heading">
            <div>
                <span class="ps-kicker">Kết quả lọc</span>
                <h2>Sản phẩm phù hợp (@Model.ProductTotal)</h2>
            </div>
            <a href="/" class="ps-section__link">✕ Xóa bộ lọc</a>
        </div>

        @if (!Model.Products.Any())
        {
            <div class="ps-empty card">
                <div class="ps-empty__icon"><i class="bi bi-search"></i></div>
                <h5 class="fw-bold mb-1">Không tìm thấy sản phẩm nào</h5>
                <p class="small mb-3">Vui lòng thử tìm với từ khóa khác hoặc xóa bớt tiêu chí lọc.</p>
                <div>
                    <a href="/" class="btn btn-primary btn-sm px-4">Xem tất cả sản phẩm</a>
                </div>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var p in Model.Products)
            {
                var em = p.Category switch { "Food"=>"🍖","Accessory"=>"🎀","Medicine"=>"💊","Toy"=>"🎾",_=>"📦" };
                <div class="col">
                    <div class="ps-catalog-card">
                        <div class="ps-catalog-card__media">
                            @if (!string.IsNullOrEmpty(p.ImageUrl)) {
                                <img src="@p.ImageUrl" alt="@p.Name" loading="lazy"/>
                            } else {
                                <span class="ps-catalog-card__fallback">@em</span>
                            }
                        </div>
                        <div class="ps-catalog-card__body">
                            <div class="ps-catalog-card__meta">
                                <span class="ps-catalog-card__tag">@p.Category</span>
                                @if (p.Stock > 0) {
                                    <span class="badge bg-success-subtle text-success small">Còn @p.Stock sản phẩm</span>
                                } else {
                                    <span class="badge bg-danger-subtle text-danger small">Tạm hết hàng</span>
                                }
                            </div>
                            <h3 class="ps-catalog-card__title">@p.Name</h3>
                            <p class="ps-catalog-card__description">@p.Description</p>
                            <div class="mt-auto pt-2">
                                <span class="ps-catalog-card__price">@p.Price.ToString("N0")đ</span>
                            </div>
                        </div>
                        <div class="ps-catalog-card__footer">
                            <a href="/Products/Detail/@p.Id" class="btn btn-outline-primary btn-sm">Chi tiết</a>
                            @if (p.Stock > 0) {
                                <button class="btn btn-primary btn-sm btn-icon" onclick="addToCart('product',@p.Id,'@JsName(p.Name)',@p.Price)" title="Thêm vào giỏ">
                                    <i class="bi bi-cart-plus"></i>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
            </div>

            @if (Model.ProductPages > 1)
            {
                <nav class="d-flex justify-content-center mt-5" aria-label="Phân trang sản phẩm">
                    <ul class="pagination pagination-sm">
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" href="?search=@Model.Search&category=@Model.Category&minPrice=@Model.MinPrice&maxPrice=@Model.MaxPrice&page=@(Model.CurrentPage-1)">‹</a>
                        </li>
                        @for (int pg = Math.Max(1, Model.CurrentPage-2); pg <= Math.Min(Model.ProductPages, Model.CurrentPage+2); pg++)
                        {
                            <li class="page-item @(pg == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" href="?search=@Model.Search&category=@Model.Category&minPrice=@Model.MinPrice&maxPrice=@Model.MaxPrice&page=@pg">@pg</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage >= Model.ProductPages ? "disabled" : "")">
                            <a class="page-link" href="?search=@Model.Search&category=@Model.Category&minPrice=@Model.MinPrice&maxPrice=@Model.MaxPrice&page=@(Model.CurrentPage+1)">›</a>
                        </li>
                    </ul>
                </nav>
            }
        }
    </section>
}
else
{
    <!-- ═══ SECTION 1: THÚ CƯNG THUẦN CHỦNG (MẶT HÀNG TRỌNG TÂM - PETNOW STYLE) ═══ -->
    <section id="pets" class="ps-section mt-2 mb-5">
        <div class="ps-section__heading">
            <div>
                <span class="ps-kicker text-success fw-bold"><i class="bi bi-stars me-1"></i>Đàn Bé Đang Chờ Chủ Mới</span>
                <h2>🐾 Thú Cưng Thuần Chủng Tuyển Chọn (@Model.PetTotal)</h2>
            </div>
            <div class="small text-muted d-none d-md-block">
                <i class="bi bi-shield-check text-success me-1"></i>Đầy đủ sổ tiêm · Bảo hành 30 ngày Care/Parvo
            </div>
        </div>

        @if (!Model.Pets.Any())
        {
            <div class="ps-empty card">
                <div class="ps-empty__icon"><i class="bi bi-heart"></i></div>
                <h5 class="fw-bold mb-1">Hiện chưa có thú cưng phù hợp</h5>
                <p class="small text-muted mb-0">Vui lòng quay lại sau hoặc liên hệ hotline 1900 1234 để đặt trước giống yêu thích.</p>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-4">
            @foreach (var p in Model.Pets)
            {
                var em2 = p.Category switch { "Dog"=>"🐕","Cat"=>"🐈","Bird"=>"🐦","Fish"=>"🐟","Rabbit"=>"🐇",_=>"🐾" };
                var sku = "PET" + p.Id.ToString("D3");
                if (p.Name.Contains("Mã "))
                {
                    var parts = p.Name.Split(new[] { "Mã " }, StringSplitOptions.None);
                    if (parts.Length > 1) sku = parts[1].Trim();
                }
                var gender = p.Name.Contains("Đực") ? "Đực" : (p.Name.Contains("Cái") ? "Cái" : "Đực/Cái");

                <div class="col">
                    <div class="ps-catalog-card position-relative">
                        <div class="ps-catalog-card__media position-relative">
                            @if (!string.IsNullOrEmpty(p.ImageUrl)) {
                                <img src="@p.ImageUrl" alt="@p.Name" loading="lazy"/>
                            } else {
                                <span class="ps-catalog-card__fallback">@em2</span>
                            }
                            <span class="badge bg-danger position-absolute top-0 start-0 m-2 shadow-sm" style="font-size:0.7rem;">
                                Thuần chủng
                            </span>
                            <span class="badge bg-dark bg-opacity-75 position-absolute bottom-0 end-0 m-2 text-white" style="font-size:0.7rem;">
                                SKU: @sku
                            </span>
                        </div>
                        <div class="ps-catalog-card__body">
                            <div class="ps-catalog-card__meta">
                                <span class="ps-catalog-card__tag">@p.Category</span>
                                <span class="badge bg-primary-subtle text-primary small">@gender</span>
                                <span class="badge bg-info-subtle text-dark small">@p.AgeMonths tháng tuổi</span>
                                @if (p.Status == "Available") {
                                    <span class="badge bg-success-subtle text-success small ms-auto"><i class="bi bi-check-circle-fill me-1"></i>Sẵn sàng</span>
                                } else {
                                    <span class="badge bg-secondary-subtle text-secondary small ms-auto">@(p.Status == "Sold" ? "Đã đón" : "Đã cọc")</span>
                                }
                            </div>
                            <h3 class="ps-catalog-card__title">
                                <a href="/Pets/Detail/@p.Id" class="text-decoration-none text-dark">@p.Name</a>
                            </h3>
                            <p class="ps-catalog-card__description">
                                <i class="bi bi-shield-check text-success me-1"></i>Đã tiêm 2 mũi vaccine, tẩy giun định kỳ. Tặng bộ quà 500k khi đón bé.
                            </p>
                            <div class="mt-auto pt-2">
                                <span class="ps-catalog-card__price">@p.Price.ToString("N0")đ</span>
                            </div>
                        </div>
                        <div class="ps-catalog-card__footer">
                            <a href="/Pets/Detail/@p.Id" class="btn btn-outline-success btn-sm fw-semibold">Xem chi tiết</a>
                            @if (p.Status == "Available") {
                                <button class="btn btn-success btn-sm btn-icon" onclick="addToCart('pet',@p.Id,'@JsName(p.Name)',@p.Price)" title="Đón bé ngay">
                                    <i class="bi bi-cart-plus"></i>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
            </div>

            @if (Model.PetPages > 1)
            {
                <nav class="d-flex justify-content-center mt-5" aria-label="Phân trang thú cưng">
                    <ul class="pagination pagination-sm">
                        <li class="page-item @(Model.PetPage <= 1 ? "disabled" : "")">
                            <a class="page-link" href="?search=@Model.Search&category=@Model.Category&minPrice=@Model.MinPrice&maxPrice=@Model.MaxPrice&petPage=@(Model.PetPage-1)#pets">‹</a>
                        </li>
                        @for (int pg = Math.Max(1, Model.PetPage-2); pg <= Math.Min(Model.PetPages, Model.PetPage+2); pg++)
                        {
                            <li class="page-item @(pg == Model.PetPage ? "active" : "")">
                                <a class="page-link" href="?search=@Model.Search&category=@Model.Category&minPrice=@Model.MinPrice&maxPrice=@Model.MaxPrice&petPage=@pg#pets">@pg</a>
                            </li>
                        }
                        <li class="page-item @(Model.PetPage >= Model.PetPages ? "disabled" : "")">
                            <a class="page-link" href="?search=@Model.Search&category=@Model.Category&minPrice=@Model.MinPrice&maxPrice=@Model.MaxPrice&petPage=@(Model.PetPage+1)#pets">›</a>
                        </li>
                    </ul>
                </nav>
            }
        }
    </section>

    <!-- ═══ SECTION 2: DỊCH VỤ SPA & KHÁCH SẠN THÚ CƯNG (PET SPA & HOTEL PETNOW) ═══ -->
    <section id="spa-services" class="ps-section mb-5 py-4 px-3 px-md-4 rounded-4" style="background: linear-gradient(135deg, #f0fdf4 0%, #e0f2fe 100%); border: 1px solid #bbf7d0;">
        <div class="ps-section__heading mb-4">
            <div>
                <span class="ps-kicker text-success fw-bold"><i class="bi bi-stars me-1"></i>Dịch Vụ Chuẩn 5 Sao</span>
                <h2>🛁 Bảng Giá Spa Cắt Tỉa & Khách Sạn Thú Cưng</h2>
            </div>
            <a href="tel:19001234" class="btn btn-outline-success btn-sm fw-bold">
                <i class="bi bi-telephone-fill me-1"></i>Đặt lịch ngay: 1900 1234
            </a>
        </div>

        <div class="row g-4">
            <!-- Package 1: Tắm Sấy Spa -->
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-header bg-success text-white text-center py-3">
                        <div class="fs-1 mb-1">🧼</div>
                        <h5 class="fw-bold mb-0">Gói Tắm Sấy Thảo Dược</h5>
                        <small class="opacity-75">Chăm sóc & Vệ sinh toàn diện</small>
                    </div>
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="text-center mb-3">
                            <span class="fs-3 fw-bold text-success">150.000đ</span>
                            <span class="text-muted small">/ lần</span>
                        </div>
                        <ul class="list-unstyled small text-secondary mb-4 flex-grow-1">
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Tắm sữa tắm thảo dược Bio-Groom khử mùi</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Vắt tuyến hôi triệt để chống hôi</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Vệ sinh tai, nhổ lông tai khử ve rận</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Cắt dũa móng chống cào trầy xước</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Sấy phồng, chải tơi lông & xịt nước hoa dưỡng</li>
                        </ul>
                        <button class="btn btn-outline-success w-100 fw-bold" onclick="alert('Vui lòng gọi hotline 1900 1234 hoặc nhắn Zalo để xếp lịch làm đẹp cho bé!')">
                            Đặt Lịch Tắm Sấy
                        </button>
                    </div>
                </div>
            </div>

            <!-- Package 2: Cắt Tỉa Nghệ Thuật (VIP) -->
            <div class="col-md-4">
                <div class="card h-100 border-2 border-primary shadow rounded-4 overflow-hidden position-relative">
                    <div class="position-absolute top-0 end-0 bg-danger text-white px-3 py-1 rounded-bottom-start small fw-bold">
                        ĐƯỢC YÊU THÍCH NHẤT
                    </div>
