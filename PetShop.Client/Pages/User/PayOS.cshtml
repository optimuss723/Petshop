@page
@model PetShop.Client.Pages.User.PayOSModel
@{
    ViewData["Title"] = "PayOS";
}

<style>
    .payos-shell { max-width: 1040px; margin: 0 auto; }
    .payos-panel { border: 1px solid #dbe3ef; border-radius: 8px; background: #fff; }
    .payos-qr {
        width: 220px;
        height: 220px;
        margin: 0 auto;
        border: 8px solid #111827;
        background:
            linear-gradient(90deg, #111827 10px, transparent 10px) 0 0 / 22px 22px,
            linear-gradient(#111827 10px, transparent 10px) 0 0 / 22px 22px,
            #fff;
        position: relative;
    }
    .payos-qr::before,
    .payos-qr::after {
        content: "";
        position: absolute;
        width: 54px;
        height: 54px;
        background: #fff;
        border: 14px solid #111827;
    }
    .payos-qr::before { top: 14px; left: 14px; }
    .payos-qr::after { right: 14px; bottom: 14px; }
    .payos-code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        letter-spacing: .04em;
    }
</style>

<div class="payos-shell">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="mb-1 fw-semibold">Thanh toan PayOS</h4>
            <div class="text-muted small">He thong se chuyen ban sang trang checkout PayOS de thanh toan that.</div>
        </div>
        <a class="btn btn-outline-secondary btn-sm" href="@(Model.OrderId.HasValue ? "/User/Orders" : "/Cart")">
            @(Model.OrderId.HasValue ? "Quay lai don hang" : "Quay lai gio hang")
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="payos-panel p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <div class="text-muted small">So tien can thanh toan</div>
                        <div class="display-6 fw-bold text-primary">@Model.TotalAmount.ToString("N0") d</div>
                    </div>
                    <span class="badge text-bg-primary">PayOS</span>
                </div>

                <div class="alert alert-info border-0 mt-3 mb-0">
                    Neu khong duoc chuyen trang, hay thu tao lai link thanh toan. Don hang chi duoc xac nhan khi PayOS gui webhook hop le.
                </div>

                @if (Model.OrderId.HasValue)
                {
                    <a class="btn btn-primary btn-lg w-100 mt-4" href="/User/PayOS?orderId=@Model.OrderId.Value">
                        Tao lai link PayOS
                    </a>
                }
            </div>
        </div>

        <div class="col-lg-5">
            <div class="payos-panel">
                <div class="p-3 border-bottom fw-semibold">Tom tat don hang</div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@item.Name</div>
                                    <div class="small text-muted">@item.Type x @item.Qty</div>
                                </td>
                                <td class="text-end">@((item.Price * item.Qty).ToString("N0")) d</td>
                            </tr>
                        }
                        </tbody>
                        <tfoot class="table-light">
                        <tr>
                            <td class="fw-bold">Tong cong</td>
                            <td class="text-end fw-bold text-primary">@Model.TotalAmount.ToString("N0") d</td>
                        </tr>
                        </tfoot>
                    </table>
                </div>
                <div class="p-3 border-top">
                    <div class="small text-muted mb-1">Dia chi giao hang</div>
                    <div>@Model.ShippingAddress</div>
                    @if (!string.IsNullOrWhiteSpace(Model.Note))
                    {
                        <div class="small text-muted mt-3 mb-1">Ghi chu</div>
                        <div>@Model.Note</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
