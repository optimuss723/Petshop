@page
@model PetShop.Client.Pages.User.PayOSModel
@{
    ViewData["Title"] = "Cổng thanh toán PayOS";
}

<div class="container py-4" style="max-width: 960px;">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <span class="ps-kicker">Cổng thanh toán điện tử</span>
            <h3 class="fw-bold mb-0">Thanh toán trực tuyến PayOS</h3>
            <p class="text-muted small mb-0">Hệ thống sẽ chuyển bạn sang cổng thanh toán quét mã QR của PayOS.</p>
        </div>
        <a class="btn btn-outline-secondary btn-sm" href="@(Model.OrderId.HasValue ? "/User/Orders" : "/Cart")">
            <i class="bi bi-arrow-left me-1"></i>@(Model.OrderId.HasValue ? "Quay lại đơn hàng" : "Quay lại giỏ hàng")
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4 shadow-sm">
            <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
            <div>@Model.ErrorMessage</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4 mb-5">
        <div class="col-lg-7">
            <div class="card shadow-sm h-100 p-4">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Số tiền thanh toán</div>
                        <div class="display-6 fw-bold text-primary mt-1">@Model.TotalAmount.ToString("N0")đ</div>
                    </div>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fw-semibold">
                        <i class="bi bi-qr-code-scan me-1"></i>PayOS Checkout
                    </span>
                </div>

                <div class="alert alert-info border-0 d-flex align-items-start gap-2 mb-4">
                    <i class="bi bi-info-circle-fill text-primary fs-5 mt-0.5"></i>
                    <div class="small">
                        Nếu trình duyệt không tự động chuyển trang, vui lòng nhấn nút <strong>"Tạo lại link PayOS"</strong> bên dưới. Đơn hàng sẽ tự động xác nhận ngay khi bạn hoàn tất quét mã.
                    </div>
                </div>

                @if (Model.OrderId.HasValue)
                {
                    <a class="btn btn-primary btn-lg w-100 mt-auto py-3 fw-bold" href="/User/PayOS?orderId=@Model.OrderId.Value">
                        <i class="bi bi-box-arrow-up-right me-2"></i>Tiếp tục sang cổng PayOS
                    </a>
                }
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-receipt text-primary me-2"></i>Tóm tắt đơn hàng</h6>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-3 py-2.5">
                                    <div class="fw-semibold text-dark">@item.Name</div>
                                    <div class="small text-muted">@item.Type x @item.Qty</div>
                                </td>
                                <td class="text-end pe-3 py-2.5 fw-semibold text-dark">@((item.Price * item.Qty).ToString("N0"))đ</td>
                            </tr>
                        }
                        </tbody>
                        <tfoot class="table-light">
                        <tr>
                            <td class="ps-3 fw-bold">Tổng thanh toán</td>
                            <td class="text-end pe-3 fw-bold text-success fs-5">@Model.TotalAmount.ToString("N0")đ</td>
                        </tr>
                        </tfoot>
                    </table>
                </div>
                <div class="p-3 border-top bg-light">
                    <div class="small text-muted fw-semibold mb-1"><i class="bi bi-geo-alt me-1"></i>Địa chỉ nhận hàng</div>
                    <div class="small text-dark">@Model.ShippingAddress</div>
                    @if (!string.IsNullOrWhiteSpace(Model.Note))
                    {
                        <div class="small text-muted fw-semibold mt-2 mb-1"><i class="bi bi-chat-left-dots me-1"></i>Ghi chú</div>
                        <div class="small text-muted">@Model.Note</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
