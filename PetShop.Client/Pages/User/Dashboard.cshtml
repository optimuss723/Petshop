@page
@model PetShop.Client.Pages.User.DashboardModel
@{ ViewData["Title"] = "Tổng quan tài khoản"; }

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <span class="ps-kicker">Khu vực khách hàng</span>
        <h3 class="fw-bold mb-0">Xin chào, @Model.FullName 👋</h3>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span id="signalr-badge" class="badge bg-secondary-subtle text-secondary border px-3 py-1.5 fw-semibold">
            <span class="spinner-grow spinner-grow-sm me-1" role="status"></span>Đang kết nối...
        </span>
        <a href="/User/Profile" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-person-gear me-1"></i>Hồ sơ
        </a>
    </div>
</div>

@* Thông báo đặt hàng thành công *@
@if (!string.IsNullOrEmpty(Model.OrderSuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-3 mb-4 p-3 shadow-sm" role="alert">
        <div class="ps-brand-mark bg-success text-white flex-shrink-0" style="width:2.5rem;height:2.5rem;">
            <i class="bi bi-check-lg fs-5"></i>
        </div>
        <div>
            <div class="fw-bold fs-6">@Model.OrderSuccessMessage</div>
            <div class="small text-muted">Chúng tôi đã ghi nhận đơn hàng và đang chuẩn bị giao đến địa chỉ của bạn.</div>
        </div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}

<div id="order-status-alerts"></div>

<!-- Thống kê nhanh Metric Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="ps-account-stat">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="small text-muted fw-semibold">Đang chờ xử lý</span>
                <span class="badge bg-warning-subtle text-warning-emphasis"><i class="bi bi-hourglass-split"></i></span>
            </div>
            <div class="ps-account-stat__number text-warning">@Model.PendingCount</div>
            <div class="small text-muted mt-1">Đơn cần xác nhận</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="ps-account-stat">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="small text-muted fw-semibold">Đang vận chuyển</span>
                <span class="badge bg-primary-subtle text-primary"><i class="bi bi-truck"></i></span>
            </div>
            <div class="ps-account-stat__number text-primary">@Model.ShippingCount</div>
            <div class="small text-muted mt-1">Đơn trên đường giao</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="ps-account-stat">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="small text-muted fw-semibold">Đã giao thành công</span>
                <span class="badge bg-success-subtle text-success"><i class="bi bi-check-circle"></i></span>
            </div>
            <div class="ps-account-stat__number text-success">@Model.DeliveredCount</div>
            <div class="small text-muted mt-1">Đơn đã nhận an toàn</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="ps-account-stat">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="small text-muted fw-semibold">Tổng tích lũy</span>
                <span class="badge bg-info-subtle text-info-emphasis"><i class="bi bi-wallet2"></i></span>
            </div>
            <div class="ps-account-stat__number text-dark" style="font-size:1.35rem">@Model.TotalSpent.ToString("N0")đ</div>
            <div class="small text-muted mt-1">Chi tiêu đơn đã nhận</div>
        </div>
    </div>
</div>

<div class="row g-4 mb-5">
    <!-- Cập nhật profile ngắn gọn -->
    <div class="col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-person-lines-fill text-primary me-2"></i>Sổ địa chỉ nhanh</h6>
            </div>
            <div class="card-body p-3 p-xl-4">
                @if (!string.IsNullOrEmpty(Model.ProfileMessage))
                {
                    <div class="alert alert-success py-2 small mb-3">
                        <i class="bi bi-check-circle-fill me-1"></i>@Model.ProfileMessage
                    </div>
                }
                <form method="post" asp-page-handler="UpdateProfile">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted text-uppercase">Họ tên người nhận</label>
                        <input asp-for="ProfileInput.FullName" class="form-control form-control-sm" placeholder="Họ và tên"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted text-uppercase">Số điện thoại liên hệ</label>
                        <input asp-for="ProfileInput.Phone" class="form-control form-control-sm" placeholder="0987654321"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted text-uppercase">Địa chỉ giao hàng</label>
                        <textarea asp-for="ProfileInput.Address" class="form-control form-control-sm" rows="3" placeholder="Số nhà, tên đường, phường, quận..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm w-100">
                        <i class="bi bi-floppy me-1"></i>Lưu thông tin
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Đơn hàng gần đây (Giao diện chuẩn Shopee) -->
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="d-flex align-items-center gap-2">
                <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-clock-history text-success me-2"></i>Đơn hàng gần đây</h5>
                <span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold">@Model.Orders.Count đơn</span>
            </div>
            <a href="/User/Orders" class="btn btn-outline-primary btn-sm px-3 fw-semibold">
                Xem toàn bộ đơn <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>

        @if (!Model.Orders.Any())
        {
            <div class="card ps-empty text-center py-5 shadow-sm">
                <div class="ps-empty__icon mb-3"><i class="bi bi-bag-x fs-1 text-muted opacity-50"></i></div>
                <h5 class="fw-bold mb-1">Bạn chưa có đơn hàng nào</h5>
                <p class="text-muted small mb-3">Hãy khám phá các sản phẩm và thú cưng đáng yêu tại PetShop ngay!</p>
                <div>
                    <a href="/" class="btn btn-primary btn-sm px-4">
                        <i class="bi bi-cart-plus me-1"></i>Bắt đầu mua sắm ngay
                    </a>
                </div>
            </div>
        }
        else
        {
            @foreach (var o in Model.Orders.Take(5))
            {
                <div class="ps-shopee-card shadow-sm mb-3">
                    <!-- 1. Header: Store Badge & Status -->
                    <div class="ps-shopee-card__header">
                        <div class="d-flex align-items-center flex-wrap gap-2">
                            <span class="ps-shopee-card__shop-badge">YÊU THÍCH+</span>
                            <span class="fw-bold text-dark"><i class="bi bi-shop text-success me-1"></i>PetShop Official Store</span>
                            <a href="/User/Orders/Detail/@o.Id" class="badge bg-light text-dark border text-decoration-none font-monospace">#@o.Id</a>
                            <span class="text-muted small"><i class="bi bi-calendar3 me-1"></i>@o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            @switch (o.Status)
                            {
                                case "Delivered":
                                    <span class="text-success small fw-bold"><i class="bi bi-check2-all me-1"></i>Giao hàng thành công</span>
                                    <span class="badge bg-success text-white px-2.5 py-1.5">HOÀN THÀNH</span>
                                    break;
                                case "Shipping":
                                    <span class="text-primary small fw-bold"><i class="bi bi-truck me-1"></i>Đang giao hàng</span>
                                    <span class="badge bg-primary text-white px-2.5 py-1.5">ĐANG VẬN CHUYỂN</span>
                                    break;
                                case "AwaitingReceipt":
                                    <span class="text-warning-emphasis small fw-bold"><i class="bi bi-box-seam me-1"></i>Chờ bạn nhận</span>
                                    <span class="badge bg-warning text-dark px-2.5 py-1.5">CHỜ NHẬN HÀNG</span>
                                    break;
                                case "Confirmed":
                                    <span class="text-info-emphasis small fw-bold"><i class="bi bi-box2 me-1"></i>Shop đang chuẩn bị hàng</span>
                                    <span class="badge bg-info text-white px-2.5 py-1.5">ĐÃ XÁC NHẬN</span>
                                    break;
                                case "Pending":
                                    <span class="text-warning-emphasis small fw-bold"><i class="bi bi-hourglass-split me-1"></i>@(o.IsCod ? "Chờ shop xác nhận" : "Chờ PayOS")</span>
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2.5 py-1.5">CHỜ XỬ LÝ</span>
                                    break;
                                case "Cancelled":
                                    <span class="text-secondary small fw-bold"><i class="bi bi-x-circle me-1"></i>Đã hủy</span>
                                    <span class="badge bg-secondary text-white px-2.5 py-1.5">ĐÃ HỦY</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary text-white">@o.Status</span>
                                    break;
                            }
                        </div>
                    </div>

                    <!-- 2. Danh sách mặt hàng (Product Rows) -->
                    <div class="ps-shopee-card__body">
                        @if (o.Items != null && o.Items.Count > 0)
                        {
                            foreach (var item in o.Items)
                            {
                                var imgUrl = Model.GetItemImageUrl(item);
                                var category = Model.GetItemCategory(item);
                                var itemName = !string.IsNullOrWhiteSpace(item.ProductName) 
                                    ? item.ProductName 
                                    : (!string.IsNullOrWhiteSpace(item.PetName) ? item.PetName : (item.ProductId.HasValue ? $"Sản phẩm #{item.ProductId}" : $"Thú cưng #{item.PetId}"));
                                var detailLink = item.ProductId.HasValue 
                                    ? $"/Products/Detail/{item.ProductId}" 
                                    : (item.PetId.HasValue ? $"/Pets/Detail/{item.PetId}" : $"/User/Orders/Detail/{o.Id}");

                                <a href="@detailLink" class="ps-shopee-card__item">
                                    <img src="@imgUrl" alt="@itemName" class="ps-shopee-card__thumb" onerror="this.src='https://images.unsplash.com/photo-1543466835-00a7907e9de1?auto=format&fit=crop&w=150&q=80'" />
                                    <div class="ps-shopee-card__item-info">
                                        <div class="ps-shopee-card__item-title" title="@itemName">@itemName</div>
                                        <div class="ps-shopee-card__item-sub">
                                            <span>Phân loại: <strong class="text-dark">@category</strong></span>
                                            <span class="text-muted">|</span>
                                            <span>Số lượng: <strong class="text-dark">x@(item.Quantity)</strong></span>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle py-1 px-2" style="font-size:0.72rem"><i class="bi bi-shield-check me-1"></i>Đổi trả miễn phí 15 ngày</span>
                                        </div>
                                    </div>
                                    <div class="ps-shopee-card__item-price">
                                        <div class="text-muted small text-decoration-line-through">@((item.UnitPrice * 1.15m).ToString("N0"))đ</div>
                                        <div class="fw-bold" style="color: #008848; font-size: 1.05rem;">@item.UnitPrice.ToString("N0")đ</div>
                                    </div>
                                </a>
                            }
                        }
                        else
                        {
                            <div class="p-3 text-muted small fst-italic">Thông tin sản phẩm đang được cập nhật...</div>
                        }
                    </div>

                    <!-- 3. Thanh vận chuyển & Địa chỉ (Logistics Strip) -->
                    <div class="ps-shopee-card__shipping-strip">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span><i class="bi bi-truck text-success me-1"></i>Vận chuyển: <strong>@(!string.IsNullOrEmpty(o.ShippingProvider) ? o.ShippingProvider : "Giao Hàng Nhanh - GHN")</strong></span>
                            @if (!string.IsNullOrEmpty(o.TrackingCode))
                            {
                                <span class="badge bg-white text-dark border font-monospace">Mã vận đơn: @o.TrackingCode</span>
                            }
                            <span class="text-muted">|</span>
                            <span class="badge @(o.IsCod ? "bg-light text-muted border" : "bg-success-subtle text-success border border-success-subtle")">
                                <i class="bi @(o.IsCod ? "bi-cash-coin" : "bi-credit-card-2-front") me-1"></i>@(o.IsCod ? "COD (Thu tiền khi nhận)" : "PayOS Đã thanh toán")
                            </span>
                        </div>
                        <div class="text-truncate text-muted" style="max-width: 340px;" title="@o.ShippingAddress">
                            <i class="bi bi-geo-alt-fill text-danger me-1"></i>@o.ShippingAddress
                        </div>
                    </div>

                    <!-- 4. Footer: Thành tiền & Phím thao tác Shopee -->
                    <div class="ps-shopee-card__footer">
                        <div class="ps-shopee-card__total">
                            <span>Thành tiền (@(o.Items?.Sum(i => i.Quantity) ?? 1) sản phẩm):</span>
                            <span class="ps-shopee-card__total-amount">@o.TotalAmount.ToString("N0")đ</span>
                        </div>
                        <div class="ps-shopee-card__actions">
                            <a href="/User/Orders/Detail/@o.Id" class="btn btn-outline-secondary btn-sm px-3 fw-semibold">
                                <i class="bi bi-eye me-1"></i>Xem chi tiết
                            </a>

                            @if (o.Status == "Delivered")
                            {
                                var jsonItems = JsonSerializer.Serialize(o.Items ?? []);
                                <button type="button" class="btn ps-btn-reorder btn-sm px-3" onclick='reorderOrder(@Html.Raw(jsonItems))'>
                                    <i class="bi bi-arrow-repeat me-1"></i>Mua lại
                                </button>
                                <a href="/User/Orders/Detail/@o.Id" class="btn btn-outline-warning btn-sm px-3 fw-semibold text-dark">
                                    <i class="bi bi-star-fill text-warning me-1"></i>Đánh giá
                                </a>
                            }
                            else if (o.Status == "AwaitingReceipt")
                            {
                                <form method="post" asp-page-handler="ConfirmReceived" style="display:inline"
                                      onsubmit="return confirm('Bạn xác nhận đã nhận được đơn hàng #@o.Id?')">
                                    <input type="hidden" name="id" value="@o.Id"/>
                                    <button type="submit" class="btn btn-success btn-sm px-3 fw-semibold">
                                        <i class="bi bi-box2-heart me-1"></i>Đã nhận được hàng
                                    </button>
                                </form>
                            }
                            else if (o.Status == "Shipping")
                            {
                                <a href="/User/Orders/Detail/@o.Id" class="btn btn-outline-primary btn-sm px-3 fw-semibold">
                                    <i class="bi bi-truck me-1"></i>Theo dõi đơn
                                </a>
                            }
                            else if (o.Status == "Pending")
                            {
                                @if (!o.IsCod)
                                {
                                    <a asp-page="/User/PayOS" asp-route-orderId="@o.Id" class="btn btn-success btn-sm px-3 fw-semibold">
                                        <i class="bi bi-qr-code me-1"></i>Thanh toán PayOS
                                    </a>
                                }
                                <form method="post" asp-page-handler="Cancel" style="display:inline"
                                      onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng #@o.Id?')">
                                    <input type="hidden" name="id" value="@o.Id"/>
                                    <button type="submit" class="btn btn-outline-danger btn-sm px-3 fw-semibold">
                                        <i class="bi bi-x-circle me-1"></i>Hủy đơn
                                    </button>
                                </form>
                            }
                            else if (o.Status == "Cancelled")
                            {
                                var jsonItems = JsonSerializer.Serialize(o.Items ?? []);
                                <button type="button" class="btn ps-btn-reorder btn-sm px-3" onclick='reorderOrder(@Html.Raw(jsonItems))'>
                                    <i class="bi bi-arrow-repeat me-1"></i>Mua lại
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
<script>
@if (Model.ShouldClearCart)
{
    <text>
    if (window.PetShopCart) window.PetShopCart.clear();
    else sessionStorage.removeItem('petshop_cart');
    if (typeof updateCartBadge === 'function') updateCartBadge();
    </text>
}

const token  = '@HttpContext.Session.GetString("AccessToken")';
const userId = '@HttpContext.Session.GetString("UserId")';
const hubUrl = '@(((IConfiguration)HttpContext.RequestServices.GetRequiredService(typeof(IConfiguration)))["ApiSettings:OrderHubUrl"] ?? "http://localhost:5003/hubs/orders")';
const conn   = new signalR.HubConnectionBuilder()
    .withUrl(hubUrl, { accessTokenFactory: () => token })
    .withAutomaticReconnect()
    .build();

conn.on("OrderStatusChanged", data => {
    const alerts = document.getElementById("order-status-alerts");
    const statusMap = {
        Confirmed: 'Đã xác nhận',
        Shipping: 'Đang giao',
        AwaitingReceipt: 'Chờ bạn xác nhận đã nhận',
        Delivered: 'Đã nhận hàng',
        Cancelled: 'Đã hủy'
    };
    const statusLabel = statusMap[data.newStatus ?? data.status] ?? (data.newStatus ?? data.status);
    if (alerts) {
        alerts.insertAdjacentHTML("afterbegin", `
            <div class="alert alert-info alert-dismissible fade show d-flex align-items-center gap-2 mb-3 shadow-sm">
                <i class="bi bi-bell-fill fs-5 text-primary"></i>
                <div>
                    <strong>Đơn hàng #${data.orderId ?? data.id}</strong> vừa cập nhật trạng thái: <strong>${statusLabel}</strong>
                </div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>`);
    }
    setTimeout(() => location.reload(), 1500);
});

conn.start()
    .then(async () => {
        const badge = document.getElementById("signalr-badge");
        if (badge) {
            badge.className   = "badge bg-success-subtle text-success border border-success-subtle px-3 py-1.5 fw-semibold";
            badge.innerHTML = '<i class="bi bi-broadcast me-1"></i>Đã kết nối realtime';
        }
        await conn.invoke("JoinUserGroup", userId);
    })
    .catch(() => {
        const badge = document.getElementById("signalr-badge");
        if (badge) {
            badge.className   = "badge bg-secondary-subtle text-secondary border px-3 py-1.5 fw-semibold";
            badge.innerHTML = '<i class="bi bi-wifi-off me-1"></i>Ngoại tuyến';
        }
    });

function reorderOrder(items) {
    if (!items || !items.length) {
        if (typeof showToast === 'function') showToast('Không có sản phẩm nào để mua lại', 'warning');
        return;
    }
    let count = 0;
    items.forEach(it => {
        const type = it.ProductId ? 'product' : 'pet';
        const id = it.ProductId || it.PetId;
        const name = it.ProductName || it.PetName || 'Mặt hàng';
        const price = it.UnitPrice || 0;
        const qty = it.Quantity || 1;
        for (let i = 0; i < qty; i++) {
            if (typeof addPetShopCartItem === 'function') {
                addPetShopCartItem(type, id, name, price);
            }
        }
        count++;
    });
    if (typeof showToast === 'function') {
        showToast(`Đã thêm ${count} mặt hàng vào giỏ hàng!`, 'success');
    }
    setTimeout(() => {
        window.location.href = '/Cart';
    }, 600);
}
</script>
}
