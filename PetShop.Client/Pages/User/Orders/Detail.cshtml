@page "{id:int}"
@model PetShop.Client.Pages.User.Orders.DetailModel
@{
    ViewData["Title"] = $"Chi tiết đơn hàng #{Model.Order?.Id}";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div class="d-flex align-items-center gap-3">
        <a href="/User/Orders" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i>Danh sách đơn
        </a>
        <div>
            <h4 class="mb-0 fw-bold">Chi tiết đơn hàng #@Model.Order?.Id</h4>
            <small class="text-muted">Theo dõi thanh toán, hành trình vận chuyển và thông tin sản phẩm</small>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    var alertClass = Model.Message.StartsWith("✅") ? "alert-success" : "alert-danger";
    <div class="alert @alertClass alert-dismissible fade show d-flex align-items-center gap-2 mb-4 shadow-sm">
        <i class="bi @(Model.Message.StartsWith("✅") ? "bi-check-circle-fill text-success" : "bi-exclamation-octagon-fill text-danger") fs-5"></i>
        <div>@Model.Message</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Order == null)
{
    <div class="ps-empty card">
        <div class="ps-empty__icon"><i class="bi bi-search"></i></div>
        <h5 class="fw-bold mb-1">Không tìm thấy đơn hàng</h5>
        <p class="text-muted small mb-3">Đơn hàng không tồn tại hoặc bạn không có quyền truy cập.</p>
        <a href="/User/Orders" class="btn btn-primary btn-sm px-4">Quay lại danh sách</a>
    </div>
}
else
{
    var o = Model.Order;
    var statusLabel = o.Status switch {
        "Pending" when o.IsCod => "Chờ shop xác nhận (COD)",
        "Pending" => "Chờ thanh toán PayOS",
        "Confirmed" when o.IsCod => "Shop đã duyệt COD",
        "Confirmed" => "Đã thanh toán PayOS thành công",
        "Shipping" => "Đang giao hàng",
        "AwaitingReceipt" => "Chờ bạn xác nhận đã nhận",
        "Delivered" => "Giao hàng thành công",
        "Cancelled" => "Đã hủy",
        _ => o.Status
    };
    var statusBadge = o.Status switch {
        "Pending" => "bg-warning-subtle text-warning-emphasis",
        "Confirmed" => "bg-info-subtle text-info-emphasis",
        "Shipping" => "bg-primary-subtle text-primary",
        "AwaitingReceipt" => "bg-warning-subtle text-warning-emphasis",
        "Delivered" => "bg-success-subtle text-success",
        "Cancelled" => "bg-secondary-subtle text-secondary",
        _ => "bg-secondary-subtle text-secondary"
    };
    var paymentLabel = o.PaymentStatus switch {
        "Paid" => "PayOS đã thanh toán",
        "PayOSPending" => "PayOS đang chờ thanh toán",
        "CODCollected" => "Đã thu tiền COD",
        "Cancelled" => "Đã hủy giao dịch",
        _ => "Thu tiền mặt khi giao hàng (COD)"
    };
    var paymentBadge = o.PaymentStatus switch {
        "Paid" => "bg-success-subtle text-success",
        "PayOSPending" => "bg-warning-subtle text-warning-emphasis",
        "CODCollected" => "bg-success-subtle text-success",
        "Cancelled" => "bg-secondary-subtle text-secondary",
        _ => "bg-light text-muted border"
    };

    <div class="row g-4 mb-5">
        <!-- Order Meta Card -->
        <div class="col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-info-circle text-primary me-2"></i>Thông tin đơn & Giao nhận</h6>
                </div>
                <div class="card-body p-3 p-xl-4">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                        <span class="text-muted small">Mã đơn hàng:</span>
                        <span class="fw-bold fs-6">#@o.Id</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                        <span class="text-muted small">Trạng thái đơn:</span>
                        <span class="badge @statusBadge px-3 py-1.5 fw-semibold">@statusLabel</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                        <span class="text-muted small">Phương thức thanh toán:</span>
                        <span class="badge @paymentBadge px-3 py-1.5 fw-semibold">@paymentLabel</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                        <span class="text-muted small">Tổng tiền thanh toán:</span>
                        <span class="fw-bold text-success fs-5">@o.TotalAmount.ToString("N0")đ</span>
                    </div>

                    <div class="mb-3 pb-3 border-bottom">
                        <span class="text-muted small d-block mb-1">Địa chỉ nhận hàng:</span>
                        <div class="fw-semibold text-dark"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@o.ShippingAddress</div>
                    </div>

                    @if (!string.IsNullOrEmpty(o.Note))
                    {
                        <div class="mb-3 pb-3 border-bottom">
                            <span class="text-muted small d-block mb-1">Ghi chú của khách:</span>
                            <div class="small text-muted bg-light p-2 rounded">@o.Note</div>
                        </div>
                    }

                    <div class="d-flex justify-content-between small text-muted">
                        <span>Thời gian đặt:</span>
                        <span>@o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>

                    @if (!string.IsNullOrEmpty(o.TrackingCode))
                    {
                        <div class="mt-4 p-3 rounded" style="background:#eef8f3;border:1px solid #b7dfcf">
                            <div class="small text-muted fw-bold text-uppercase mb-1">
                                <i class="bi bi-truck text-success me-1"></i>Hành trình vận chuyển
                            </div>
                            <div class="fw-bold text-dark">Đơn vị: @o.ShippingProvider</div>
                            <div class="d-flex align-items-center gap-2 mt-1">
                                <span class="badge bg-primary font-monospace">@o.TrackingCode</span>
                                <button class="btn btn-xs btn-outline-secondary py-0 px-2 small"
                                        onclick="navigator.clipboard.writeText('@o.TrackingCode');showToast('Đã sao chép mã vận đơn','info')"
                                        title="Copy mã vận đơn">
                                    <i class="bi bi-copy"></i>
                                </button>
                            </div>
                            @if (!string.IsNullOrEmpty(o.TrackingUrl))
                            {
                                <a href="@o.TrackingUrl" target="_blank" class="btn btn-sm btn-primary mt-2 w-100">
                                    <i class="bi bi-box-arrow-up-right me-1"></i>Tra cứu vận đơn trực tiếp
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Order Items Card -->
        <div class="col-lg-7">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-bag-check text-primary me-2"></i>Sản phẩm trong đơn (@(o.Items?.Count ?? 0) mặt hàng)</h6>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Mặt hàng</th>
                                <th class="text-center" style="width:90px">SL</th>
                                <th class="text-end" style="width:130px">Đơn giá</th>
                                <th class="text-end pe-3" style="width:140px">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in o.Items ?? Enumerable.Empty<PetShop.Shared.DTOs.Response.OrderItemResponse>())
                        {
                            var itemName = item.ProductName ?? item.PetName;
                            var itemType = item.ProductId.HasValue ? "Sản phẩm" : "Thú cưng";
                            var itemCode = item.ProductId ?? item.PetId;
                            var emoji = item.ProductId.HasValue ? "🛍️" : "🐾";
                            <tr>
                                <td class="ps-3 py-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fs-4">@emoji</span>
                                        <div>
                                            <div class="fw-bold text-dark">@(string.IsNullOrWhiteSpace(itemName) ? $"{itemType} #{itemCode}" : itemName)</div>
                                            <div class="small text-muted">@itemType #@itemCode</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center py-3">
                                    <span class="badge bg-light text-dark border">@item.Quantity</span>
                                </td>
                                <td class="text-end py-3 text-muted">@item.UnitPrice.ToString("N0")đ</td>
                                <td class="text-end pe-3 py-3 fw-bold text-primary">@item.SubTotal.ToString("N0")đ</td>
                            </tr>
                        }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="3" class="text-end fw-bold py-3">Tổng cộng thanh toán:</td>
                                <td class="text-end pe-3 fw-bold text-success fs-5 py-3">@o.TotalAmount.ToString("N0")đ</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- Action buttons -->
            <div class="d-flex flex-wrap justify-content-end gap-2">
                @if (o.Status == "Pending")
                {
                    <a asp-page="/User/PayOS" asp-route-orderId="@o.Id" class="btn btn-primary">
                        <i class="bi bi-qr-code me-1"></i>@(o.IsCod ? "Chuyển sang thanh toán PayOS" : "Tiếp tục thanh toán PayOS")
                    </a>
                    <form method="post" asp-page-handler="Cancel"
                          onsubmit="return confirm('Bạn có chắc muốn hủy đơn hàng #@o.Id?')">
                        <input type="hidden" name="id" value="@o.Id"/>
                        <button type="submit" class="btn btn-outline-danger">
                            <i class="bi bi-x-circle me-1"></i>Hủy đơn hàng
                        </button>
                    </form>
                }
                @if (o.Status == "AwaitingReceipt")
                {
                    <form method="post" asp-page-handler="ConfirmReceived"
                          onsubmit="return confirm('Bạn xác nhận đã nhận được đơn hàng #@o.Id?')">
                        <input type="hidden" name="id" value="@o.Id"/>
                        <button type="submit" class="btn btn-success px-4">
                            <i class="bi bi-box2-heart me-1"></i>Tôi đã nhận được hàng
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
}
