@page "/Products/Detail/{id:int}"
@model PetShop.Client.Pages.Products.DetailModel
@{
    ViewData["Title"] = Model.Product?.Name ?? "Chi tiết sản phẩm";
    string JsName(string name) => Html.Raw((name ?? "").Replace("\\", "\\\\").Replace("'", "\\'")).ToString()!;
}

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-octagon-fill fs-5"></i>
        <div>@Model.ErrorMessage <a href="/" class="alert-link ms-2">Trở về trang chủ</a></div>
    </div>
}
else if (Model.Product != null)
{
    var p = Model.Product;
    var isAuth = !string.IsNullOrEmpty(HttpContext.Session.GetString("AccessToken"));
    var emoji = p.Category switch { "Food"=>"🍖","Accessory"=>"🎀","Medicine"=>"💊","Toy"=>"🎾","Grooming"=>"✂️",_=>"📦" };
    var categoryLabel = p.Category switch {
        "Food" => "Thức ăn dinh dưỡng",
        "Accessory" => "Phụ kiện thú cưng",
        "Medicine" => "Y tế & Thuốc bổ",
        "Toy" => "Đồ chơi huấn luyện",
        "Grooming" => "Spa & Chăm sóc lông",
        _ => p.Category
    };

    <nav aria-label="breadcrumb" class="ps-breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="/#products">Sản phẩm</a></li>
            <li class="breadcrumb-item active" aria-current="page">@p.Name</li>
        </ol>
    </nav>

    <div class="row g-4 mb-5">
        <!-- Media Gallery -->
        <div class="col-lg-5">
            <div class="ps-product-gallery shadow-sm position-relative">
                @if (!string.IsNullOrEmpty(p.ImageUrl))
                {
                    <img src="@p.ImageUrl" alt="@p.Name" class="img-fluid"/>
                }
                else
                {
                    <div class="ps-product-gallery__fallback">@emoji</div>
                }
                <div class="position-absolute top-0 start-0 m-3">
                    <span class="badge bg-primary shadow-sm px-3 py-2 fs-7 fw-bold">
                        <i class="bi bi-shield-check me-1"></i>Chính Hãng 100%
                    </span>
                </div>
            </div>

            <!-- Guarantee Info Bar -->
            <div class="card mt-3 border-0 bg-light-subtle shadow-sm">
                <div class="card-body p-3">
                    <div class="row g-2 text-center small text-muted">
                        <div class="col-4 border-end">
                            <i class="bi bi-arrow-repeat d-block text-primary fs-5 mb-1"></i>
                            <span>Đổi trả 7 ngày</span>
                        </div>
                        <div class="col-4 border-end">
                            <i class="bi bi-truck d-block text-success fs-5 mb-1"></i>
                            <span>Giao hỏa tốc 2h</span>
                        </div>
                        <div class="col-4">
                            <i class="bi bi-patch-check d-block text-warning fs-5 mb-1"></i>
                            <span>Date xa an tâm</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Product Purchase Panel -->
        <div class="col-lg-7">
            <div class="ps-detail-panel">
                <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                    <span class="badge bg-primary-subtle text-primary fw-semibold px-3 py-1.5 fs-7">
                        <i class="bi bi-tag-fill me-1"></i>@categoryLabel
                    </span>
                    @if (p.Stock > 0)
                    {
                        <span class="badge bg-success-subtle text-success fw-semibold px-3 py-1.5 fs-7">
                            <i class="bi bi-check-circle-fill me-1"></i>Còn hàng trong kho (@p.Stock sản phẩm)
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger-subtle text-danger fw-semibold px-3 py-1.5 fs-7">
                            <i class="bi bi-x-circle-fill me-1"></i>Tạm hết hàng
                        </span>
                    }
                </div>

                <h1 class="mb-2 fs-2 fw-bold text-dark">@p.Name</h1>

                @if (Model.Reviews.Count > 0)
                {
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="text-warning fs-6">
                            @for (int i = 1; i <= 5; i++) { @(i <= (int)Math.Round(Model.AverageRating) ? "⭐" : "☆") }
                        </div>
                        <span class="text-muted small fw-semibold">
                            @Model.AverageRating.ToString("F1") / 5.0 (@Model.Reviews.Count lượt đánh giá từ khách mua)
                        </span>
                    </div>
                }

                <div class="ps-detail-price mb-4">
                    @p.Price.ToString("N0")<span class="fs-4 fw-normal text-muted ms-1">đ</span>
                </div>

                <div class="mb-4">
                    <h6 class="small text-muted fw-bold text-uppercase mb-2">Mô tả sản phẩm</h6>
                    <p class="ps-detail-copy">@p.Description</p>
                </div>

                <!-- Product Trust Box (PetNow Standard) -->
                <div class="card bg-light border-0 mb-4" style="border-radius:12px;">
                    <div class="card-body p-3">
                        <div class="row g-3 small">
                            <div class="col-sm-6">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="bg-success text-white rounded-circle p-2 d-inline-flex">
                                        <i class="bi bi-truck fs-6"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold">Giao hàng miễn phí</div>
                                        <div class="text-muted">Đơn từ 500k toàn quốc</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="bg-primary text-white rounded-circle p-2 d-inline-flex">
                                        <i class="bi bi-shield-check fs-6"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold">Cam kết chính hãng</div>
                                        <div class="text-muted">Đền gấp đôi nếu giả mạo</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quantity and Add to Cart -->
                <div class="row g-3 align-items-center mb-3">
                    <div class="col-auto">
                        <label class="form-label small fw-bold text-muted text-uppercase mb-1">Số lượng:</label>
                        <div class="input-group" style="width: 140px;">
                            <button class="btn btn-outline-secondary" type="button" onclick="changeQty(-1)">-</button>
                            <input type="number" id="buyQty" class="form-control text-center fw-bold" value="1" min="1" max="@(p.Stock > 0 ? p.Stock : 1)"/>
                            <button class="btn btn-outline-secondary" type="button" onclick="changeQty(1)">+</button>
                        </div>
                    </div>
                    <div class="col">
                        <label class="form-label small fw-bold text-muted text-uppercase mb-1 d-none d-sm-block">&nbsp;</label>
                        <button class="btn btn-primary btn-lg w-100 fw-bold"
                                onclick="addProductToCart(@p.Id, '@JsName(p.Name)', @p.Price)"
                                @(p.Stock == 0 ? "disabled" : "")>
                            <i class="bi bi-cart-plus-fill me-1"></i> THÊM VÀO GIỎ HÀNG
                        </button>
                    </div>
                    <div class="col-auto">
                        <label class="form-label small fw-bold text-muted text-uppercase mb-1 d-none d-sm-block">&nbsp;</label>
                        <button class="btn btn-outline-danger btn-lg px-3" id="wishBtn"
                                onclick="toggleWishlist(@p.Id, '@JsName(p.Name)', '@p.Category', @p.Price)"
                                title="Lưu vào danh sách yêu thích">
                            <i class="bi bi-heart" id="wishIcon"></i>
                        </button>
                    </div>
                </div>

                <!-- Quick Consultation CTA -->
                <div class="d-flex gap-2 pt-2">
                    <a href="tel:19001234" class="btn btn-outline-secondary btn-sm flex-grow-1">
                        <i class="bi bi-telephone me-1"></i>Tư vấn nhanh: 1900 1234
                    </a>
                    <a href="https://zalo.me" target="_blank" class="btn btn-outline-success btn-sm flex-grow-1">
                        <i class="bi bi-chat-dots me-1"></i>Chat Zalo hỗ trợ
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Reviews Section -->
    <div class="card ps-review-card shadow-sm mb-5">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0 fw-bold">
                <i class="bi bi-chat-heart text-danger me-2"></i>Đánh giá từ khách mua hàng (@Model.Reviews.Count)
            </h5>
            @if (isAuth)
            {
                <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#reviewModal">
                    <i class="bi bi-pencil-square me-1"></i>Viết đánh giá
                </button>
            }
            else
            {
                <a href="/Auth/Login" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập để đánh giá
                </a>
            }
        </div>
        <div class="card-body p-4">
            @if (Model.Reviews.Count == 0)
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-stars fs-1 text-warning d-block mb-2"></i>
                    <p class="mb-0">Chưa có đánh giá nào cho sản phẩm này. Hãy mua và trở thành người đầu tiên đánh giá!</p>
                </div>
            }
            else
            {
                @foreach (var r in Model.Reviews)
                {
                    <div class="border-bottom pb-3 mb-3 last-border-0">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold"><i class="bi bi-person-circle text-muted me-1"></i>@r.UserName</span>
                            <span class="text-muted small">@r.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="text-warning small mb-2">@string.Concat(Enumerable.Range(1,5).Select(i => i <= r.Rating ? "⭐" : "☆"))</div>
                        <p class="mb-0 text-secondary">@r.Comment</p>
                    </div>
                }
            }
        </div>
    </div>
}

<!-- Review Modal -->
<div class="modal fade" id="reviewModal" tabindex="-1" aria-labelledby="reviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="reviewModalLabel">
                    <i class="bi bi-star-fill text-warning me-2"></i>Đánh giá sản phẩm
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label fw-semibold small text-muted text-uppercase">Số sao đánh giá</label>
                    <div class="d-flex gap-2 fs-2 user-select-none" id="starRating">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <span class="star-btn text-warning" data-val="@i" style="cursor:pointer" onclick="setRating(@i)">☆</span>
                        }
                    </div>
                    <input type="hidden" id="ratingVal" value="5"/>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small text-muted text-uppercase">Nội dung đánh giá</label>
                    <textarea id="reviewComment" class="form-control" rows="4" placeholder="Chất lượng sản phẩm, bao bì đóng gói, hạn sử dụng..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-light" data-bs-dismiss="modal">Hủy bỏ</button>
                <button class="btn btn-primary" onclick="submitReview()">
                    <i class="bi bi-send me-1"></i>Gửi đánh giá
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function changeQty(delta) {
    const el = document.getElementById('buyQty');
    let v = parseInt(el.value) || 1;
    v = Math.max(1, Math.min(parseInt(el.max) || 999, v + delta));
    el.value = v;
}

function addProductToCart(id, name, price) {
    const qty = parseInt(document.getElementById('buyQty').value) || 1;
    for (let i = 0; i < qty; i++) {
        if (window.PetShopCart) {
            window.PetShopCart.add('product', id, name, price);
        } else {
            addToCart('product', id, name, price);
        }
    }
    if (typeof showToast === 'function') {
        showToast(`✅ Đã thêm ${qty} x "${name}" vào giỏ hàng!`, 'success');
    }
}

function setRating(val) {
    document.getElementById('ratingVal').value = val;
    document.querySelectorAll('.star-btn').forEach((s, i) => s.textContent = i < val ? '⭐' : '☆');
}
setRating(5);

async function submitReview() {
    const comment = document.getElementById('reviewComment').value.trim();
    const rating  = parseInt(document.getElementById('ratingVal').value);
    if (!comment) { alert('Vui lòng nhập nội dung đánh giá.'); return; }

    const token = '@(HttpContext.Session.GetString("AccessToken") ?? "")';
    const apiBase = '@(Model.ApiBaseUrl)';
    const res = await fetch(`${apiBase}/api/reviews`, {
        method: 'POST',
        headers: { 'Content-Type':'application/json', 'Authorization':'Bearer '+token },
        body: JSON.stringify({ productId: @(Model.Product?.Id ?? 0), petId: null, rating, comment })
    });
    const data = await res.json();
    if (data.success) {
        bootstrap.Modal.getInstance(document.getElementById('reviewModal')).hide();
        location.reload();
    } else {
        alert(data.message || 'Gửi đánh giá thất bại');
    }
}

function getWishlist() { return JSON.parse(localStorage.getItem('petshop_wishlist') || '[]'); }
function saveWishlist(list) { localStorage.setItem('petshop_wishlist', JSON.stringify(list)); }

function toggleWishlist(id, name, category, price) {
    let list = getWishlist();
    const idx = list.findIndex(x => x.type === 'product' && x.id === id);
    if (idx >= 0) {
        list.splice(idx, 1);
        document.getElementById('wishIcon').className = 'bi bi-heart';
        if (typeof showToast === 'function') showToast('Đã bỏ yêu thích', 'info');
    } else {
        list.push({ type: 'product', id, name, category, price });
        document.getElementById('wishIcon').className = 'bi bi-heart-fill text-danger';
        if (typeof showToast === 'function') showToast('Đã thêm vào yêu thích ❤️', 'success');
    }
    saveWishlist(list);
}

const wl = getWishlist();
if (wl.find(x => x.type === 'product' && x.id === @(Model.Product?.Id ?? 0))) {
    const icon = document.getElementById('wishIcon');
    if (icon) icon.className = 'bi bi-heart-fill text-danger';
}

function addToCart(type, id, name, price) {
    if (window.PetShopCart) {
        window.PetShopCart.add(type, id, name, price);
        return;
    }
    const cart = JSON.parse(sessionStorage.getItem('petshop_cart') || '[]');
    const ex = cart.find(i => i.type === type && i.id === id);
    if (ex) ex.qty++;
    else cart.push({ type, id, name, price, qty: 1 });
    sessionStorage.setItem('petshop_cart', JSON.stringify(cart));
    if (typeof updateCartBadge === 'function') updateCartBadge();
    if (typeof showToast === 'function') showToast(`✅ Đã thêm "${name}" vào giỏ hàng!`, 'success');
}
</script>
}
