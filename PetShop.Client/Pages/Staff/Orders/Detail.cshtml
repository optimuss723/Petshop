@page "{id:int}"
@model PetShop.Client.Pages.Staff.Orders.DetailModel
@{
    ViewData["Title"] = $"Chi tiết đơn #{Model.Order?.Id}";
}

<div class="ps-backoffice-heading">
    <div>
        <span class="ps-kicker">Nghiệp vụ xử lý</span>
        <h1>Chi tiết đơn hàng #@Model.Order?.Id</h1>
        <p>Kiểm tra danh sách hàng, thông tin người nhận và tạo mã vận chuyển.</p>
    </div>
    <div>
        <a href="/Staff/Orders" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Danh sách đơn hàng
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    var alertClass = Model.Message.StartsWith("✅") ? "alert-success" : "alert-danger";
    <div class="alert @alertClass alert-dismissible fade show d-flex align-items-center gap-2 mb-4 shadow-sm">
        <i class="bi @(Model.Message.StartsWith("✅") ? "bi-check-circle-fill text-success" : "bi-exclamation-triangle-fill text-danger") fs-5"></i>
        <div>@Model.Message</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Order == null)
{
    <div class="ps-empty card">
        <div class="ps-empty__icon"><i class="bi bi-search"></i></div>
        <h5 class="fw-bold mb-1">Không tìm thấy đơn hàng</h5>
        <p class="text-muted small mb-3">Mã đơn hàng không tồn tại trong hệ thống.</p>
        <a href="/Staff/Orders" class="btn btn-primary btn-sm px-4">Quay lại danh sách</a>
    </div>
}
else
{
    var o = Model.Order;
    var waitingPayOs = !o.IsCod && o.Status == "Pending";
    var canUpdate = o.Status == "Pending" || o.Status == "Confirmed" || o.Status == "Shipping" || o.Status == "AwaitingReceipt";
    var statusLabel = o.Status switch {
        "Pending" when o.IsCod => "Chờ xử lý COD",
        "Pending" => "Chờ PayOS",
        "Confirmed" => "Đã xác nhận",
        "Shipping" => "Đang giao",
        "AwaitingReceipt" => "Chờ khách xác nhận",
        "Delivered" => "Hoàn tất",
        "Cancelled" => "Đã hủy",
        _ => o.Status
    };
    var statusBadge = o.Status switch {
        "Pending"         => "bg-warning-subtle text-warning-emphasis",
        "Confirmed"       => "bg-info-subtle text-info-emphasis",
        "Shipping"        => "bg-primary-subtle text-primary",
        "AwaitingReceipt" => "bg-warning-subtle text-warning-emphasis",
        "Delivered"       => "bg-success-subtle text-success",
        "Cancelled"       => "bg-secondary-subtle text-secondary",
        _                 => "bg-light text-dark"
    };

    <div class="row g-4 mb-5">
        <div class="col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-info-circle text-primary me-2"></i>Thông tin đơn & Người nhận</h6>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                        <span class="text-muted small">Mã đơn hàng:</span>
                        <span class="fw-bold fs-6">#@o.Id</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                        <span class="text-muted small">Khách hàng:</span>
                        <div>
                            <div class="fw-semibold text-dark text-end">@o.UserName</div>
                            @if (!string.IsNullOrEmpty(o.CustomerPhone))
                            {
                                <div class="small text-muted text-end"><i class="bi bi-telephone me-1"></i>@o.CustomerPhone</div>
                            }
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                        <span class="text-muted small">Trạng thái:</span>
                        <span class="badge @statusBadge px-3 py-1.5 fw-semibold">@statusLabel</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                        <span class="text-muted small">Tổng tiền thu:</span>
                        <span class="fw-bold text-success fs-5">@o.TotalAmount.ToString("N0")đ</span>
                    </div>

                    <div class="mb-3 pb-3 border-bottom">
                        <span class="text-muted small d-block mb-1">Địa chỉ giao hàng:</span>
                        <div class="fw-semibold text-dark"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@o.ShippingAddress</div>
                    </div>

                    @if (!string.IsNullOrEmpty(o.Note))
                    {
                        <div class="mb-3 pb-3 border-bottom">
                            <span class="text-muted small d-block mb-1">Ghi chú của khách:</span>
                            <div class="small text-muted bg-light p-2 rounded">@o.Note</div>
                        </div>
                    }

                    <div class="d-flex justify-content-between small text-muted">
                        <span>Thời gian tạo đơn:</span>
                        <span>@o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>

                    @if (!string.IsNullOrEmpty(o.TrackingCode))
                    {
                        <div class="mt-4 p-3 rounded" style="background:#eef8f3;border:1px solid #b7dfcf">
                            <div class="small text-muted fw-bold text-uppercase mb-1">
                                <i class="bi bi-truck text-success me-1"></i>Vận đơn chuyển phát
                            </div>
                            <div class="fw-bold text-dark">Đơn vị: @o.ShippingProvider</div>
                            <div class="d-flex align-items-center gap-2 mt-1">
                                <span class="badge bg-primary font-monospace">@o.TrackingCode</span>
                                <button class="btn btn-xs btn-outline-secondary py-0 px-2 small"
                                        onclick="navigator.clipboard.writeText('@o.TrackingCode');alert('Đã copy mã vận đơn!')"
                                        title="Copy mã vận đơn">
                                    <i class="bi bi-copy"></i>
                                </button>
                            </div>
                            @if (!string.IsNullOrEmpty(o.TrackingUrl))
                            {
                                <a href="@o.TrackingUrl" target="_blank" class="btn btn-sm btn-primary mt-2 w-100">
                                    <i class="bi bi-box-arrow-up-right me-1"></i>Mở tra cứu vận đơn
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <!-- Thao tác cập nhật -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-gear-fill text-primary me-2"></i>Thao tác nghiệp vụ</h6>
                </div>
                <div class="card-body p-4">
                    @if (o.Status == "Confirmed" && string.IsNullOrEmpty(o.TrackingCode))
                    {
                        <form method="post" asp-page-handler="CreateShipment" class="mb-3 p-3 rounded bg-light border"
                              onsubmit="return confirm('Tạo mã vận chuyển và bắt đầu giao đơn #@o.Id?')">
                            <input type="hidden" name="id" value="@o.Id" />
                            <div class="d-flex align-items-center justify-content-between gap-3">
                                <div>
                                    <div class="fw-bold text-dark">Tạo vận đơn giao hàng</div>
                                    <small class="text-muted">Tự động kết nối đối tác giao vận và chuyển đơn sang "Đang giao".</small>
                                </div>
                                <button type="submit" class="btn btn-primary px-3">
                                    <i class="bi bi-truck me-1"></i>Tạo vận đơn
                                </button>
                            </div>
                        </form>
                    }
                    @if (canUpdate)
                    {
                        <form method="post" asp-page-handler="UpdateStatus" class="d-flex flex-wrap gap-2 align-items-center">
                            <input type="hidden" name="id" value="@o.Id" />
                            <label class="form-label small fw-semibold text-muted text-uppercase mb-0 me-2">Chuyển trạng thái:</label>
                            <select name="status" class="form-select flex-grow-1" style="min-width:200px">
                                @if (o.Status == "Pending")
                                {
                                    <option value="Pending" selected>⏳ Chờ xử lý</option>
                                    @if (!waitingPayOs)
                                    {
                                        <option value="Confirmed">✅ Đã xác nhận COD</option>
                                    }
                                    <option value="Cancelled">❌ Đã hủy đơn</option>
                                }
                                else if (o.Status == "Confirmed")
                                {
                                    <option value="Confirmed" selected>✅ Đã xác nhận</option>
                                    <option value="Cancelled">❌ Đã hủy đơn</option>
                                }
                                else if (o.Status == "Shipping")
                                {
                                    <option value="Shipping" selected>🚚 Đang giao hàng</option>
                                    <option value="AwaitingReceipt">📬 Đã giao tới khách, chờ khách xác nhận</option>
                                }
                                else if (o.Status == "AwaitingReceipt")
                                {
                                    <option value="AwaitingReceipt" selected>📬 Chờ khách xác nhận</option>
                                    <option value="Shipping">🔄 Khách báo chưa nhận - quay lại đang giao</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-success px-4">
                                <i class="bi bi-check2 me-1"></i>Lưu
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="text-muted small"><i class="bi bi-info-circle me-1"></i>Đơn hàng ở trạng thái hoàn tất hoặc đã hủy, không còn thao tác thay đổi.</div>
                    }
                </div>
            </div>

            <!-- Mặt hàng trong đơn -->
            <div class="card shadow-sm">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-bag-check text-primary me-2"></i>Mặt hàng trong đơn (@(o.Items?.Count ?? 0) món)</h6>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Mặt hàng</th>
                                <th class="text-center" style="width:80px">SL</th>
                                <th class="text-end" style="width:130px">Đơn giá</th>
                                <th class="text-end pe-3" style="width:140px">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in o.Items ?? Enumerable.Empty<PetShop.Shared.DTOs.Response.OrderItemResponse>())
                        {
                            var itemName = item.ProductName ?? item.PetName;
                            var itemType = item.ProductId.HasValue ? "Sản phẩm" : "Thú cưng";
                            var itemCode = item.ProductId ?? item.PetId;
                            var emoji = item.ProductId.HasValue ? "🛍️" : "🐾";
                            <tr>
                                <td class="ps-3 py-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fs-4">@emoji</span>
                                        <div>
                                            <div class="fw-bold text-dark">@(string.IsNullOrWhiteSpace(itemName) ? $"{itemType} #{itemCode}" : itemName)</div>
                                            <div class="small text-muted">@itemType #@itemCode</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center py-3">
                                    <span class="badge bg-light text-dark border">@item.Quantity</span>
                                </td>
                                <td class="text-end py-3 text-muted">@item.UnitPrice.ToString("N0")đ</td>
                                <td class="text-end pe-3 py-3 fw-bold text-primary">@item.SubTotal.ToString("N0")đ</td>
                            </tr>
                        }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="3" class="text-end fw-bold py-3">Tổng cộng thanh toán:</td>
                                <td class="text-end pe-3 fw-bold text-success fs-5 py-3">@o.TotalAmount.ToString("N0")đ</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
}
