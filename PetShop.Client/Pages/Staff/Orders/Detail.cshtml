@page "{id:int}"
@model PetShop.Client.Pages.Staff.Orders.DetailModel
@{
    ViewData["Title"] = $"Chi tiết đơn #{Model.Order?.Id}";
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a href="/Staff/Orders" class="btn btn-outline-secondary btn-sm">← Quay lại</a>
    <h4 class="mb-0 fw-semibold">Chi tiết đơn hàng #@Model.Order?.Id</h4>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert @(Model.Message.StartsWith("✅") ? "alert-success" : "alert-danger") alert-dismissible fade show">
        @Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Order == null)
{
    <div class="alert alert-danger">Không tìm thấy đơn hàng.</div>
}
else
{
    var o = Model.Order;
    var waitingPayOs = !o.IsCod && o.Status == "Pending";
    var canUpdate = o.Status == "Pending" || o.Status == "Confirmed" || o.Status == "Shipping" || o.Status == "AwaitingReceipt";
    var statusLabel = o.Status switch {
        "Pending" when o.IsCod => "Chờ xử lý COD",
        "Pending" => "Chờ PayOS",
        "Confirmed" => "Đã xác nhận",
        "Shipping" => "Đang giao",
        "AwaitingReceipt" => "Chờ khách xác nhận",
        "Delivered" => "Hoàn tất",
        "Cancelled" => "Đã hủy",
        _ => o.Status
    };

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card h-100">
                <div class="card-header fw-semibold">Thông tin đơn</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-5 text-muted">Khách hàng</dt>
                        <dd class="col-7">@o.UserName<br/><small class="text-muted">@o.CustomerPhone</small></dd>
                        <dt class="col-5 text-muted">Địa chỉ</dt>
                        <dd class="col-7">@o.ShippingAddress</dd>
                        <dt class="col-5 text-muted">Tổng tiền</dt>
                        <dd class="col-7 fw-bold text-primary">@o.TotalAmount.ToString("N0")đ</dd>
                        <dt class="col-5 text-muted">Trạng thái</dt>
                        <dd class="col-7"><span class="badge bg-secondary">@statusLabel</span></dd>
                        <dt class="col-5 text-muted">Ngày đặt</dt>
                        <dd class="col-7">@o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
                    </dl>
                    @if (!string.IsNullOrEmpty(o.TrackingCode))
                    {
                        <hr/>
                        <div class="fw-semibold">Vận đơn</div>
                        <a href="@o.TrackingUrl" target="_blank" class="text-decoration-none">@o.TrackingCode</a>
                        <div class="text-muted small">@o.ShippingProvider</div>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="card mb-3">
                <div class="card-header fw-semibold">Cập nhật xử lý</div>
                <div class="card-body">
                    @if (o.Status == "Confirmed" && string.IsNullOrEmpty(o.TrackingCode))
                    {
                        <form method="post" asp-page-handler="CreateShipment" class="mb-3"
                              onsubmit="return confirm('Tạo vận đơn cho đơn #@o.Id?')">
                            <input type="hidden" name="id" value="@o.Id" />
                            <button type="submit" class="btn btn-primary">Tạo vận đơn</button>
                            <span class="text-muted small ms-2">Tạo vận đơn sẽ tự chuyển đơn sang Đang giao.</span>
                        </form>
                    }
                    @if (canUpdate)
                    {
                        <form method="post" asp-page-handler="UpdateStatus" class="d-flex gap-2">
                            <input type="hidden" name="id" value="@o.Id" />
                            <select name="status" class="form-select">
                                @if (o.Status == "Pending")
                                {
                                    <option value="Pending" selected>Chờ xử lý</option>
                                    @if (!waitingPayOs)
                                    {
                                        <option value="Confirmed">Đã xác nhận COD</option>
                                    }
                                    <option value="Cancelled">Đã hủy</option>
                                }
                                else if (o.Status == "Confirmed")
                                {
                                    <option value="Confirmed" selected>Đã xác nhận</option>
                                    <option value="Cancelled">Đã hủy</option>
                                }
                                else if (o.Status == "Shipping")
                                {
                                    <option value="Shipping" selected>Đang giao</option>
                                    <option value="AwaitingReceipt">Đã giao tới khách, chờ khách xác nhận</option>
                                }
                                else if (o.Status == "AwaitingReceipt")
                                {
                                    <option value="AwaitingReceipt" selected>Chờ khách xác nhận</option>
                                    <option value="Shipping">Khách báo chưa nhận - quay lại đang giao</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-success">Lưu</button>
                        </form>
                    }
                    else
                    {
                        <div class="text-muted">Đơn hàng không còn thao tác.</div>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-header fw-semibold">Mặt hàng</div>
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr><th>Mặt hàng</th><th>SL</th><th>Đơn giá</th><th>Thành tiền</th></tr>
                        </thead>
                        <tbody>
                        @foreach (var item in o.Items ?? Enumerable.Empty<PetShop.Shared.DTOs.Response.OrderItemResponse>())
                        {
                            var itemName = item.ProductName ?? item.PetName;
                            var itemType = item.ProductId.HasValue ? "Sản phẩm" : "Thú cưng";
                            var itemCode = item.ProductId ?? item.PetId;
                            <tr>
                                <td>
                                    <div class="fw-semibold">@(string.IsNullOrWhiteSpace(itemName) ? $"{itemType} #{itemCode}" : itemName)</div>
                                    <div class="small text-muted">@itemType #@itemCode</div>
                                </td>
                                <td>@item.Quantity</td>
                                <td>@item.UnitPrice.ToString("N0")đ</td>
                                <td class="fw-semibold">@item.SubTotal.ToString("N0")đ</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}
