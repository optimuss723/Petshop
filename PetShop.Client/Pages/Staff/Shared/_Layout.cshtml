<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] — Staff Portal</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
    <style>
        :root {
            --staff-primary: #16a34a;
            --staff-dark:    #15803d;
            --staff-light:   #f0fdf4;
            --sidebar-w:     240px;
        }
        * { font-family: 'Inter', sans-serif; }
        body { background: #f8fafc; min-height: 100vh; }

        /* Sidebar */
        #staff-sidebar {
            width: var(--sidebar-w);
            min-height: 100vh;
            background: linear-gradient(180deg, #14532d 0%, #166534 60%, #15803d 100%);
            position: fixed;
            top: 0; left: 0;
            z-index: 100;
            display: flex;
            flex-direction: column;
        }
        .sidebar-brand {
            padding: 1.25rem 1.5rem;
            color: #bbf7d0;
            font-size: 1.1rem;
            font-weight: 700;
            border-bottom: 1px solid rgba(255,255,255,.15);
        }
        .sidebar-brand span { color: #fff; }
        .sidebar-nav { padding: 1rem 0; flex: 1; }
        .nav-section {
            padding: 0.25rem 1rem;
            font-size: .65rem;
            font-weight: 600;
            letter-spacing: .08em;
            color: #86efac;
            text-transform: uppercase;
            margin-top: .75rem;
        }
        .nav-item a {
            display: flex;
            align-items: center;
            gap: .6rem;
            padding: .55rem 1.5rem;
            color: #d1fae5;
            text-decoration: none;
            font-size: .9rem;
            border-radius: 0;
            transition: background .15s, color .15s;
        }
        .nav-item a:hover,
        .nav-item a.active {
            background: rgba(255,255,255,.12);
            color: #fff;
        }
        .nav-item a .icon { font-size: 1rem; width: 1.25rem; text-align: center; }

        /* Top bar */
        #staff-topbar {
            position: fixed;
            top: 0; left: var(--sidebar-w);
            right: 0; height: 56px;
            background: #fff;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 1.5rem;
            z-index: 99;
        }
        .topbar-page-title { font-weight: 600; font-size: .95rem; color: #1e293b; }
        .topbar-user { display: flex; align-items: center; gap: .75rem; }
        .staff-badge {
            background: var(--staff-light);
            color: var(--staff-primary);
            border: 1px solid #bbf7d0;
            padding: .15rem .6rem;
            border-radius: 99px;
            font-size: .75rem;
            font-weight: 600;
        }

        /* Main content */
        #staff-main {
            margin-left: var(--sidebar-w);
            margin-top: 56px;
            padding: 1.75rem;
        }

        /* Cards */
        .stat-card {
            background: #fff;
            border-radius: 12px;
            border: 1px solid #e2e8f0;
            padding: 1.25rem;
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        .stat-icon {
            width: 48px; height: 48px;
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.4rem;
        }
        .stat-icon.green  { background: #f0fdf4; }
        .stat-icon.yellow { background: #fefce8; }
        .stat-icon.blue   { background: #eff6ff; }
        .stat-icon.gray   { background: #f8fafc; }
        .stat-value { font-size: 1.6rem; font-weight: 700; color: #0f172a; line-height: 1; }
        .stat-label { font-size: .8rem; color: #64748b; margin-top: .15rem; }

        /* Tables */
        .data-table { background: #fff; border-radius: 12px; border: 1px solid #e2e8f0; overflow: hidden; }
        .data-table .table { margin: 0; }
        .data-table .table thead th { background: #f8fafc; font-size: .8rem; font-weight: 600; color: #475569; text-transform: uppercase; letter-spacing: .04em; border-bottom: 1px solid #e2e8f0; padding: .75rem 1rem; }
        .data-table .table tbody td { padding: .85rem 1rem; vertical-align: middle; border-color: #f1f5f9; }
        .data-table .table tbody tr:hover { background: #f8fafc; }

        /* Scrollbar */
        ::-webkit-scrollbar { width: 5px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9px; }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>

<!-- ── SIDEBAR ── -->
<aside id="staff-sidebar">
    <div class="sidebar-brand">
        🐾 PetShop <span>Staff</span>
    </div>
    <nav class="sidebar-nav">
        <div class="nav-section">Chính</div>
        <div class="nav-item">
            <a href="/Staff/Dashboard"
               class="@(Context.Request.Path.StartsWithSegments("/Staff/Dashboard") ? "active" : "")">
                <span class="icon">📊</span> Dashboard
            </a>
        </div>
        <div class="nav-section">Đơn hàng</div>
        <div class="nav-item">
            <a href="/Staff/Orders"
               class="@(Context.Request.Path.StartsWithSegments("/Staff/Orders") ? "active" : "")">
                <span class="icon">📦</span> Quản lý đơn
            </a>
        </div>
        <div class="nav-section">Sản phẩm</div>
        <div class="nav-item">
            @{
                var staffProdPath  = Context.Request.Path.Value ?? "";
                var staffProdQuery = Context.Request.Query["category"].ToString();
            }
            <a href="/Staff/Products?category=Food"
               class="@(staffProdPath.StartsWith("/Staff/Products") && staffProdQuery == "Food" ? "active" : "")">
                <span class="icon">🍖</span> Thức ăn
            </a>
        </div>
        <div class="nav-item">
            <a href="/Staff/Products?category=Toy"
               class="@(staffProdPath.StartsWith("/Staff/Products") && staffProdQuery == "Toy" ? "active" : "")">
                <span class="icon">🎾</span> Đồ chơi
            </a>
        </div>
        <div class="nav-item">
            <a href="/Staff/Products?category=Accessory"
               class="@(staffProdPath.StartsWith("/Staff/Products") && staffProdQuery == "Accessory" ? "active" : "")">
                <span class="icon">🎀</span> Trang trí & Phụ kiện
            </a>
        </div>
        <div class="nav-item">
            <a href="/Staff/Pets"
               class="@(Context.Request.Path.StartsWithSegments("/Staff/Pets") ? "active" : "")">
                <span class="icon">🐾</span> Quản lý thú cưng
            </a>
        </div>
        <div class="nav-item">
            <a href="/Staff/Categories"
               class="@(Context.Request.Path.StartsWithSegments("/Staff/Categories") ? "active" : "")">
                <span class="icon">🏷️</span> Danh mục
            </a>
        </div>
        <div class="nav-section">Tôi</div>
        <div class="nav-item">
            <a href="/Staff/AuditLog"
               class="@(Context.Request.Path.StartsWithSegments("/Staff/AuditLog") ? "active" : "")">
                <span class="icon">📋</span> Lịch sử thao tác
            </a>
        </div>
    </nav>
    <div style="padding:1rem 1.5rem;border-top:1px solid rgba(255,255,255,.1)">
        <a href="/Auth/Logout" class="btn btn-sm w-100"
           style="background:rgba(255,255,255,.1);color:#d1fae5;border:1px solid rgba(255,255,255,.2)">
            🚪 Đăng xuất
        </a>
    </div>
</aside>

<!-- ── TOP BAR ── -->
<header id="staff-topbar">
    <span class="topbar-page-title">@(ViewData["Title"] ?? "Staff Portal")</span>
    <div class="topbar-user">
        <span class="staff-badge">🔧 Staff</span>
        <span style="font-size:.85rem;font-weight:500;color:#334155">
            @Context.Session.GetString("UserName")
        </span>
    </div>
</header>

<!-- ── MAIN ── -->
<main id="staff-main">
    @RenderBody()
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@RenderSection("Scripts", required: false)
</body>
</html>
