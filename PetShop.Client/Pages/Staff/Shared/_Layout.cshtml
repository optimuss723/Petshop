<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " — Staff Portal" : "PetShop — Staff Portal")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
    <link rel="stylesheet" href="~/css/petshop-design.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/petshop-backoffice.css" asp-append-version="true"/>
    <style>
        /* Staff backoffice compatibility helpers */
        .stat-card {
            background: #fff;
            border-radius: var(--ps-radius);
            border: 1px solid var(--ps-line);
            box-shadow: var(--ps-shadow-sm);
            padding: 1.15rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            height: 100%;
        }
        .stat-icon {
            width: 48px; height: 48px;
            border-radius: var(--ps-radius-sm);
            display: flex; align-items: center; justify-content: center;
            font-size: 1.35rem;
            flex-shrink: 0;
        }
        .stat-icon.green  { background: var(--ps-brand-soft); color: var(--ps-brand-dark); }
        .stat-icon.yellow { background: #fff5d9; color: #9e6f00; }
        .stat-icon.blue   { background: #e8f0ff; color: #316dc9; }
        .stat-icon.gray   { background: var(--ps-surface-soft); color: var(--ps-muted); }
        .stat-value { font-size: 1.45rem; font-weight: 800; color: var(--ps-ink); line-height: 1.1; }
        .stat-label { font-size: .8rem; color: var(--ps-muted); margin-top: .2rem; }
        .data-table { background: #fff; border-radius: var(--ps-radius); border: 1px solid var(--ps-line); box-shadow: var(--ps-shadow-sm); overflow: hidden; }
        .data-table .table { margin: 0; }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body class="ps-backoffice">

<div class="ps-admin-shell d-flex" id="staffShell">
    <!-- ── SIDEBAR ── -->
    <aside class="ps-sidebar" id="staffSidebar">
        <a href="/Staff/Dashboard" class="ps-sidebar__brand d-flex align-items-center">
            <span class="ps-sidebar__logo">🐾</span>
            <div>
                <div>PetShop <span class="badge bg-success ms-1" style="font-size:0.65rem;">Staff</span></div>
                <div class="ps-sidebar__user">
                    <i class="bi bi-person-badge text-success me-1"></i>@Context.Session.GetString("UserName")
                </div>
            </div>
        </a>

        <nav class="flex-grow-1 py-2">
            <div class="ps-sidebar__label">Tổng quan</div>
            <a href="/Staff/Dashboard"
               class="ps-sidebar__link @(Context.Request.Path.StartsWithSegments("/Staff/Dashboard") ? "active" : "")">
                <i class="bi bi-grid-1x2"></i> Dashboard
            </a>

            <div class="ps-sidebar__label">Đơn hàng</div>
            <a href="/Staff/Orders"
               class="ps-sidebar__link @(Context.Request.Path.StartsWithSegments("/Staff/Orders") ? "active" : "")">
                <i class="bi bi-box-seam"></i> Quản lý đơn
            </a>

            <div class="ps-sidebar__label">Sản phẩm & Thú cưng</div>
            @{
                var staffProdPath  = Context.Request.Path.Value ?? "";
                var staffProdQuery = Context.Request.Query["category"].ToString();
            }
            <a href="/Staff/Products?category=Food"
               class="ps-sidebar__link @(staffProdPath.StartsWith("/Staff/Products") && staffProdQuery == "Food" ? "active" : "")">
                <i class="bi bi-egg-fried"></i> Thức ăn
            </a>
            <a href="/Staff/Products?category=Toy"
               class="ps-sidebar__link @(staffProdPath.StartsWith("/Staff/Products") && staffProdQuery == "Toy" ? "active" : "")">
                <i class="bi bi-controller"></i> Đồ chơi
            </a>
            <a href="/Staff/Products?category=Accessory"
               class="ps-sidebar__link @(staffProdPath.StartsWith("/Staff/Products") && staffProdQuery == "Accessory" ? "active" : "")">
                <i class="bi bi-gift"></i> Trang trí & Phụ kiện
            </a>
            <a href="/Staff/Pets"
               class="ps-sidebar__link @(Context.Request.Path.StartsWithSegments("/Staff/Pets") ? "active" : "")">
                <i class="bi bi-heart-pulse"></i> Quản lý thú cưng
            </a>
            <a href="/Staff/Categories"
               class="ps-sidebar__link @(Context.Request.Path.StartsWithSegments("/Staff/Categories") ? "active" : "")">
                <i class="bi bi-tags"></i> Danh mục
            </a>

            <div class="ps-sidebar__label">Hệ thống</div>
            <a href="/Staff/AuditLog"
               class="ps-sidebar__link @(Context.Request.Path.StartsWithSegments("/Staff/AuditLog") ? "active" : "")">
                <i class="bi bi-journal-text"></i> Lịch sử thao tác
            </a>
            <a href="/" target="_blank" class="ps-sidebar__link text-light">
                <i class="bi bi-shop"></i> Xem trang chủ <i class="bi bi-box-arrow-up-right ms-auto small opacity-50"></i>
            </a>
        </nav>

        <div class="ps-sidebar__footer">
            <a href="/Auth/Logout" class="ps-sidebar__link text-danger">
                <i class="bi bi-box-arrow-right"></i> Đăng xuất
            </a>
        </div>
    </aside>

    <!-- ── WORKSPACE ── -->
    <div class="ps-workspace d-flex flex-column">
        <!-- ── TOP BAR ── -->
        <header class="ps-topbar">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-sm btn-outline-secondary ps-mobile-sidebar-toggle" id="staffSidebarToggleBtn" type="button" aria-label="Toggle menu">
                    <i class="bi bi-list fs-5"></i>
                </button>
                <span class="ps-topbar__title">@(ViewData["Title"] ?? "Staff Portal")</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5 fw-semibold">
                    <i class="bi bi-person-badge me-1"></i>Nhân viên: @Context.Session.GetString("UserName")
                </span>
                <a href="/Auth/Logout" class="btn btn-sm btn-outline-danger px-3">
                    <i class="bi bi-box-arrow-right me-1"></i>Đăng xuất
                </a>
            </div>
        </header>

        <!-- ── MAIN CONTENT ── -->
        <main class="ps-workspace-content flex-grow-1" id="staff-main">
            @RenderBody()
        </main>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('staffSidebarToggleBtn');
    const shell = document.getElementById('staffShell');
    if (toggleBtn && shell) {
        toggleBtn.addEventListener('click', () => {
            shell.classList.toggle('sidebar-open');
        });
    }
});
</script>
@RenderSection("Scripts", required: false)
</body>
</html>
