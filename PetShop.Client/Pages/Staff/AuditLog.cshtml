@page
@model PetShop.Client.Pages.Staff.AuditLogModel
@{
    ViewData["Title"] = "Lịch sử thao tác";
}

<div class="ps-backoffice-heading">
    <div>
        <span class="ps-kicker">Nhật ký hệ thống</span>
        <h1>Lịch sử thao tác</h1>
        <p>Theo dõi tiến trình duyệt đơn, thay đổi trạng thái và tạo vận đơn trong ca làm việc.</p>
    </div>
    <div>
        <a class="btn btn-outline-secondary" href="/Staff/Orders">
            <i class="bi bi-arrow-left me-1"></i>Quay lại đơn hàng
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4 shadow-sm">
        <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
        <div>@Model.ErrorMessage</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<div class="ps-table-wrap mb-4">
    <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-white">
        <h6 class="mb-0 fw-bold"><i class="bi bi-journal-text text-primary me-2"></i>Nhật ký thao tác nghiệp vụ</h6>
        <span class="text-muted small">Trang @Model.PageNumber</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-3" style="width:170px">Thời gian</th>
                    <th>Nhân viên</th>
                    <th>Hành động</th>
                    <th>Đơn hàng</th>
                    <th class="pe-3">Chi tiết diễn giải</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var log in Model.Logs)
            {
                <tr>
                    <td class="ps-3 small text-muted">@log.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                    <td>
                        <div class="fw-semibold text-dark">@log.StaffName</div>
                        <div class="small text-muted">
                            <span class="badge bg-warning-subtle text-warning-emphasis">🔧 Staff</span>
                        </div>
                    </td>
                    <td><span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold">@log.Action</span></td>
                    <td>
                        @if (log.OrderId.HasValue)
                        {
                            <a href="/Staff/Orders/Detail/@log.OrderId" class="text-decoration-none fw-bold">#@log.OrderId</a>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td class="small pe-3">@(string.IsNullOrWhiteSpace(log.Details) ? "—" : log.Details)</td>
                </tr>
            }
            @if (!Model.Logs.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-5">
                        <i class="bi bi-journal-check fs-2 d-block mb-2 text-muted opacity-50"></i>
                        Chưa có thao tác nào được ghi nhận trong khoảng thời gian này.
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="d-flex justify-content-end gap-2 mb-5">
    @if (Model.PageNumber > 1)
    {
        <a class="btn btn-outline-secondary btn-sm" href="/Staff/AuditLog?page=@(Model.PageNumber - 1)">
            <i class="bi bi-chevron-left me-1"></i>Trang trước
        </a>
    }
    <a class="btn btn-outline-secondary btn-sm" href="/Staff/AuditLog?page=@(Model.PageNumber + 1)">
        Trang sau <i class="bi bi-chevron-right ms-1"></i>
    </a>
</div>
