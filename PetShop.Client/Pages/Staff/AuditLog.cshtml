@page
@model PetShop.Client.Pages.Staff.AuditLogModel
@{
    ViewData["Title"] = "Lịch sử thao tác";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1 fw-semibold">📋 Lịch sử thao tác</h4>
        <div class="text-muted small">Xem lại các thao tác bạn đã thực hiện trên hệ thống.</div>
    </div>
    <a class="btn btn-outline-success btn-sm" href="/Staff/Orders">← Quay lại đơn hàng</a>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="data-table">
    <table class="table table-hover align-middle">
        <thead>
        <tr>
            <th>Thời gian</th>
            <th>Nhân viên</th>
            <th>Hành động</th>
            <th>Đơn hàng</th>
            <th>Chi tiết</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var log in Model.Logs)
        {
            <tr>
                <td class="small text-muted">@log.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    <div class="fw-semibold">@log.StaffName</div>
                    <div class="small text-muted">
                        <span class="badge bg-warning text-dark">🔧 Staff</span>
                    </div>
                </td>
                <td><span class="badge bg-success-subtle text-success border border-success-subtle">@log.Action</span></td>
                <td>
                    @if (log.OrderId.HasValue)
                    {
                        <a href="/Staff/Orders/Detail/@log.OrderId" class="text-decoration-none fw-semibold">#@log.OrderId</a>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>
                <td class="small">@(string.IsNullOrWhiteSpace(log.Details) ? "—" : log.Details)</td>
            </tr>
        }
        @if (!Model.Logs.Any())
        {
            <tr>
                <td colspan="5" class="text-center text-muted py-4">
                    📝 Chưa có thao tác nào được ghi nhận.
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<div class="d-flex justify-content-end gap-2 mt-3">
    @if (Model.PageNumber > 1)
    {
        <a class="btn btn-outline-secondary btn-sm" href="/Staff/AuditLog?page=@(Model.PageNumber - 1)">‹ Trang trước</a>
    }
    <a class="btn btn-outline-secondary btn-sm" href="/Staff/AuditLog?page=@(Model.PageNumber + 1)">Trang sau ›</a>
</div>
