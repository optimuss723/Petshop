@page
@model PetShop.Client.Pages.Staff.Products.IndexModel
@{ ViewData["Title"] = "Quản lý Sản phẩm"; }

<div class="ps-backoffice-heading">
    <div>
        <span class="ps-kicker">Kho hàng nhân viên</span>
        <h1>Quản lý Sản phẩm</h1>
        <p>Quản lý tồn kho, giá bán và phân loại sản phẩm phụ kiện thú cưng.</p>
    </div>
    <div>
        <a href="/Staff/Products/Edit" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>Thêm sản phẩm mới
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill text-success fs-5"></i>
        <div>@Model.Message</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

@{
    var categories = new[]
    {
        new { Label = "Tất cả", Icon = "🛍️", Value = "", Url = "/Staff/Products" },
        new { Label = "Thú cưng", Icon = "🐾", Value = "__pets", Url = "/Staff/Pets" },
        new { Label = "Thức ăn", Icon = "🍖", Value = "Food", Url = "/Staff/Products?category=Food" },
        new { Label = "Phụ kiện", Icon = "🎀", Value = "Accessory", Url = "/Staff/Products?category=Accessory" },
        new { Label = "Đồ chơi", Icon = "🎾", Value = "Toy", Url = "/Staff/Products?category=Toy" },
        new { Label = "Thuốc", Icon = "💊", Value = "Medicine", Url = "/Staff/Products?category=Medicine" },
        new { Label = "Grooming", Icon = "✂️", Value = "Grooming", Url = "/Staff/Products?category=Grooming" },
        new { Label = "Khác", Icon = "📦", Value = "Other", Url = "/Staff/Products?category=Other" }
    };
}

<div class="d-flex flex-wrap gap-2 mb-4">
    @foreach (var item in categories)
    {
        var active = item.Value == "" ? string.IsNullOrEmpty(Model.Category) : Model.Category == item.Value;
        <a href="@item.Url"
           class="btn btn-sm ajax-link @(active ? "btn-primary" : "btn-light border") px-3 py-1.5 fw-semibold">
            @item.Icon @item.Label
        </a>
    }
</div>

<!-- Filter Bar -->
<div class="ps-filter-toolbar mb-4">
    <form method="get" id="filter-form" class="row g-2 align-items-center">
        <div class="col-md-3">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input name="search" value="@Model.Search" class="form-control border-start-0 ps-0" placeholder="Tìm tên sản phẩm..."/>
            </div>
        </div>
        <div class="col-md-2">
            <select name="category" class="form-select">
                <option value="">Tất cả danh mục</option>
                <option value="Food"      selected="@(Model.Category=="Food")">🍖 Thức ăn</option>
                <option value="Accessory" selected="@(Model.Category=="Accessory")">🎀 Phụ kiện</option>
                <option value="Medicine"  selected="@(Model.Category=="Medicine")">💊 Thuốc</option>
                <option value="Toy"       selected="@(Model.Category=="Toy")">🎾 Đồ chơi</option>
                <option value="Grooming"  selected="@(Model.Category=="Grooming")">✂️ Grooming</option>
                <option value="Other"     selected="@(Model.Category=="Other")">📦 Khác</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="sort" class="form-select">
                <option value="CreatedAt desc" selected="@(Model.Sort=="CreatedAt desc")">Mới nhất trước</option>
                <option value="Name asc"       selected="@(Model.Sort=="Name asc")">Tên A-Z</option>
                <option value="Name desc"      selected="@(Model.Sort=="Name desc")">Tên Z-A</option>
                <option value="Price asc"      selected="@(Model.Sort=="Price asc")">Giá tăng dần</option>
                <option value="Price desc"     selected="@(Model.Sort=="Price desc")">Giá giảm dần</option>
                <option value="Stock asc"      selected="@(Model.Sort=="Stock asc")">Tồn kho thấp nhất</option>
            </select>
        </div>
        <div class="col-md-1">
            <select name="pageSize" class="form-select">
                <option value="4"  selected="@(Model.PageSize==4)">4</option>
                <option value="8"  selected="@(Model.PageSize==8)">8</option>
                <option value="12" selected="@(Model.PageSize==12)">12</option>
                <option value="16" selected="@(Model.PageSize==16)">16</option>
                <option value="24" selected="@(Model.PageSize==24)">24</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill">
                <i class="bi bi-funnel me-1"></i>Lọc
            </button>
            <a href="/Staff/Products" class="btn btn-outline-secondary ajax-link">Xoá lọc</a>
            <a href="/Staff/Products/Edit" class="btn btn-success d-flex align-items-center gap-1 text-nowrap">
                <i class="bi bi-plus-circle"></i>Thêm
            </a>
        </div>
    </form>
</div>

<div id="product-grid" style="transition:opacity 0.2s ease;">
    <partial name="_ProductGrid" model="Model" />
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const grid = document.getElementById('product-grid');

        function loadAjax(url) {
            if (!grid) return;
            grid.style.opacity = '0.5';

            fetch(url, {
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(res => res.text())
            .then(html => {
                grid.innerHTML = html;
                grid.style.opacity = '1';
                window.history.pushState({}, '', url);
            })
            .catch(err => {
                console.error(err);
                grid.style.opacity = '1';
            });
        }

        // Handle filter form submit
        const filterForm = document.getElementById('filter-form');
        if (filterForm) {
            filterForm.addEventListener('submit', (e) => {
                e.preventDefault();
                const url = '?' + new URLSearchParams(new FormData(e.target)).toString();
                loadAjax(url);
            });
        }

        // Handle clicks on ajax links
        document.body.addEventListener('click', (e) => {
            const link = e.target.closest('a.ajax-link');
            if (link) {
                e.preventDefault();
                if(link.classList.contains('btn')) {
                    document.querySelectorAll('a.ajax-link.btn').forEach(l => {
                        l.classList.remove('btn-primary');
                        l.classList.add('btn-light', 'border');
                    });
                    link.classList.remove('btn-light', 'border');
                    link.classList.add('btn-primary');
                }

                loadAjax(link.href);
            }
        });

        // Handle back/forward browser buttons
        window.addEventListener('popstate', () => {
            loadAjax(location.href);
        });
    });
</script>
}
