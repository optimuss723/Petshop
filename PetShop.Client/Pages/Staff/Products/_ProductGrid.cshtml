@model PetShop.Client.Pages.Staff.Products.IndexModel

@{
    string CategoryIcon(string cat) => cat switch {
        "Food"      => "🍖",
        "Accessory" => "🎀",
        "Medicine"  => "💊",
        "Toy"       => "🎾",
        "Grooming"  => "✂️",
        _           => "📦"
    };
}

<!-- Product Cards -->
<div class="row row-cols-1 row-cols-md-3 row-cols-xl-4 g-3 mb-4">
@foreach (var p in Model.Products)
{
    <div class="col">
        <div class="card h-100 ps-management-card">
            @if (!string.IsNullOrEmpty(p.ImageUrl))
            {
                <div class="ps-management-card__thumb" style="height: 180px; overflow: hidden; background: #f8fafc;">
                    <img src="@p.ImageUrl" alt="@p.Name" loading="lazy" referrerpolicy="no-referrer" style="height: 180px; width: 100%; object-fit: cover;" onerror="this.onerror=null;this.parentElement.innerHTML='<div class=\'ps-management-card__thumb-fallback fs-1\' style=\'height:180px;display:flex;align-items:center;justify-content:center;\'>@CategoryIcon(p.Category)</div>'"/>
                </div>
            }
            else
            {
                <div class="ps-management-card__thumb" style="height: 180px; overflow: hidden; background: #f8fafc;">
                    <div class="ps-management-card__thumb-fallback fs-1" style="height: 180px; display: flex; align-items: center; justify-content: center;">@CategoryIcon(p.Category)</div>
                </div>
            }
            <div class="card-body p-3 d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                    <span class="badge bg-light text-muted border" style="font-size:0.75rem">#@p.Id</span>
                    <span class="badge @(p.IsActive ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") fw-semibold">
                        @(p.IsActive ? "Đang bán" : "Ngừng bán")
                    </span>
                </div>
                <h6 class="card-title fw-bold text-dark mb-1" style="font-size:0.95rem;line-height:1.35">@p.Name</h6>
                <p class="text-muted small mb-2 text-truncate" style="max-height:2.6em;">@p.Description</p>

                <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-primary fs-6">@p.Price.ToString("N0")đ</span>
                    <span class="small badge @(p.Stock < 10 ? "bg-danger-subtle text-danger" : "bg-secondary-subtle text-secondary")">
                        Kho: @p.Stock
                    </span>
                </div>
            </div>
            <div class="card-footer bg-light border-top p-2.5 d-flex gap-2">
                <a href="/Staff/Products/Edit/@p.Id" class="btn btn-sm btn-outline-primary flex-fill">
                    <i class="bi bi-pencil-square me-1"></i>Sửa
                </a>
                <form method="post" asp-page-handler="Delete" class="flex-fill"
                      onsubmit="return confirm('Xoá sản phẩm @p.Name?')">
                    <input type="hidden" name="id" value="@p.Id"/>
                    <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                        <i class="bi bi-trash me-1"></i>Xoá
                    </button>
                </form>
            </div>
        </div>
    </div>
}
@if (!Model.Products.Any())
{
    <div class="col-12">
        <div class="ps-empty card">
            <div class="ps-empty__icon"><i class="bi bi-box2"></i></div>
            <h5 class="fw-bold mb-1">Không tìm thấy sản phẩm nào</h5>
            <p class="text-muted small mb-3">Thử đổi điều kiện tìm kiếm hoặc thêm mới sản phẩm vào kho.</p>
            <a href="/Staff/Products/Edit" class="btn btn-primary btn-sm px-4">Thêm sản phẩm</a>
        </div>
    </div>
}
</div>

<!-- Pagination -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 p-3 bg-white rounded border">
    <div class="d-flex align-items-center gap-2">
        <span class="text-muted small">Tổng: <strong>@Model.TotalCount</strong> sản phẩm</span>
        <span class="badge @(Model.UsedOData ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-secondary")">
            @(Model.UsedOData ? "⚡ OData Protocol" : "REST Fallback")
        </span>
    </div>
    @if (Model.TotalPages > 1)
    {
        <nav>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link ajax-link"
                       href="?search=@Model.Search&category=@Model.Category&sort=@Model.Sort&pageNumber=@(Model.PageNumber - 1)&pageSize=@Model.PageSize">‹</a>
                </li>
                @for (var i = Math.Max(1, Model.PageNumber - 2); i <= Math.Min(Model.TotalPages, Model.PageNumber + 2); i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link ajax-link"
                           href="?search=@Model.Search&category=@Model.Category&sort=@Model.Sort&pageNumber=@i&pageSize=@Model.PageSize">@i</a>
                    </li>
                }
                <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link ajax-link"
                       href="?search=@Model.Search&category=@Model.Category&sort=@Model.Sort&pageNumber=@(Model.PageNumber + 1)&pageSize=@Model.PageSize">›</a>
                </li>
            </ul>
        </nav>
    }
</div>
