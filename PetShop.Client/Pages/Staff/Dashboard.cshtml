@page
@model PetShop.Client.Pages.Staff.DashboardModel
@{ ViewData["Title"] = "Bàn làm việc Nhân viên"; }

<div class="ps-backoffice-heading">
    <div>
        <span class="ps-kicker">Khu vực điều hành</span>
        <h1>Bàn làm việc Nhân viên</h1>
        <p>Xin chào, <strong>@Model.UserName</strong>! Theo dõi và xử lý nhanh các đơn hàng trong ca trực hôm nay.</p>
    </div>
    <div>
        <a class="btn btn-primary" href="/Staff/Orders">
            <i class="bi bi-box-seam me-1"></i>Xử lý đơn hàng
        </a>
    </div>
</div>

@* ── Stat Cards ── *@
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <a href="/Staff/Orders?status=Pending" class="text-decoration-none">
            <div class="ps-metric ps-metric--sun">
                <div class="ps-metric__icon"><i class="bi bi-hourglass-split"></i></div>
                <div>
                    <div class="ps-metric__value">@Model.PendingCount</div>
                    <div class="ps-metric__label">Đơn chờ duyệt COD</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-xl-3">
        <a href="/Staff/Orders?status=Confirmed" class="text-decoration-none">
            <div class="ps-metric ps-metric--blue">
                <div class="ps-metric__icon"><i class="bi bi-check-circle"></i></div>
                <div>
                    <div class="ps-metric__value">@Model.ConfirmedCount</div>
                    <div class="ps-metric__label">Đã xác nhận / Chờ gửi</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-xl-3">
        <a href="/Staff/Orders?status=Shipping" class="text-decoration-none">
            <div class="ps-metric">
                <div class="ps-metric__icon text-success" style="background:#e8f7f1;"><i class="bi bi-truck"></i></div>
                <div>
                    <div class="ps-metric__value">@Model.ShippingCount</div>
                    <div class="ps-metric__label">Đang trên đường giao</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-xl-3">
        <a href="/Staff/Orders?status=Delivered" class="text-decoration-none">
            <div class="ps-metric">
                <div class="ps-metric__icon" style="background:#eef8f3;color:#087d62;"><i class="bi bi-box2-heart"></i></div>
                <div>
                    <div class="ps-metric__value">@Model.DeliveredCount</div>
                    <div class="ps-metric__label">Đã giao thành công</div>
                </div>
            </div>
        </a>
    </div>
</div>

@* ── Bảng đơn hàng cần xử lý ── *@
<div class="ps-table-wrap mb-5">
    <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-white">
        <h6 class="mb-0 fw-bold"><i class="bi bi-receipt text-primary me-2"></i>Đơn hàng vừa đặt cần xử lý</h6>
        <a class="small text-decoration-none fw-semibold" href="/Staff/AuditLog">Lịch sử thao tác →</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-3" style="width:90px">Mã đơn</th>
                    <th>Khách hàng</th>
                    <th>Trạng thái</th>
                    <th>Tổng thanh toán</th>
                    <th>Ngày đặt</th>
                    <th class="text-end pe-3">Thao tác</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var order in Model.RecentOrders)
            {
                var statusLabel = order.Status switch {
                    "Pending"        => "⏳ Chờ duyệt COD",
                    "Confirmed"      => "✅ Đã xác nhận",
                    "Shipping"       => "🚚 Đang giao hàng",
                    "AwaitingReceipt"=> "📬 Chờ khách nhận",
                    "Delivered"      => "📦 Đã hoàn tất",
                    "Cancelled"      => "❌ Đã huỷ",
                    _ => order.Status
                };
                var statusBadge = order.Status switch {
                    "Pending"         => "bg-warning-subtle text-warning-emphasis",
                    "Confirmed"       => "bg-info-subtle text-info-emphasis",
                    "Shipping"        => "bg-primary-subtle text-primary",
                    "AwaitingReceipt" => "bg-warning-subtle text-warning-emphasis",
                    "Delivered"       => "bg-success-subtle text-success",
                    "Cancelled"       => "bg-secondary-subtle text-secondary",
                    _ => "bg-light text-dark"
                };

                <tr>
                    <td class="ps-3 fw-bold text-dark">#@order.Id</td>
                    <td>
                        <div class="fw-semibold text-dark">@order.UserName</div>
                        @if (!string.IsNullOrEmpty(order.CustomerPhone))
                        {
                            <div class="text-muted small"><i class="bi bi-telephone me-1"></i>@order.CustomerPhone</div>
                        }
                    </td>
                    <td>
                        <span class="badge @statusBadge">@statusLabel</span>
                    </td>
                    <td class="fw-bold text-success">@order.TotalAmount.ToString("N0")đ</td>
                    <td class="small text-muted">@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="text-end pe-3">
                        <a class="btn btn-sm btn-outline-primary" href="/Staff/Orders">
                            Xử lý ngay <i class="bi bi-chevron-right ms-1"></i>
                        </a>
                    </td>
                </tr>
            }
            @if (!Model.RecentOrders.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-5">
                        <i class="bi bi-check2-circle fs-2 d-block mb-2 text-success"></i>
                        Tuyệt vời! Không có đơn hàng nào tồn đọng cần xử lý.
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
