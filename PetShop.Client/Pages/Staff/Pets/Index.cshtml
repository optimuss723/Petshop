@page
@model PetShop.Client.Pages.Staff.Pets.IndexModel
@{ ViewData["Title"] = "Quản lý Thú cưng"; }

<div class="ps-backoffice-heading">
    <div>
        <span class="ps-kicker">Kho giống thú cưng</span>
        <h1>Quản lý Thú cưng</h1>
        <p>Danh sách các bé cún, mèo, chim cảnh và cá cảnh đang được chăm sóc tại cửa hàng.</p>
    </div>
    <div>
        <a href="/Staff/Pets/Edit" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>Thêm thú cưng mới
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill text-success fs-5"></i>
        <div>@Model.Message</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex flex-wrap gap-2 mb-4">
    <a href="/Staff/Products" class="btn btn-sm btn-light border px-3 py-1.5 fw-semibold">🛍️ Tất cả sản phẩm</a>
    <a href="/Staff/Pets" class="btn btn-sm btn-primary px-3 py-1.5 fw-semibold">🐾 Thú cưng thuần chủng</a>
    <a href="/Staff/Products?category=Food" class="btn btn-sm btn-light border px-3 py-1.5 fw-semibold">🍖 Thức ăn</a>
    <a href="/Staff/Products?category=Accessory" class="btn btn-sm btn-light border px-3 py-1.5 fw-semibold">🎀 Phụ kiện</a>
    <a href="/Staff/Products?category=Toy" class="btn btn-sm btn-light border px-3 py-1.5 fw-semibold">🎾 Đồ chơi</a>
    <a href="/Staff/Products?category=Medicine" class="btn btn-sm btn-light border px-3 py-1.5 fw-semibold">💊 Thuốc</a>
    <a href="/Staff/Products?category=Grooming" class="btn btn-sm btn-light border px-3 py-1.5 fw-semibold">✂️ Grooming</a>
</div>

<div class="ps-filter-toolbar mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-3">
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" class="form-control" placeholder="Tìm tên, giống..." value="@Model.Search"/>
            </div>
        </div>
        <div class="col-md-2">
            <select name="category" class="form-select">
                <option value="">Tất cả giống loài</option>
                <option value="Dog"    selected="@(Model.Category=="Dog")">🐕 Chó cảnh</option>
                <option value="Cat"    selected="@(Model.Category=="Cat")">🐈 Mèo cảnh</option>
                <option value="Bird"   selected="@(Model.Category=="Bird")">🐦 Chim cảnh</option>
                <option value="Fish"   selected="@(Model.Category=="Fish")">🐟 Cá cảnh</option>
                <option value="Rabbit" selected="@(Model.Category=="Rabbit")">🐇 Thỏ kiểng</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="status" class="form-select">
                <option value="">Tất cả trạng thái</option>
                <option value="Available" selected="@(Model.Status=="Available")">Sẵn sàng đón</option>
                <option value="Reserved"  selected="@(Model.Status=="Reserved")">Đã đặt cọc</option>
                <option value="Sold"      selected="@(Model.Status=="Sold")">Đã bán</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="pageSize" class="form-select">
                <option value="4"  selected="@(Model.PageSize==4)">4 / trang</option>
                <option value="8"  selected="@(Model.PageSize==8)">8 / trang</option>
                <option value="12" selected="@(Model.PageSize==12)">12 / trang</option>
                <option value="16" selected="@(Model.PageSize==16)">16 / trang</option>
                <option value="24" selected="@(Model.PageSize==24)">24 / trang</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill">
                <i class="bi bi-funnel me-1"></i>Lọc
            </button>
            <a href="/Staff/Pets" class="btn btn-outline-secondary">Xoá lọc</a>
        </div>
    </form>
</div>

@{
    string PetEmoji(string cat) => cat switch {
        "Dog" => "🐕",
        "Cat" => "🐈",
        "Bird" => "🐦",
        "Fish" => "🐟",
        _ => "🐾"
    };
}

<div class="row row-cols-1 row-cols-md-3 g-3 mb-4">
@foreach (var pet in Model.Pets)
{
    var statusBadge = pet.Status switch {
        "Available" => "bg-success-subtle text-success",
        "Reserved"  => "bg-warning-subtle text-warning-emphasis",
        "Sold"      => "bg-secondary-subtle text-secondary",
        _ => "bg-light text-dark"
    };
    var statusLabel = pet.Status switch {
        "Available" => "Sẵn sàng đón",
        "Reserved"  => "Đã đặt cọc",
        "Sold"      => "Đã bán",
        _ => pet.Status
    };

    <div class="col">
        <div class="card h-100 ps-management-card">
            @if (!string.IsNullOrEmpty(pet.ImageUrl))
            {
                <div class="ps-management-card__thumb">
                    <img src="@pet.ImageUrl" alt="@pet.Name" onerror="this.onerror=null;this.parentElement.innerHTML='<div class=\'ps-management-card__thumb-fallback fs-1\'>@PetEmoji(pet.Category)</div>'"/>
                </div>
            }
            else
            {
                <div class="ps-management-card__thumb">
                    <div class="ps-management-card__thumb-fallback fs-1">
                        @PetEmoji(pet.Category)
                    </div>
                </div>
            }
            <div class="card-body p-3 d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                    <span class="badge bg-light text-muted border" style="font-size:0.75rem">#@pet.Id</span>
                    <span class="badge @statusBadge fw-semibold">@statusLabel</span>
                </div>
                <h6 class="card-title fw-bold text-dark mb-1 fs-6">@pet.Name</h6>
                <div class="small text-muted mb-2"><i class="bi bi-tag me-1"></i>@pet.Breed · @pet.AgeMonths tháng tuổi</div>
                <p class="small text-muted text-truncate mb-3">@pet.Description</p>
                <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-primary fs-6">@pet.Price.ToString("N0")đ</span>
                    <span class="badge bg-light text-muted border">@pet.Category</span>
                </div>
            </div>
            <div class="card-footer bg-light border-top p-2.5 d-flex gap-2">
                <a href="/Staff/Pets/Edit/@pet.Id" class="btn btn-sm btn-outline-primary flex-fill">
                    <i class="bi bi-pencil-square me-1"></i>Sửa
                </a>
                <form method="post" asp-page-handler="Delete" class="flex-fill"
                      onsubmit="return confirm('Xoá bé @pet.Name khỏi danh sách?')">
                    <input type="hidden" name="id" value="@pet.Id"/>
                    <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                        <i class="bi bi-trash me-1"></i>Xoá
                    </button>
                </form>
            </div>
        </div>
    </div>
}
@if (!Model.Pets.Any())
{
    <div class="col-12">
        <div class="ps-empty card">
            <div class="ps-empty__icon"><i class="bi bi-heart-pulse"></i></div>
            <h5 class="fw-bold mb-1">Không tìm thấy thú cưng nào</h5>
            <p class="text-muted small mb-3">Hiện tại chưa có thú cưng nào phù hợp với bộ lọc tìm kiếm.</p>
            <a href="/Staff/Pets/Edit" class="btn btn-primary btn-sm px-4">Thêm thú cưng</a>
        </div>
    </div>
}
</div>

@if (Model.TotalPages > 1)
{
    <nav class="d-flex justify-content-center mt-4" aria-label="Phân trang thú cưng">
        <ul class="pagination pagination-sm shadow-sm">
            <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                <a class="page-link" href="?search=@Model.Search&category=@Model.Category&status=@Model.Status&pageNumber=@(Model.PageNumber - 1)&pageSize=@Model.PageSize">‹</a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" href="?search=@Model.Search&category=@Model.Category&status=@Model.Status&pageNumber=@i&pageSize=@Model.PageSize">@i</a>
                </li>
            }
            <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="?search=@Model.Search&category=@Model.Category&status=@Model.Status&pageNumber=@(Model.PageNumber + 1)&pageSize=@Model.PageSize">›</a>
            </li>
        </ul>
    </nav>
}
