@page "{id:int?}"
@model PetShop.Client.Pages.Staff.Pets.EditModel
@{ ViewData["Title"] = Model.IsEdit ? "Sửa thú cưng" : "Thêm thú cưng"; }

<div class="d-flex align-items-center mb-4 gap-3">
    <a href="/Staff/Pets" class="btn btn-outline-secondary btn-sm">← Quay lại</a>
    <h5 class="mb-0 fw-semibold">@(Model.IsEdit ? "✏️ Sửa thú cưng" : "➕ Thêm thú cưng mới")</h5>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Input.Id"/>
    <input type="hidden" asp-for="Input.ImageUrl" id="hiddenImageUrl"/>

    <div class="row g-4">
        @* Cột trái: thông tin thú cưng *@
        <div class="col-lg-7">
            <div class="card h-100">
                <div class="card-body p-4">
                    <h6 class="fw-semibold mb-3 text-muted small text-uppercase">Thông tin thú cưng</h6>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Tên thú cưng <span class="text-danger">*</span></label>
                            <input asp-for="Input.Name" class="form-control" placeholder="VD: Bông, Mimi..."/>
                            <span asp-validation-for="Input.Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Giống (Breed) <span class="text-danger">*</span></label>
                            <input asp-for="Input.Breed" class="form-control" placeholder="VD: Golden Retriever"/>
                            <span asp-validation-for="Input.Breed" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-4">
                            <label class="form-label fw-medium">Loài <span class="text-danger">*</span></label>
                            <select asp-for="Input.Category" class="form-select">
                                <option value="">-- Chọn loài --</option>
                                <option value="Dog">🐕 Chó</option>
                                <option value="Cat">🐈 Mèo</option>
                                <option value="Bird">🐦 Chim</option>
                                <option value="Fish">🐟 Cá</option>
                                <option value="Rabbit">🐰 Thỏ</option>
                                <option value="Other">🐾 Khác</option>
                            </select>
                            <span asp-validation-for="Input.Category" class="text-danger small"></span>
                        </div>
                        <div class="col-4">
                            <label class="form-label fw-medium">Tuổi (tháng) <span class="text-danger">*</span></label>
                            <input asp-for="Input.AgeMonths" class="form-control" type="number" min="0" placeholder="6"/>
                            <span asp-validation-for="Input.AgeMonths" class="text-danger small"></span>
                        </div>
                        <div class="col-4">
                            <label class="form-label fw-medium">Giá (VNĐ) <span class="text-danger">*</span></label>
                            <input asp-for="Input.Price" class="form-control" type="number" min="0" placeholder="5000000"/>
                            <span asp-validation-for="Input.Price" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium">Mô tả <span class="text-danger">*</span></label>
                        <textarea asp-for="Input.Description" class="form-control" rows="4"
                                  placeholder="Mô tả đặc điểm, tính cách của thú cưng..."></textarea>
                        <span asp-validation-for="Input.Description" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-medium">Trạng thái <span class="text-danger">*</span></label>
                        <select asp-for="Input.Status" class="form-select">
                            <option value="Available">✅ Còn hàng</option>
                            <option value="Reserved">🔒 Đã đặt</option>
                            <option value="Sold">🏷️ Đã bán</option>
                        </select>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            @(Model.IsEdit ? "💾 Lưu thay đổi" : "➕ Thêm thú cưng")
                        </button>
                        <a href="/Staff/Pets" class="btn btn-outline-secondary">Huỷ</a>
                    </div>
                </div>
            </div>
        </div>

        @* Cột phải: upload ảnh *@
        <div class="col-lg-5">
            <div class="card h-100">
                <div class="card-body p-4 d-flex flex-column">
                    <h6 class="fw-semibold mb-3 text-muted small text-uppercase">Ảnh thú cưng</h6>

                    <div id="dropZone"
                         onclick="document.getElementById('fileInput').click()"
                         class="border rounded-3 d-flex flex-column align-items-center justify-content-center text-center p-3 mb-3"
                         style="min-height:280px; border-style:dashed !important; border-color:#dee2e6; background:#f8f9fa; cursor:pointer; transition:all .2s;">

                        @if (!string.IsNullOrEmpty(Model.Input.ImageUrl))
                        {
                            <img id="imgPreview" src="@Model.Input.ImageUrl" alt="preview"
                                 class="rounded-3 mb-2"
                                 style="max-width:100%; max-height:240px; object-fit:contain;"/>
                            <p class="text-muted small mb-0">Nhấn để đổi ảnh</p>
                        }
                        else
                        {
                            <div id="dropPlaceholder">
                                <div style="font-size:3rem;" class="mb-2">🐾</div>
                                <p class="fw-medium mb-1">Kéo thả ảnh vào đây</p>
                                <p class="text-muted small mb-2">hoặc nhấn để chọn file</p>
                                <span class="badge bg-secondary">JPG · PNG · WEBP · GIF</span>
                                <p class="text-muted small mt-2 mb-0">Tối đa 5MB</p>
                            </div>
                            <img id="imgPreview" src="" alt="preview"
                                 class="rounded-3 mb-2 d-none"
                                 style="max-width:100%; max-height:240px; object-fit:contain;"/>
                        }
                    </div>

                    <input asp-for="UploadedImage" id="fileInput" type="file" accept="image/*" class="d-none"/>

                    <label class="form-label small fw-medium text-muted mb-1">Hoặc nhập URL ảnh</label>
                    <input id="urlInput" class="form-control form-control-sm"
                           placeholder="https://example.com/pet.jpg"
                           value="@Model.Input.ImageUrl"
                           oninput="onUrlInput(this.value)"/>

                    <p id="fileName" class="text-success small mt-2 mb-0"></p>
                </div>
            </div>
        </div>
    </div>
</form>

<style>
    #dropZone:hover   { border-color:#0d6efd !important; background:#eef3ff !important; }
    #dropZone.drag-over { border-color:#0d6efd !important; background:#ddeaff !important; transform:scale(1.01); }
</style>

<script>
    const dropZone    = document.getElementById('dropZone');
    const fileInput   = document.getElementById('fileInput');
    const imgPrev     = document.getElementById('imgPreview');
    const fileLabel   = document.getElementById('fileName');
    const hiddenUrl   = document.getElementById('hiddenImageUrl');
    const urlInput    = document.getElementById('urlInput');
    const placeholder = document.getElementById('dropPlaceholder');

    fileInput.addEventListener('change', () => {
        if (fileInput.files[0]) showFilePreview(fileInput.files[0]);
    });

    dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('drag-over'); });
    dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drag-over'));
    dropZone.addEventListener('drop', e => {
        e.preventDefault();
        dropZone.classList.remove('drag-over');
        const file = e.dataTransfer.files[0];
        if (file && file.type.startsWith('image/')) {
            const dt = new DataTransfer();
            dt.items.add(file);
            fileInput.files = dt.files;
            showFilePreview(file);
        }
    });

    function showFilePreview(file) {
        const reader = new FileReader();
        reader.onload = e => {
            imgPrev.src = e.target.result;
            imgPrev.classList.remove('d-none');
            if (placeholder) placeholder.classList.add('d-none');
            fileLabel.textContent = `✅ ${file.name} (${(file.size/1024/1024).toFixed(2)} MB)`;
            hiddenUrl.value = '';
            urlInput.value  = '';
        };
        reader.readAsDataURL(file);
    }

    function onUrlInput(url) {
        hiddenUrl.value = url;
        if (url) {
            imgPrev.src = url;
            imgPrev.classList.remove('d-none');
            if (placeholder) placeholder.classList.add('d-none');
            fileLabel.textContent = '';
        }
    }
</script>
