### ============================================================
### 🐾 CATALOG SERVICE — Test Products & Pets
### URL: http://localhost:5002
### ============================================================
### ⚠️ Thay TOKEN bằng access token từ auth-service.http
### ============================================================

@catalogUrl  = http://localhost:5002
@adminToken  = PASTE_ADMIN_TOKEN_HERE
@staffToken  = PASTE_STAFF_TOKEN_HERE

# ═══════════════════════════════════════════════════════════════
#  PRODUCTS
# ═══════════════════════════════════════════════════════════════

# ── GET: Xem tất cả sản phẩm (không cần đăng nhập) ───────────
GET {{catalogUrl}}/api/products
Accept: application/json

###

# ── GET: Xem sản phẩm theo ID ─────────────────────────────────
GET {{catalogUrl}}/api/products/1
Accept: application/json

###

# ── GET: ID không tồn tại (kiểm tra lỗi 404) ─────────────────
GET {{catalogUrl}}/api/products/9999
Accept: application/json

###

# ── POST: Tạo sản phẩm mới (cần Admin/Staff) ──────────────────
POST {{catalogUrl}}/api/products
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Balo vận chuyển thú cưng",
  "description": "Balo đựng thú cưng tiện lợi, thoáng khí, dung tích 20L",
  "price": 450000,
  "stock": 30,
  "category": "Accessory",
  "imageUrl": "https://example.com/images/balo.jpg"
}

###

# ── POST: Tạo sản phẩm — không có token (kiểm tra 401) ────────
POST {{catalogUrl}}/api/products
Content-Type: application/json

{
  "name": "Sản phẩm không có quyền",
  "description": "Test",
  "price": 100,
  "stock": 1,
  "category": "Food",
  "imageUrl": null
}

###

# ── PUT: Cập nhật sản phẩm (cần Admin/Staff) ──────────────────
PUT {{catalogUrl}}/api/products/1
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Thức ăn Royal Canin cho chó (Cập nhật)",
  "description": "Thức ăn hạt cao cấp cho chó trưởng thành — Phiên bản mới",
  "price": 380000,
  "stock": 120,
  "category": "Food",
  "imageUrl": null
}

###

# ── DELETE: Xóa sản phẩm — chỉ Admin ─────────────────────────
DELETE {{catalogUrl}}/api/products/5
Authorization: Bearer {{adminToken}}

###

# ── DELETE: Staff cố xóa — kiểm tra 403 Forbidden ────────────
DELETE {{catalogUrl}}/api/products/4
Authorization: Bearer {{staffToken}}

###

# ═══════════════════════════════════════════════════════════════
#  PETS
# ═══════════════════════════════════════════════════════════════

# ── GET: Xem tất cả thú cưng ──────────────────────────────────
GET {{catalogUrl}}/api/pets
Accept: application/json

###

# ── GET: Xem thú cưng theo ID ─────────────────────────────────
GET {{catalogUrl}}/api/pets/1
Accept: application/json

###

# ── POST: Thêm thú cưng mới ───────────────────────────────────
POST {{catalogUrl}}/api/pets
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Luna",
  "breed": "Poodle Toy",
  "category": "Dog",
  "ageMonths": 2,
  "price": 6500000,
  "description": "Poodle Toy xinh xắn, thông minh, tiêm phòng đầy đủ",
  "imageUrl": null,
  "status": "Available"
}

###

# ── PUT: Cập nhật trạng thái thú cưng ────────────────────────
PUT {{catalogUrl}}/api/pets/1
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Buddy",
  "breed": "Golden Retriever",
  "category": "Dog",
  "ageMonths": 4,
  "price": 9000000,
  "description": "Đã lớn thêm, khỏe mạnh hơn",
  "imageUrl": null,
  "status": "Reserved"
}

###

# ── DELETE: Xóa thú cưng ─────────────────────────────────────
DELETE {{catalogUrl}}/api/pets/4
Authorization: Bearer {{adminToken}}

###
