### ============================================================
### 🔐 AUTH SERVICE — Test tất cả chức năng xác thực
### URL: http://localhost:5001
### ============================================================
### Cách dùng: Cài extension "REST Client" trên VS Code
### Rồi click "Send Request" ở mỗi block
### ============================================================

@authUrl = http://localhost:5001

# ── BƯỚC 1: ĐĂNG KÝ TÀI KHOẢN MỚI ──────────────────────────
# Tạo tài khoản Customer mới
POST {{authUrl}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Nguyễn Văn Test",
  "email": "test@petshop.com",
  "password": "Test@123",
  "phone": "0912345678",
  "address": "123 Đường Lê Lợi, Q1, TP.HCM"
}

###

# ── BƯỚC 2: ĐĂNG NHẬP ADMIN ──────────────────────────────────
# Lưu token vào biến @adminToken bên dưới
POST {{authUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@petshop.com",
  "password": "Admin@123"
}

###

# ── BƯỚC 3: ĐĂNG NHẬP STAFF ──────────────────────────────────
POST {{authUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "staff@petshop.com",
  "password": "Staff@123"
}

###

# ── BƯỚC 4: ĐĂNG NHẬP CUSTOMER ───────────────────────────────
POST {{authUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "customer@petshop.com",
  "password": "Customer@123"
}

###

# ── BƯỚC 5: ĐĂNG NHẬP SAI MẬT KHẨU (kiểm tra lỗi) ──────────
POST {{authUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@petshop.com",
  "password": "SaiMatKhau123"
}

###

# ── BƯỚC 6: REFRESH TOKEN ─────────────────────────────────────
# Thay @accessToken và @refreshToken bằng giá trị từ BƯỚC 4
@accessToken  = PASTE_ACCESS_TOKEN_HERE
@refreshToken = PASTE_REFRESH_TOKEN_HERE

POST {{authUrl}}/api/auth/refresh
Content-Type: application/json

{
  "accessToken": "{{accessToken}}",
  "refreshToken": "{{refreshToken}}"
}

###
