### ============================================================
### 👤 USER SERVICE — Test quản lý hồ sơ người dùng
### URL: http://localhost:5004
### ============================================================

@userUrl      = http://localhost:5004
@adminToken   = PASTE_ADMIN_TOKEN_HERE
@customerToken = PASTE_CUSTOMER_TOKEN_HERE

# ── GET: Admin xem tất cả users ───────────────────────────────
GET {{userUrl}}/api/users
Authorization: Bearer {{adminToken}}

###

# ── GET: Admin xem user theo ID ───────────────────────────────
GET {{userUrl}}/api/users/3
Authorization: Bearer {{adminToken}}

###

# ── GET: Xem hồ sơ bản thân (bất kỳ role) ────────────────────
GET {{userUrl}}/api/users/me
Authorization: Bearer {{customerToken}}

###

# ── PUT: User cập nhật hồ sơ của chính mình ──────────────────
PUT {{userUrl}}/api/users/3
Content-Type: application/json
Authorization: Bearer {{customerToken}}

{
  "fullName": "Nguyễn Văn A (Đã cập nhật)",
  "phone": "0909999888",
  "address": "88 Lý Tự Trọng, Q1, TP.HCM"
}

###

# ── PUT: Customer cố cập nhật user khác → 403 Forbidden ───────
PUT {{userUrl}}/api/users/1
Content-Type: application/json
Authorization: Bearer {{customerToken}}

{
  "fullName": "Không được sửa Admin",
  "phone": "0000000000",
  "address": null
}

###

# ── PUT: Admin cập nhật bất kỳ user ──────────────────────────
PUT {{userUrl}}/api/users/3
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "fullName": "Nguyễn Văn A (Admin sửa)",
  "phone": "0901234569",
  "address": "Địa chỉ mới do Admin cập nhật"
}

###

# ── DELETE: Admin vô hiệu hoá tài khoản ──────────────────────
DELETE {{userUrl}}/api/users/3
Authorization: Bearer {{adminToken}}

###

# ── GET: Customer cố xem tất cả → 403 ────────────────────────
GET {{userUrl}}/api/users
Authorization: Bearer {{customerToken}}

###
